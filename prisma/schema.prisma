// Flowtora — multi-tenant SaaS for sign/print shops.
// Tenancy model: shared Postgres, every tenant-scoped row carries `tenantId`.
// Tenant access is enforced in app code via getTenantContext() + RBAC checks.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────
// Tenants & billing
// ────────────────────────────────────────────────────────────

model Tenant {
  id                   String       @id @default(cuid())
  slug                 String       @unique
  name                 String
  status               TenantStatus @default(TRIAL)
  plan                 Plan         @default(STARTER)
  // M1 — nullable pointer to the new PricingPlan table. Today the
  // `plan` enum above is still the source of truth for entitlements;
  // this FK is populated by the M1 seed so admin UIs + marketing
  // pages can read from the table. A later slice dual-writes, and
  // M6 drops the enum.
  pricingPlanId        String?
  trialEndsAt          DateTime?
  stripeCustomerId     String?      @unique
  stripeSubscriptionId String?      @unique

  // Page 15 (Subscriptions) — the rest of the subscription state we
  // need to render the admin subscription list + detail. We don't
  // model subscriptions as a separate table because the per-tenant
  // 1:1 cardinality + lack of multi-sub support means a flat shape on
  // Tenant keeps the joins cheap. If we ever support stacking subs
  // per workspace, we'll move these onto a Subscription model.
  /** "MONTHLY" / "ANNUAL". Drives the MRR ÷ ARR rollups. */
  billingCycle         BillingCycle @default(MONTHLY)
  /** Current billing period — reset on each renewal. */
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  /** When true, the next renewal will cancel instead of charging. */
  cancelAtPeriodEnd    Boolean      @default(false)
  /** Optional explicit cancellation date (for "cancel on Jun 30"
   *  flows that aren't tied to the current period). */
  cancelScheduledFor   DateTime?
  /** Optional paused-until date. While set, billing pauses + access
   *  stays read-only. */
  pausedUntil          DateTime?
  /** Stamped on cancel — separate from `archiveReason` so a tenant
   *  that cancels but stays around in TRIAL doesn't lose context. */
  cancelReason         String?

  // Profile / settings
  logoUrl      String?
  timezone     String  @default("UTC")
  currency     String  @default("USD")
  taxId        String?
  phone        String?
  website      String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  country      String?

  // Phase 21 Slice A — email sender customization. Customer-facing emails
  // use the tenant's display name and route replies to their inbox, but
  // the actual envelope sender stays on Flowtora's verified Resend domain
  // (otherwise DKIM / SPF fails and deliverability tanks). Shape:
  //   From: "{emailFromName} <noreply@flowtora.app>"
  //   Reply-To: {emailReplyTo}
  emailFromName String?
  emailReplyTo  String?

  // Phase 21 Slice B — document output customization. Rendered at the
  // bottom of customer-facing quote/invoice emails and on the portal's
  // invoice/quote detail pages. Plain text (no HTML passthrough) so shops
  // can't accidentally break portal layout or email rendering.
  quoteFooterText     String?
  invoiceFooterText   String?
  paymentInstructions String?

  // Phase 21 Slice C — tenant-wide notification defaults. Shape matches
  // Membership.notifPrefs so admins can set a house default that new
  // members inherit on invite-accept. Existing members keep their
  // personal overrides; if a key is missing from a member's prefs the
  // resolver falls back through tenant defaults, then the built-in
  // { inApp: true, email: false }.
  defaultNotifPrefs Json?

  // Phase 21 Slice D — locale / formatting preferences. Controls how
  // dates render on customer-facing surfaces (portal, emails). Internal
  // staff screens keep ISO (YYYY-MM-DD) because it's unambiguous for
  // operators working across tenants. weekStartsOn picks which column
  // the calendar-like views lead with.
  //   "ISO"  → 2026-04-18
  //   "US"   → 04/18/2026
  //   "EU"   → 18/04/2026
  dateFormat   String @default("US")
  weekStartsOn Int    @default(0) // 0=Sun, 1=Mon, 6=Sat

  // Onboarding
  onboardingCompletedAt DateTime?
  businessType          BusinessType?
  services              String[]      @default([])
  leadSources           String[]      @default([])

  // ── Phase 4 (Onboarding & Activation) ──
  // When the tenant loads the sample data set from the onboarding flow.
  // We keep the timestamp (not just a boolean) because support needs to
  // know WHEN the sample data landed — sometimes shops call us after
  // they've mixed real customers into the sample set and want it gone.
  sampleDataLoadedAt    DateTime?
  sampleDataClearedAt   DateTime?
  // Owners can dismiss the persistent "finish setup" nudge. The banner
  // rearms itself after 7 days so a genuinely stuck workspace still gets
  // the prompt — but day-one users aren't hounded on every page load.
  activationDismissedAt DateTime?

  // Quote / order / invoice numbering — prefix + last issued number.
  quoteNumberPrefix      String @default("Q-")
  quoteLastNumber        Int    @default(1000)
  orderNumberPrefix      String @default("O-")
  orderLastNumber        Int    @default(1000)
  invoiceNumberPrefix    String @default("INV-")
  invoiceLastNumber      Int    @default(1000)
  // Phase 14 — credit memos reuse the same prefix-and-counter pattern
  // as invoices. Default prefix "CM-"; counter starts at 1000 to match
  // the shape tenants are already used to.
  creditMemoNumberPrefix String @default("CM-")
  creditMemoLastNumber   Int    @default(1000)

  // Financial defaults
  defaultTaxRate        Decimal      @default(0) @db.Decimal(6, 4) // e.g. 0.0875
  defaultDepositPercent Int          @default(50)
  defaultPaymentTerms   PaymentTerms @default(NET_30)
  proofRequiresApproval Boolean      @default(true)

  // ── Phase 13: workflow / approval rules ──
  // A quote whose discount % exceeds this threshold needs a manager/owner to
  // "approve for sending". 0 disables the discount gate entirely.
  approvalDiscountThresholdPct   Int     @default(0)
  // A quote whose total exceeds this amount needs approval before sending.
  // 0 disables the large-job gate.
  approvalLargeJobThreshold      Decimal @default(0) @db.Decimal(12, 2)
  // Orders can't advance to IN_PRODUCTION unless they have an APPROVED proof.
  requireProofBeforeProduction   Boolean @default(false)
  // Phase A Slice 1 — orders can't advance to IN_PRODUCTION until the deposit
  // % has been paid. Parallel to requireDepositBeforeInstall, but earlier in
  // the funnel — stops shop work from starting on unfunded jobs.
  requireDepositBeforeProduction Boolean @default(false)
  // Installs can't be scheduled until the order has collected its deposit %.
  requireDepositBeforeInstall    Boolean @default(false)

  // ── Phase 22 Slice C: auto-assignment defaults ──
  // When a new quote is created without an explicit sales rep, we fall back
  // to this user. Same idea for orders and their production manager. Null =
  // no default (creator must pick, or the field stays null).
  defaultSalesRepId          String?
  defaultProductionManagerId String?

  // ── Phase 22 Slice D: auto-apply default checklist templates ──
  // Seeded onto new orders / install events the moment they're created, so
  // production staff don't have to remember to "Apply template". Null = no
  // auto-apply (existing manual apply flow still works).
  defaultOrderChecklistTemplateId   String?
  defaultInstallChecklistTemplateId String?

  // ── Phase 13: smart pricing ──
  // Default rush markup (percent of subtotal) applied when a user clicks
  // "Apply rush fee" on a quote. Shows up as its own line so the customer
  // sees it called out. 0 = no rush workflow.
  rushFeePercent Int @default(0)

  // ── Phase 15 Slice D: franchise / multi-tenant grouping ──
  // A tenant can be a "group root" (the franchisor / parent company) that
  // owns shared templates other tenants in its group inherit. Children point
  // at their parent via `parentTenantId`. Inheritance is one level deep —
  // we don't recursively walk up the chain, which keeps queries flat and
  // avoids accidental visibility through transitive grouping.
  parentTenantId    String?
  parent            Tenant?  @relation("TenantHierarchy", fields: [parentTenantId], references: [id], onDelete: SetNull)
  children          Tenant[] @relation("TenantHierarchy")
  isGroupRoot       Boolean  @default(false)
  // Brand kit fields a child tenant may fall back to when its own value is null.
  // Today only used as a comparison hint; future slice will wire actual UI fallback.
  brandPrimaryColor String?

  // ── Phase 17 Slice A: platform-staff visibility & support fields ──
  // Free-form notes only platform staff (super admin / site mgr / support) can
  // see — never exposed to the tenant. Use for "spoke with owner re: integration
  // troubles", "abusive billing dispute pending", etc.
  notes            String?
  // Denormalized "any audit log written for this tenant" timestamp. Bumped by
  // logAudit() best-effort so the platform tenants list can show health-at-a-
  // glance ("dead 47 days") without per-row aggregate queries.
  lastActivityAt   DateTime?
  // When status flips to SUSPENDED we capture *why* — surfaced on the
  // /account-suspended landing page so the tenant owner has a path to resolve.
  suspensionReason String?

  // Storage-quota warning email — bumped to "now" the first time a
  // post-upload check finds the tenant past 85% of their quota, and
  // cleared back to null when usage drops below the 75% reset
  // threshold. The hysteresis stops a tenant who's hovering around
  // 85% from getting a flood of warnings as files get added/removed.
  storageWarningEmailSentAt DateTime?

  // ── Phase 1 (Core SaaS Foundation): environment + lifecycle fields ──
  // `environment` separates real paying customers from test/demo tenants
  // used for sales demos, QA, and internal playground accounts. The
  // workspace shell shows a persistent ribbon when env != LIVE so nobody
  // confuses a sandbox for production data. Platform dashboards can filter
  // to LIVE only to get accurate health metrics.
  environment         TenantEnvironment @default(LIVE)
  // Phase 19 — release cohort. Segments tenants into rollout waves so
  // platform staff can flip a beta feature for "all ALPHA tenants" without
  // touching every record individually. NONE = general availability.
  betaCohort          BetaCohort        @default(NONE)
  // Archive is a soft-delete with a grace period. Setting `archivedAt`
  // flips the tenant to ARCHIVED status and records who/when; tenant
  // members can no longer sign in but the data stays intact so platform
  // staff can restore within the grace window. `scheduledDeletionAt`
  // marks the point after which the archive becomes permanent (a cron
  // job can later hard-delete). Restore clears all three fields.
  archivedAt          DateTime?
  archivedBy          String?
  archiveReason       String?
  // Categorized cancellation reason — populated alongside archiveReason
  // when an admin archives the tenant. Drives the "why are tenants
  // leaving?" analytics on /platform/tenants.
  archiveReasonCode   ArchiveReasonCode?
  // Page 7 — when archiveReasonCode = SWITCHED_TO_COMPETITOR, captures
  // which competitor the tenant moved to. Plain text — drives the
  // "Switched to" tooltip in the Churned tab.
  archiveCompetitorName String?
  scheduledDeletionAt DateTime?

  // Page 7 (Churned & At-Risk) — at-risk alerts can be muted for a
  // bounded window via "Suppress alert". The tenant stays out of the
  // at-risk list until this date passes, then re-enters automatically.
  atRiskSuppressedUntil DateTime?
  // Stamped when a previously CANCELED tenant comes back (status
  // moves out of CANCELED). Drives the "% won back" KPI without
  // walking the full SubscriptionEvent log.
  wonBackAt DateTime?

  // Platform-side tags for organizing tenants — internal only; tenants
  // never see these. Free-form lowercase strings, e.g. "vip", "beta",
  // "at-risk", "enterprise-pilot".
  adminTags String[] @default([])

  // ── Page 4 (Tenants list) — surfaced fields ─────────────────────
  // Account manager / CSM. Nullable so we can leave new tenants
  // unassigned in the triage queue. SetNull on cascade so removing a
  // staff member doesn't orphan tenant rows.
  accountManagerId String?
  accountManager   User?    @relation("TenantAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  // Optional custom-domain (e.g. quotes.acme-signs.com). Drives the
  // "Has custom domain" filter chip + an optional list-view column.
  customDomain     String?
  // SSO configuration. ssoEnabled toggles enforcement; ssoProvider is
  // a free-form label (saml-okta / oidc-azure / google-workspace).
  ssoEnabled       Boolean  @default(false)
  ssoProvider      String?
  // MFA enforcement: if true, every member must complete the 2FA
  // setup flow before regaining access. Drives an at-a-glance pill
  // on the list page + the "MFA enforced" filter.
  mfaEnforced      Boolean  @default(false)
  // Signup attribution. Captured at create time from referral codes,
  // utm_source, or set manually by platform staff after a sales call.
  signupSource     TenantSource @default(ORGANIC)

  // ── Page 5 (Onboarding Pipeline) ──────────────────────────────
  // Manual stage override — when set, takes precedence over the
  // computed stage in /platform/tenants/onboarding. Cleared by
  // setting back to null.
  onboardingStageOverride String?
  // Stamped when an admin clicks "Mark stuck" on the kanban card
  // or list row. The stage classifier uses it as a signal for the
  // "stuck tenant" filter independent of the days-in-stage rule.
  onboardingMarkedStuckAt DateTime?
  // Stamped when an admin / cron enrolls the tenant in the
  // onboarding-nudge drip. The cron walks rows where this is set
  // and `lastOnboardingNudgeAt` is more than the cadence apart.
  onboardingNudgeEnrolledAt DateTime?
  lastOnboardingNudgeAt     DateTime?

  // Trial nudge tracking — stamped when the "ends in Xd" banner is first
  // acknowledged or dismissed so we don't hammer owners with the same
  // warning. Billing alert tracking does the same for PAST_DUE.
  trialEndingNoticeAt DateTime?
  pastDueNoticeAt     DateTime?

  // ── Phase 3 (Billing) — dunning state machine ──
  // Stage in the recover-payment funnel. NONE for happy customers; the
  // pipeline runs PAYMENT_FAILED → REMINDER_1 → REMINDER_2 → FINAL_NOTICE
  // → SUSPEND, advanced manually today (cron is a follow-up). Pausing
  // sets `dunningPausedAt`; resolving wipes everything back to NONE and
  // stamps `dunningLastEventAt` for the audit trail.
  dunningStage        DunningStage @default(NONE)
  dunningStartedAt    DateTime?
  dunningPausedAt     DateTime?
  dunningLastEventAt  DateTime?
  // Active coupon applied to this tenant — discounts the next invoice.
  // Single-coupon model (no stacking) keeps the math obvious; if we
  // ever need stacking, switch to a join through CouponRedemption with
  // an "active" filter.
  activeCouponId      String?
  activeCoupon        Coupon? @relation("TenantActiveCoupon", fields: [activeCouponId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  invites            Invite[]
  auditLogs          AuditLog[]
  subscriptionEvents SubscriptionEvent[]
  // Page 3 follow-up — referral attribution captured at signup time
  // when the user lands via ?ref=<code>. One-to-one with the tenant.
  referral           Referral?
  // Page 4a — platform-side CRM notes, viewer log, integrations,
  // IP allowlist/blocklist, and health-score history.
  platformNotes      TenantNote[]
  platformViewedBy   TenantViewedBy[]
  integrations       TenantIntegration[]
  ipRules            TenantIpRule[]
  healthSnapshots    TenantHealthSnapshot[]
  healthAdjustments  TenantHealthAdjustment[]
  retentionAttempts  RetentionAttempt[]
  winbackEnrollments WinbackEnrollment[]
  customers          Customer[]
  contacts           Contact[]
  interactions       Interaction[]
  tasks              Task[]
  products           Product[]
  productPackages    ProductPackage[]
  quoteTemplates     QuoteTemplate[]
  quotes             Quote[]
  orders             Order[]
  orderBlockers      OrderBlocker[]
  invoices           Invoice[]
  payments           Payment[]
  files              File[]
  proofs             Proof[]
  proofDecisions     ProofDecision[]
  installEvents      InstallEvent[]
  portalTokens       PortalToken[]
  // Phase 15 — unauthenticated public share links (proofs / invoices).
  shareTokens        ShareToken[]
  notifications      Notification[]
  checklistTemplates ChecklistTemplate[]
  checklistItems     ChecklistItem[]
  comments           Comment[]
  emailEvents        EmailEvent[]
  messageTemplates   MessageTemplate[]
  portalMessages     PortalMessage[]
  locations          Location[]
  supportTickets     SupportTicket[]
  dataExportRequests DataExportRequest[]
  deletionRequests   AccountDeletionRequest[]
  feedback           Feedback[]
  palettePins        PalettePin[]
  savedViews         SavedView[]
  // Phase 12 — production management.
  departments        Department[]
  workStations       WorkStation[]
  productionStages   ProductionStage[]
  defectReports      DefectReport[]
  materialUsages     MaterialUsage[]
  // Phase 13 — field execution evidence + site surveys + issue escalation.
  installPhotos      InstallPhoto[]
  installSignatures  InstallSignature[]
  installIssues      InstallIssue[]
  siteSurveys        SiteSurvey[]
  // Phase 14 — financial operations: expenses, vendors, refunds, credits,
  // write-offs. Every new model is tenant-scoped with Cascade delete so a
  // tenant deletion cleans up the entire financial footprint.
  vendors            Vendor[]
  expenses           Expense[]
  refunds            Refund[]
  creditMemos        CreditMemo[]
  creditApplications CreditApplication[]
  writeOffs          WriteOff[]
  // Phase 22 — approval requests generated by workflow rule gates.
  approvalRequests   ApprovalRequest[]
  // M1 — FK back to the admin-editable PricingPlan row this tenant is on.
  // Populated lazily (a tenant on legacy `plan` may have null until the
  // seed/backfill runs). Cascade is deliberately omitted — if a plan is
  // deleted we don't want to orphan-delete tenants.
  pricingPlan        PricingPlan?             @relation(fields: [pricingPlanId], references: [id], onDelete: SetNull)
  // M1 — per-tenant price overrides (grandfathered legacy pricing,
  // custom-negotiated Enterprise deals, etc.).
  planPriceOverrides PlanPriceOverride[]

  // Phase 3 — admin-issued (Flowtora → tenant) invoices and coupon
  // redemptions. Distinct from the tenant-side `invoices` field above
  // (which is the shop → end-customer invoicing surface).
  platformInvoices    PlatformBillingInvoice[]
  couponRedemptions   CouponRedemption[]
  // Page 18 — Refunds & Disputes back-relations.
  platformPaymentRefunds PlatformPaymentRefund[]
  platformDisputes       PlatformDispute[]
  // Page 21 — Tax & Compliance.
  taxExemptions          TaxExemption[]
  // Page 23 — Dunning queue entries for this tenant's failed payments.
  dunningEvents          DunningEvent[]
}

// ────────────────────────────────────────────────────────────
// Phase 15 Slice A — Location (branch) of a tenant.
//
// A tenant can have one or more locations (branches / storefronts).
// Every new tenant gets a default "Main" location so existing single-shop
// flows keep working without asking the user to configure anything. Jobs,
// customers, invoices etc. optionally belong to a location; null = tenant-
// wide / shared resource.
//
// We deliberately scope *staff to location* in Slice B via a
// `Membership.locationIds` array rather than a many-to-many — shops typically
// have <10 locations and each staff member is in 1-2 at most, so an array
// keeps the query model trivial.
// ────────────────────────────────────────────────────────────

model Location {
  id       String @id @default(cuid())
  tenantId String

  name      String // e.g. "Downtown Showroom"
  code      String? // optional short code, e.g. "DTS" — used in numbering prefixes later
  isDefault Boolean @default(false) // the tenant's primary/HQ location

  // Address + contact — mirrors Customer's billing address shape.
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  country      String?
  phone        String?
  email        String?

  // Optional override of tenant business hours / timezone — not enforced yet,
  // but shops with branches in different time zones will need these soon.
  timezone String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers     Customer[]
  quotes        Quote[]
  orders        Order[]
  invoices      Invoice[]
  installEvents InstallEvent[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId, active])
}

enum BusinessType {
  SIGN_SHOP
  PRINT_SHOP
  // Page 4 §Industry vertical filter — extended to match the spec's
  // canonical list. HYBRID is kept as the legacy "multi-discipline"
  // alias; new tenants pick from the more granular options below.
  HYBRID
  APPAREL_SCREEN_PRINT
  EMBROIDERY
  PROMO_PRODUCTS
  TRADE_PRINTER
  WIDE_FORMAT_ONLY
  MULTI_DISCIPLINE
  OTHER
}

// Page 4 — signup attribution. Used by the Tenants list "Source"
// column + filter. ORGANIC = direct, REFERRAL = via Affiliate program,
// PAID = paid acquisition channel, PARTNER = warm intro.
enum TenantSource {
  ORGANIC
  REFERRAL
  PAID
  PARTNER
  OTHER
}

// ────────────────────────────────────────────────────────────
// Page 4a (Tenant Detail) primitives.
//
// TenantNote replaces the legacy free-form `Tenant.notes` string —
// platform-side CRM notes with author attribution, rich-text body,
// pinning, and "private to me" flag.
// TenantViewedBy stamps every page view by platform staff so the
// right-rail "Recently viewed by team" widget can show last 3
// admins.
// TenantIntegration enumerates which third-party integrations a
// tenant has wired up (Stripe / QuickBooks / Slack / etc.) — feeds
// the Integrations tab. The list of supported integrations lives in
// code (src/lib/integrations.ts) but the per-tenant connection rows
// live here.
// TenantIpRule supports the Security tab's allowlist / blocklist.
// TenantHealthSnapshot stores per-day score history so the Health
// Score tab's 12m trend chart has real data instead of a flat line.
// ────────────────────────────────────────────────────────────

model TenantNote {
  id       String @id @default(cuid())
  tenantId String
  authorId String
  /** Rich-text body — HTML, sanitised at write time. */
  body     String
  /** Pinned notes appear at the top of the Notes tab. */
  pinned   Boolean @default(false)
  /** Private notes are visible only to the author. */
  isPrivate Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User   @relation("TenantNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([tenantId, pinned, createdAt])
  @@index([authorId])
}

// ────────────────────────────────────────────────────────────
// Page 11 — Platform Teams.
//
// Internal admin teams (Engineering, Support, Sales, Finance, CSM)
// with on-call rotations and team-level role inheritance. A team
// can carry multiple CustomPlatformRole assignments — every member
// of the team picks up the union of those role permission lists in
// addition to whatever their direct role grants.
// ────────────────────────────────────────────────────────────

model PlatformTeam {
  id           String  @id @default(cuid())
  name         String  @unique
  /** Slug-style key. Used for @-mentions + URL params. */
  key          String  @unique
  description  String?
  /** Hex (no #) — drives the colour chip + on-call calendar tint. */
  color        String?
  /** External integration handles. */
  slackChannel String?
  emailDistro  String?

  /** Notify-channel toggles for the on-call escalation policy. */
  notifySlack      Boolean @default(true)
  notifyPagerDuty  Boolean @default(false)
  notifySms        Boolean @default(false)

  /** Custom platform-role keys applied to every member. Stored as
   *  string[] (not a relation) so dropping a role doesn't fail the
   *  cascade — we filter unknown keys at read time. */
  inheritedRoleKeys String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?

  members PlatformTeamMember[]
  shifts  OnCallShift[]

  @@index([archivedAt])
}

model PlatformTeamMember {
  id       String              @id @default(cuid())
  teamId   String
  userId   String
  role     PlatformTeamMemberRole @default(MEMBER)
  joinedAt DateTime            @default(now())

  team PlatformTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

enum PlatformTeamMemberRole {
  LEAD
  MEMBER
}

/** A single block in an on-call rotation. Levels stack — when paging
 *  for an incident, the bot escalates Primary → Secondary → Tertiary
 *  in sequence with each step's wait window. Override blocks (a swap
 *  for a one-off vacation cover) carry isOverride=true so the calendar
 *  view can render them in a different shade. */
model OnCallShift {
  id        String          @id @default(cuid())
  teamId    String
  userId    String
  level     OnCallLevel     @default(PRIMARY)
  startsAt  DateTime
  endsAt    DateTime
  isOverride Boolean        @default(false)
  notes     String?

  createdAt DateTime @default(now())
  createdBy String?

  team PlatformTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId, startsAt])
  @@index([userId, startsAt])
}

enum OnCallLevel {
  PRIMARY
  SECONDARY
  TERTIARY
}

// ────────────────────────────────────────────────────────────
// Page 12 — Platform-admin invitations.
//
// Distinct from `Invite` (tenant-side workspace invitations). This
// flow mints an invite token + sends an email with the accept link;
// the recipient's User row is created on accept, picking up the
// chosen built-in role + optional custom role + team memberships.
//
// Status flow:
//   SENT  → OPENED  → ACCEPTED
//   SENT  → EXPIRED  (cron auto-flip when expiresAt < now)
//   SENT  → REVOKED  (admin clicked Revoke)
//
// Per-row trail: openedAt + acceptedAt + acceptedById + revokedAt +
// revokedById + lastResentAt + resendCount.
// ────────────────────────────────────────────────────────────

model PlatformInvite {
  id    String @id @default(cuid())
  email String

  /** Built-in baseline role to grant on accept. */
  platformRole PlatformRole
  /** Optional custom platform role to layer on top. */
  customRoleId String?
  customRole   CustomPlatformRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  /** Optional teams to add the new admin to on accept. PlatformTeam
   *  ids — validated at accept time and silently dropped if archived. */
  teamIds      String[] @default([])

  customMessage String?
  mfaRequired   Boolean @default(true)

  /** URL-safe token. Treated as a secret; never logged. */
  token         String   @unique
  expiresAt     DateTime

  status        PlatformInviteStatus @default(SENT)
  openedAt      DateTime?
  acceptedAt    DateTime?
  /** User.id of the new admin once they accepted. */
  acceptedById  String?
  revokedAt     DateTime?
  /** User.id of the admin who revoked. */
  revokedById   String?
  lastResentAt  DateTime?
  resendCount   Int       @default(0)

  invitedById String
  invitedBy   User     @relation("PlatformInviteAuthor", fields: [invitedById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

enum PlatformInviteStatus {
  SENT
  OPENED
  ACCEPTED
  EXPIRED
  REVOKED
}

// Page 9 — platform-side notes about an end-user. Same shape as
// TenantNote but the subject is a User (the person an admin is
// investigating) rather than a Tenant. Visible to all platform staff
// unless `isPrivate` is true; pinned notes float to the top.
model PlatformUserNote {
  id        String @id @default(cuid())
  /** Subject of the note — the user being noted-on. */
  userId    String
  /** Author — the platform admin writing the note. */
  authorId  String

  body      String
  pinned    Boolean @default(false)
  isPrivate Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User @relation("UserNoteSubject", fields: [userId],   references: [id], onDelete: Cascade)
  author User @relation("UserNoteAuthor",  fields: [authorId], references: [id], onDelete: Cascade)

  @@index([userId, pinned, createdAt])
  @@index([authorId])
}

model TenantViewedBy {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  // Most-recent timestamp wins; we upsert on (tenantId, userId).
  viewedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("TenantViewer", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, viewedAt])
}

model TenantIntegration {
  id       String @id @default(cuid())
  tenantId String
  /** Stable provider key — "stripe" / "quickbooks" / "shopify" /
   *  "slack" / etc. Mapping to display name + logo lives in code. */
  provider String

  status        TenantIntegrationStatus @default(CONNECTED)
  /** Free-form sub-feature scope, e.g. "invoicing" + "payments" for
   *  Stripe. Helps the Integrations tab show what's wired without
   *  per-provider branching in the UI. */
  scope         String?
  /** Last successful sync timestamp — drives the "Last sync 12m ago"
   *  chip on the Integrations tab. */
  lastSyncAt    DateTime?
  /** Counters for the sync stats display. */
  recordsSynced Int      @default(0)
  errorCount    Int      @default(0)
  lastErrorAt   DateTime?
  lastError     String?

  /** Provider-specific config blob (account ids, scopes, etc.). */
  config        Json?

  connectedById String?
  connectedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([provider, status])
}

enum TenantIntegrationStatus {
  CONNECTED
  ERRORED
  PAUSED
  DISCONNECTED
}

model TenantIpRule {
  id       String @id @default(cuid())
  tenantId String
  /** ALLOW or BLOCK — the only two semantics. */
  kind     TenantIpRuleKind
  /** Single IP or CIDR range — e.g. "192.0.2.0/24" or "192.0.2.7". */
  cidr     String
  /** Free-form note shown alongside the rule. */
  note     String?
  /** Updated on each rate-limit / firewall hit so the Security tab
   *  can show "last triggered 3h ago". */
  lastTriggeredAt DateTime?
  triggeredCount  Int       @default(0)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind])
}

enum TenantIpRuleKind {
  ALLOW
  BLOCK
}

// ────────────────────────────────────────────────────────────
// Page 5 (Onboarding Pipeline) — funnel configuration singleton.
//
// Single-row table, identified by the literal "default" id. Stores
// the WIP limit per stage + the stuck-threshold-days knob from the
// "Edit funnel definition" modal. The 10 stages themselves stay in
// code (src/server/platform/onboarding-pipeline.ts) — making them
// fully user-defined would mean a stage-predicate engine, which is
// reserved for a future slice. The WIP / stuck knobs are a useful
// 80/20 today.
// ────────────────────────────────────────────────────────────

model OnboardingFunnelSettings {
  id String @id @default("default")
  // JSON map: { [stageId]: number } — null = no limit on that stage.
  wipLimits Json?
  // Days at the same stage before yellow / red treatment kicks in.
  stuckThresholdDays Int @default(7)
  stuckCriticalDays  Int @default(14)
  // How many days of nudge cadence in the drip when an admin
  // enrolls a tenant via "Send nudge campaign". The cron walks the
  // table at this cadence; tenants with `onboardingNudgeEnrolledAt`
  // set get a nudge email every N days until their stage advances.
  nudgeCadenceDays   Int @default(3)
  // Optional override of the email subject for the drip.
  nudgeSubject       String?
  nudgeBody          String?

  updatedAt DateTime @updatedAt
  updatedBy String?
}

model TenantHealthSnapshot {
  id       String @id @default(cuid())
  tenantId String

  // Snapshot time + the resolved overall score.
  computedAt DateTime @default(now())
  score      Int

  // Sub-scores stored as JSON: { loginFreq: 80, featureBreadth: 70, ... }
  // so we can evolve the score model without a schema migration.
  subscores Json?

  // Page 6 — version of the HealthScoringModel that produced this
  // snapshot. Lets the trend chart show "model v3 from this date" so
  // historical scores aren't silently re-interpreted under a newer
  // weighting. Nullable so legacy snapshots stay readable.
  modelVersion Int?
  // Whether this snapshot came from the active model or a shadow
  // candidate run side-by-side for A/B comparison. Default = active.
  shadow Boolean @default(false)
  // Flat sum of any active TenantHealthAdjustment.delta at compute
  // time — kept on the snapshot so we can answer "what was the
  // CSM-applied bump that day?" without replaying adjustments.
  adjustmentDelta Int @default(0)

  /** What triggered this snapshot — "scheduled" (daily cron),
   *  "manual" (admin clicked Recompute), "event" (driven by a
   *  meaningful event like payment_failed). */
  trigger String @default("scheduled")
  /** Optional human-readable note attached at compute time. */
  note    String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, computedAt])
  @@index([computedAt])
}

// ────────────────────────────────────────────────────────────
// Page 6 — Tenant Health Scores.
//
// HealthScoringModel keeps the weighted-factor model versioned so
// every TenantHealthSnapshot can attribute its score to a specific
// model. One row at a time has isActive=true (the live model that
// runs in the daily cron); one optional row has isShadow=true (the
// A/B candidate). Editing a model produces a new row — old rows are
// kept for historical attribution.
//
// TenantHealthAdjustment is the CSM-only manual override: a +/-
// delta with a reason (e.g. "+15: just signed a 3-yr deal, ignore
// jobs growth dip during ramp"). Adjustments expire if expiresAt is
// set — the daily cron re-evaluates at compute time.
// ────────────────────────────────────────────────────────────

model HealthScoringModel {
  id          String   @id @default(cuid())
  /** Monotonically-increasing version number. Treated as a label, not
   *  a sort key (use createdAt for that). */
  version     Int      @unique
  name        String
  description String?

  /** JSON map: { [factorKey]: number } — weights summing to 100.
   *  Factor key catalogue lives in src/server/platform/health-scoring.ts
   *  so factor definitions can evolve without schema changes. */
  weights     Json
  /** Optional human-readable formula explanation shown in the UI. */
  formula     String?

  /** Exactly one row should have isActive=true at any time. */
  isActive    Boolean  @default(false)
  /** Optional shadow / A/B candidate. Score computed in parallel
   *  with the active model but not used for the primary score. */
  isShadow    Boolean  @default(false)

  createdAt   DateTime @default(now())
  createdBy   String?
  activatedAt DateTime?
  archivedAt  DateTime?

  @@index([isActive])
  @@index([isShadow])
}

model TenantHealthAdjustment {
  id        String   @id @default(cuid())
  tenantId  String

  /** +/- delta clamped at +/- 50 in the action layer. */
  delta     Int
  reason    String

  /** Optional expiry — auto-clears after this date. */
  expiresAt DateTime?

  createdAt DateTime @default(now())
  /** User id of the CSM / admin who applied the adjustment. */
  createdBy String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([expiresAt])
}

// ────────────────────────────────────────────────────────────
// Page 7 — Churned & At-Risk.
//
// RetentionAttempt logs every save action a CSM takes against an
// at-risk tenant: applying a discount, scheduling a save call,
// marking engaged, or suppressing the alert. The action's payload is
// kept in the dedicated columns (couponId / scheduledFor / etc.) so
// reporting can pivot without parsing JSON.
//
// WinbackCampaign + WinbackEnrollment back the third tab — a
// lightweight "send X email to every churned tenant who matches
// filter Y, track opens/replies, count won-back". Email send happens
// on the daily cron; one row per (campaign, tenant) so we can
// dedupe and show per-tenant outcome.
// ────────────────────────────────────────────────────────────

model RetentionAttempt {
  id        String               @id @default(cuid())
  tenantId  String
  kind      RetentionAttemptKind

  /** Coupon applied for OFFER kind — null otherwise. */
  couponId      String?
  /** When the call is scheduled (SCHEDULE_CALL only). */
  scheduledFor  DateTime?
  /** When the at-risk alert is suppressed until (SUPPRESS_ALERT only).
   *  Mirrored onto Tenant.atRiskSuppressedUntil for fast filtering. */
  suppressUntil DateTime?
  /** Free-form follow-up note. */
  notes         String?

  createdAt DateTime @default(now())
  createdBy String

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([kind, createdAt])
}

enum RetentionAttemptKind {
  /** Discount coupon applied as a save offer. */
  OFFER
  /** Save-call scheduled with the tenant owner. */
  SCHEDULE_CALL
  /** "Tenant is engaged again" — clears the at-risk treatment for
   *  one full review cycle. */
  MARK_ENGAGED
  /** Mute the at-risk alert for X days. */
  SUPPRESS_ALERT
  /** Win-back email sent (separate from MARKETING campaign — for
   *  one-off email-the-owner sends from the row menu). */
  WINBACK_EMAIL
}

model WinbackCampaign {
  id          String                @id @default(cuid())
  name        String
  status      WinbackCampaignStatus @default(DRAFT)
  /** Free-form filter JSON — interpreted by the cron + the bulk-enrol
   *  action when audience size is computed. Today: { reasonCodes?,
   *  cancelledSinceDays? }. */
  audienceFilter Json?

  /** Email subject + plain-text body. Body is rendered into a <pre>
   *  block in the same path the onboarding nudges use. */
  emailSubject String?
  emailBody    String?

  /** Cached aggregates — recomputed when stats are read by the page,
   *  written incrementally by the cron + per-action wires. */
  audienceSize  Int @default(0)
  emailsSent    Int @default(0)
  emailsOpened  Int @default(0)
  replies       Int @default(0)
  wonBackCount  Int @default(0)

  startedAt DateTime?
  pausedAt  DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  enrollments WinbackEnrollment[]

  @@index([status, createdAt])
}

enum WinbackCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

model WinbackEnrollment {
  id         String   @id @default(cuid())
  campaignId String
  tenantId   String

  enrolledAt DateTime  @default(now())
  emailedAt  DateTime?
  openedAt   DateTime?
  repliedAt  DateTime?
  wonBack    Boolean   @default(false)
  wonBackAt  DateTime?

  campaign WinbackCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenant   Tenant          @relation(fields: [tenantId],   references: [id], onDelete: Cascade)

  @@unique([campaignId, tenantId])
  @@index([campaignId])
  @@index([tenantId])
}

enum PaymentTerms {
  DUE_ON_RECEIPT
  NET_15
  NET_30
  NET_45
  NET_60
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  // Phase 1 — soft-deleted tenant with a restore window. Behaves like
  // SUSPENDED for auth (owner cannot sign in) but is filtered out of
  // the platform tenants list by default and carries a scheduled
  // deletion timestamp after which a cron can hard-delete.
  ARCHIVED
}

// Phase 1 — test/demo tenants vs. real paying customers.
//
// LIVE  — paying or trialling-into-paying customer. Default for new signups.
// DEMO  — sales/marketing demo account shown to prospects. Billing disabled.
// TEST  — QA sandbox or internal playground. Banner visible across shell.
//
// Environment is orthogonal to TenantStatus — a DEMO tenant can be ACTIVE,
// SUSPENDED, etc. just like a LIVE one. It only changes UI chrome and
// platform-dashboard filtering.
enum TenantEnvironment {
  LIVE
  DEMO
  TEST
}

// Phase 19 — release cohort. Used to segment tenants into rollout waves
// (alpha/beta/pilot programs) so feature flags and comms can target
// groups. NONE = general availability, no special cohort.
enum BetaCohort {
  NONE
  ALPHA
  BETA
  PILOT
}

// Categorized reasons a tenant gets archived. Drives the "why are
// they leaving?" analytics on /platform/tenants. ADMIN_DECISION is
// the catch-all for platform-staff-initiated archives that don't map
// to a tenant-side cancellation reason.
enum ArchiveReasonCode {
  NOT_A_FIT
  TOO_EXPENSIVE
  MISSING_FEATURES
  SWITCHED_TO_COMPETITOR
  BUSINESS_CLOSED
  TEMPORARY_PAUSE
  TECHNICAL_ISSUES
  POOR_SUPPORT
  // Page 7 (Churned & At-Risk) — added so the cancellation reason
  // donut can split out usability complaints from feature-gap complaints.
  DIFFICULT_TO_USE
  ADMIN_DECISION
  OTHER
}

// Theme preference per user. AUTO follows the OS prefers-color-scheme;
// LIGHT / DARK lock the choice. Persisted on User so it's stable across
// devices.
enum ThemePreference {
  AUTO
  LIGHT
  DARK
}

enum Plan {
  STARTER
  GROWTH
  PRO
  ENTERPRISE
}

// ────────────────────────────────────────────────────────────
// Pricing plan management (M1).
//
// The legacy `Plan` enum above is a hard-coded four-slot set that every
// subsystem hardcodes against (entitlements, Stripe price map, marketing
// page). The new `PricingPlan` table lets platform admins edit names,
// prices, CTAs, copy, and feature values from /platform/pricing without
// a code deploy — and lets the marketing pages read their content from
// the same source that drives entitlements + Stripe checkout.
//
// M1 introduces the tables + a nullable FK on Tenant. The existing
// Tenant.plan enum keeps working; dual-write happens in a later slice
// and the enum gets dropped in M6.
// ────────────────────────────────────────────────────────────

// Lifecycle of a PricingPlan row.
//   DRAFT     — admin is editing, not visible to prospects
//   PUBLISHED — live: shown on marketing + purchasable
//   HIDDEN    — rows kept for existing subscribers but not shown to new
//               prospects (e.g. a legacy "Growth" tier)
//   ARCHIVED  — retired; nobody new can land here, existing subs got
//               migrated off
enum PlanStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

// Page 15 (Subscriptions) — billing cycle for a tenant subscription.
// Annual subs still surface MRR but we compute it as priceAnnual / 12
// so the rollups stay apples-to-apples.
enum BillingCycle {
  MONTHLY
  ANNUAL
}

// PlanFeatureValue encodes three shapes — boolean on/off, numeric cap,
// or free text label ("Unlimited", "Priority + chat"). `valueType`
// picks which column on PlanFeatureValue is canonical; the other two
// are ignored.
enum FeatureValueType {
  BOOLEAN
  NUMBER
  TEXT
}

// A feature row can be a real entitlement gate (`GATE` — the app
// checks it via `hasFeature()`), or marketing-only copy that shows
// up on the pricing page but has no runtime effect (`MARKETING_ONLY`).
// Separating the two avoids the current situation where feature
// bullets on /pricing drift silently away from what the code actually
// gates.
enum FeatureEnforcement {
  GATE
  MARKETING_ONLY
}

// ────────────────────────────────────────────────────────────
// Users & auth (NextAuth-compatible)
// ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?

  // Non-null only for SaaS-platform staff (super admin / site mgr / support).
  // Phase 1 follow-up — custom platform roles. When `customPlatformRoleId`
  // is set, the custom role's permission list overrides the baseline
  // `platformRole`. Either field alone is enough to mark the user as
  // staff; if both are set, the custom role wins. Neither = end-user.
  platformRole         PlatformRole?
  customPlatformRoleId String?
  customPlatformRole   CustomPlatformRole? @relation(fields: [customPlatformRoleId], references: [id], onDelete: SetNull)

  twoFactorEnabled Boolean   @default(false)
  lastLoginAt      DateTime?

  // ── Personal profile (Phase 23) ──
  // Optional self-service fields surfaced on /platform/profile (admin)
  // and /t/[slug]/settings/profile (tenant). Free-form text; nothing
  // wired into RBAC or routing.
  bio        String?
  timezone   String?           // IANA, e.g. "America/Los_Angeles"
  // Page 9 — self-reported phone number + verification, primary
  // language code (BCP-47 like "en-US"), and ISO-2 country. Surfaced
  // in the Users list filter bar + the user detail Profile tab.
  phone           String?
  phoneVerifiedAt DateTime?
  language        String?
  country         String?
  // UI preference; AUTO follows OS prefers-color-scheme.
  themePreference ThemePreference @default(AUTO)

  // Page 9 — soft deactivation. When set, sign-in is refused and the
  // row drops off the default user-directory view. `deactivatedBy`
  // captures the admin user who flipped the switch; `deactivatedReason`
  // is a free-form note. Reactivation clears all three.
  deactivatedAt     DateTime?
  deactivatedBy     String?
  deactivatedReason String?

  // ── Phase 2 (Auth/Security) ──
  // Bump this on password change or "sign out everywhere". The session
  // callback in `auth.ts` compares it to the token copy and nukes the
  // session when it drifts — effective session revocation without
  // switching off the JWT strategy.
  sessionVersion   Int       @default(0)
  // Rate-limit / lockout state for the credentials provider. Every
  // failed login increments `failedLoginCount`; reaching the threshold
  // writes `lockedUntil` and login refuses until it passes.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // ── Phase 4 (Trust & Safety) — direct ban flags on User ──
  // Denormalized so the auth path can refuse a banned user without a
  // second query (it already loads the User row). The full ban record
  // (who, why, when) lives in `BanRecord`; these mirror the most-recent
  // active ban so the auth check stays simple.
  bannedAt     DateTime?
  bannedReason String?
  // When the user is the source of a merge, we soft-delete and point
  // here so historical references still resolve. Sign-in is refused
  // when this is set. Cascade-null intentionally so removing the
  // target user doesn't orphan the merge pointer.
  mergedIntoId String?
  mergedInto   User?     @relation("UserMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   User[]    @relation("UserMerge")
  mergedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships            Membership[]
  sessions               Session[]
  accounts               Account[]
  twoFactor              UserTwoFactor?
  passwordResets         PasswordResetToken[]
  emailVerifications     EmailVerificationToken[]
  securityEvents         SecurityEvent[]
  twoFactorPendingLogins TwoFactorPendingLogin[]
  palettePins            PalettePin[]
  savedViews             SavedView[]
  portalMessageReplies   PortalMessage[]          @relation("PortalMessageSender")

  // Phase 1 — temporary platform-role elevation. A staff member can hold
  // a higher role for a bounded window (incident, on-call, vacation cover)
  // without changing their durable `platformRole`. Resolved on session
  // bump or by the auto-expire sweep.
  platformElevations        PlatformRoleElevation[] @relation("ElevationTarget")
  platformElevationsGranted PlatformRoleElevation[] @relation("ElevationGranter")

  // Phase 3 — platform-side billing artifacts created by this admin.
  couponsCreated          Coupon[]                 @relation("CouponCreator")
  platformInvoicesCreated PlatformBillingInvoice[] @relation("PlatformInvoiceCreator")

  // Phase 4 — trust & safety. Ban records pointed at this user (when
  // banned), bans this admin issued + lifted, merges this admin executed.
  banRecords     BanRecord[]       @relation("BannedUser")
  bansIssued     BanRecord[]       @relation("BanIssuer")
  bansLifted     BanRecord[]       @relation("BanLifter")
  mergesExecuted UserMergeRecord[] @relation("MergeExecutor")

  // Phase 1 follow-up — custom platform roles authored by this admin.
  customPlatformRolesCreated CustomPlatformRole[] @relation("CustomRoleCreator")

  // Page 2 — Activity Feed: per-staff saved filters + email/Slack
  // subscriptions. Cascade-delete so cleaning up a user nukes their
  // private views and any digest schedules they own.
  platformSavedViews     PlatformSavedView[]
  activitySubscriptions  ActivitySubscription[]

  // Page 3 — Reports & Insights: customised reports, per-user state
  // (favourites + pinned + last viewed), and scheduled deliveries
  // owned by this admin.
  reports             Report[]
  reportUserStates    ReportUserState[]
  reportSchedules     ReportSchedule[]

  // Page 4 — Tenants list "Account manager" assignment. Reverse side
  // of Tenant.accountManager — staff member assigned as the CSM
  // for one or more tenants.
  csmTenants          Tenant[] @relation("TenantAccountManager")

  // Page 4a — platform notes authored by this admin + tenant-detail
  // page views (for the "Recently viewed by team" rail widget).
  authoredTenantNotes TenantNote[]     @relation("TenantNoteAuthor")
  tenantViews         TenantViewedBy[] @relation("TenantViewer")

  // Page 9 — platform-side notes about this user (subject side).
  platformNotes        PlatformUserNote[] @relation("UserNoteSubject")
  // Notes this admin authored on other users.
  authoredUserNotes    PlatformUserNote[] @relation("UserNoteAuthor")

  // Page 11 — platform team memberships + on-call shifts.
  teamMemberships      PlatformTeamMember[]
  onCallShifts         OnCallShift[]

  // Page 12 — platform-admin invitations authored by this admin.
  platformInvitesAuthored PlatformInvite[] @relation("PlatformInviteAuthor")
}

// Platform-side roles. The first three (SUPER_ADMIN, SITE_MANAGER,
// SUPPORT_AGENT) are the legacy values — preserved for backward compat.
// The rest split staff responsibilities so we can grant least-privilege
// access without minting a new SUPER_ADMIN every time someone needs to
// run a refund or look at a chart.
enum PlatformRole {
  SUPER_ADMIN        // legacy — root of trust
  SITE_MANAGER       // legacy — operational lead
  SUPPORT_AGENT      // legacy — front-line support
  // Phase 1 additions — finer-grained baseline roles.
  ADMIN              // full access except destructive infra actions
  MANAGER            // ops manager — tenants, billing read, support oversight
  SUPPORT_LEAD       // support lead — escalations, macro management
  BILLING_MANAGER    // billing team — invoices, refunds, plan changes
  DEVELOPER          // engineering — feature flags, jobs, logs
  MARKETING_MANAGER  // marketing — announcements, leads, content
  CONTENT_MANAGER    // content/CMS — announcements, templates
  ANALYST            // BI — read analytics, run exports
  READ_ONLY_VIEWER   // exec / auditor — read everything, write nothing
}

// Phase 1 — temporary role elevation. Lets a SUPER_ADMIN/ADMIN grant a
// higher role to a teammate for a bounded window (incident, on-call,
// vacation cover) without changing the durable `User.platformRole`.
// `elevatedTo` is consulted by the permission resolver while
// `expiresAt > now()` and `revokedAt IS NULL`. Auto-expiry runs on
// session-version bumps and on a cron sweep.
model PlatformRoleElevation {
  id           String       @id @default(cuid())
  userId       String
  originalRole PlatformRole
  elevatedTo   PlatformRole
  reason       String       // free text — why the bump was granted
  grantedById  String
  expiresAt    DateTime
  revokedAt    DateTime?
  revokedById  String?
  createdAt    DateTime     @default(now())

  user      User @relation("ElevationTarget",  fields: [userId],      references: [id], onDelete: Cascade)
  grantedBy User @relation("ElevationGranter", fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Membership {
  id       String           @id @default(cuid())
  userId   String
  tenantId String
  role     TenantRole
  status   MembershipStatus @default(ACTIVE)

  // Phase 15 — per-member branch scope. Empty array means "all branches"
  // (the default for owners/admins and for single-location shops). When
  // populated, the member only sees & operates on these locations.
  locationIds String[] @default([])

  // Phase 4 — first-run welcome card dismissal. Stamped once the non-admin
  // member has closed the "Welcome to {workspace}" card on their first
  // dashboard visit. Null for fresh memberships; set once, never cleared.
  welcomeSeenAt DateTime?

  // Phase 16 — per-user notification delivery preferences stored as JSON.
  // Shape: { [NotificationType]: { inApp: boolean; email: boolean } }
  // Null means "use defaults" (all in-app on, email off by default).
  notifPrefs Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

enum TenantRole {
  OWNER
  ADMIN
  SALES_REP
  CSR
  DESIGNER
  PRODUCTION_MANAGER
  INSTALLER
  ACCOUNTING
  EMPLOYEE
  // Reserved — never assigned to a Membership. Customer access is
  // token-based (`PortalToken` / `ShareToken`), not role-based. Kept
  // in the enum so existing databases don't require an enum migration;
  // remove when a future Phase performs a coordinated Prisma migration.
  // See docs/transformation-plan.md §Phase 1.
  CUSTOMER_PORTAL
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model Invite {
  id         String     @id @default(cuid())
  tenantId   String
  email      String
  role       TenantRole
  token      String     @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
}

// NextAuth adapter tables — base columns are required by the adapter.
// Page 13 (Sessions & Devices) extends with optional context fields
// stamped at sign-in time (or whenever a request hits the session-touch
// middleware): IP, user-agent, geo lookup, MFA method used, and a
// `forceMfaPromptAt` lever so admins can require a re-prompt without
// invalidating the session outright.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  // Page 13 — extended context. All optional so legacy rows + JWT-
  // strategy paths that bypass DB sessions don't break.
  startedAt        DateTime  @default(now())
  lastActiveAt     DateTime?
  ipAddress        String?
  userAgent        String?
  /** Two-letter ISO country, populated by the auth-touch middleware
   *  from request headers. */
  country          String?
  city             String?
  /** Coarse device classification: "desktop" / "mobile" / "tablet" /
   *  "bot" / null. Derived once at write time so the table can filter
   *  without re-parsing UA strings every render. */
  deviceType       String?
  /** Browser name + version, OS name + version — both parsed from UA. */
  browserName      String?
  browserVersion   String?
  osName           String?
  osVersion        String?
  /** "totp" / "webauthn" / "sms" / null when no factor used. */
  mfaMethod        String?
  /** When set, every request must complete MFA again before being
   *  honored. Cleared on next successful re-prompt. */
  forceMfaPromptAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastActiveAt])
  @@index([ipAddress])
  @@index([country])
}

// Page 13 — Platform-side IP blocklist. When an admin clicks "Block
// IP" on a suspicious session, we mint one of these rows. The auth
// middleware refuses sign-ins from blocked IPs / CIDRs.
//
// Distinct from TenantIpRule (per-tenant allow/block) — this list is
// platform-wide and applies to staff sessions only.
model PlatformIpBlock {
  id          String   @id @default(cuid())
  /** Single IP or CIDR — e.g. "192.0.2.0/24" or "203.0.113.7". */
  cidr        String   @unique
  reason      String?
  expiresAt   DateTime?
  triggeredCount Int   @default(0)
  lastTriggeredAt DateTime?

  createdAt DateTime @default(now())
  createdBy String

  @@index([expiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ────────────────────────────────────────────────────────────
// Auditing
// ────────────────────────────────────────────────────────────

// ────────────────────────────────────────────────────────────
// CRM — customers, contacts, interactions, tasks
// ────────────────────────────────────────────────────────────

model Customer {
  id         String         @id @default(cuid())
  tenantId   String
  // Phase 15 — branch this customer is served from. Null = shared /
  // tenant-wide. Backfilled to the tenant's default location on first write.
  locationId String?
  kind       CustomerKind   @default(BUSINESS)
  name       String
  status     CustomerStatus @default(ACTIVE)

  // Pipeline / sales tracking
  stage            PipelineStage @default(NEW_LEAD)
  estimatedValue   Decimal?      @db.Decimal(12, 2)
  closeProbability Int? // 0-100
  lostReason       String?
  source           String? // lead source — free text or canonical value

  // Phase 13 — per-customer default discount %. Auto-applied when creating a
  // new quote for this customer. 0 = no default. Rep can still override.
  defaultDiscountPct Int @default(0)

  tags  String[] @default([])
  notes String?

  // Owner = assigned tenant user. Plain id; we resolve names in queries.
  ownerId String?

  // Primary contact info (for individuals, or shop-floor contact for businesses)
  email   String?
  phone   String?
  website String?

  // Billing address
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingCity         String?
  billingRegion       String?
  billingPostalCode   String?
  billingCountry      String?

  // Install / shipping address
  installAddressLine1 String?
  installAddressLine2 String?
  installCity         String?
  installRegion       String?
  installPostalCode   String?
  installCountry      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location       Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  contacts       Contact[]
  interactions   Interaction[]
  tasks          Task[]
  quotes         Quote[]
  orders         Order[]
  invoices       Invoice[]
  files          File[]
  installEvents  InstallEvent[]
  portalTokens   PortalToken[]
  comments       Comment[]
  emailEvents    EmailEvent[]
  portalMessages PortalMessage[]
  // Phase 14 — a credit memo belongs to a customer and can be applied
  // against any of their invoices. Carrying the relation here lets the
  // customer detail page surface outstanding credit balance at a glance.
  creditMemos    CreditMemo[]

  @@index([tenantId, stage])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@index([tenantId, ownerId])
  @@index([tenantId, locationId])
}

enum CustomerKind {
  BUSINESS
  INDIVIDUAL
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PipelineStage {
  NEW_LEAD
  CONTACTED
  QUOTED
  NEGOTIATING
  WON
  LOST
}

model Contact {
  id         String  @id @default(cuid())
  tenantId   String
  customerId String
  firstName  String
  lastName   String?
  title      String?
  email      String?
  phone      String?
  isPrimary  Boolean @default(false)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
}

model Interaction {
  id         String          @id @default(cuid())
  tenantId   String
  customerId String
  userId     String // who logged it
  type       InteractionType
  subject    String?
  body       String?
  occurredAt DateTime        @default(now())
  createdAt  DateTime        @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId, occurredAt])
}

enum InteractionType {
  NOTE
  CALL
  EMAIL
  MEETING
  TEXT
}

model Task {
  id           String       @id @default(cuid())
  tenantId     String
  customerId   String?
  // Phase 10 — tasks can be pinned to an order for shop-floor coordination.
  // Keeps standalone tasks (customer-scoped or ad-hoc) working unchanged.
  orderId      String?
  // Phase 10 — self-referential subtasks so a "Install Monday" task can
  // have "Pack truck", "Confirm site contact", "Pick up permit" underneath
  // without spawning a separate model.
  parentTaskId String?
  assignedTo   String? // userId
  createdBy    String // userId
  title        String
  description  String?
  dueDate      DateTime?
  completedAt  DateTime?
  priority     TaskPriority @default(NORMAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  parentTask Task?     @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks   Task[]    @relation("TaskSubtasks")
  comments   Comment[]

  @@index([tenantId, completedAt, dueDate])
  @@index([tenantId, assignedTo, completedAt])
  @@index([tenantId, customerId])
  @@index([tenantId, orderId, completedAt])
  @@index([parentTaskId])
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

// ────────────────────────────────────────────────────────────
// Catalog — products, services, fees + option groups
// ────────────────────────────────────────────────────────────

model Product {
  id           String       @id @default(cuid())
  tenantId     String
  name         String
  description  String?
  sku          String?
  category     String?
  pricingModel PricingModel @default(FIXED)
  basePrice    Decimal      @default(0) @db.Decimal(12, 2)
  cost         Decimal?     @db.Decimal(12, 2)
  unit         String? // display label: "each", "sq ft", "ft", "hour"
  taxable      Boolean      @default(true)
  active       Boolean      @default(true)
  imageUrl     String?

  // Phase 8 — catalog taxonomy. The "kind" classifies what sort of thing
  // this row is (a print product, an install service, a delivery fee, etc.).
  // Used to adapt form defaults, filter the catalog, and let the quote
  // builder surface the right items in the right sections. Old rows default
  // to STANDARD so the column is safe to add without data migration.
  kind ProductKind @default(STANDARD)

  // Phase 8 — formula pricing. When set to MANUAL (the default) the shop
  // enters `basePrice` directly and we honor it. When set to COST_PLUS_PCT
  // or COST_PLUS_FIXED, the catalog derives basePrice from cost + markup
  // and ignores the manually-entered basePrice. This keeps pricing
  // consistent with the shop's margin targets without requiring every
  // product to be hand-priced.
  priceFormula PriceFormula @default(MANUAL)
  markupPct    Decimal?     @db.Decimal(6, 2) // used when priceFormula = COST_PLUS_PCT
  markupFixed  Decimal?     @db.Decimal(12, 2) // used when priceFormula = COST_PLUS_FIXED

  // Phase 8 — internal-only fields. These never surface on a customer-facing
  // quote or portal view. Production notes tell the shop floor what matters
  // about this item; spec sheet is a longer technical reference; internalSku
  // is a separate code for inventory or purchasing systems.
  productionNotes String?
  specSheet       String? @db.Text
  internalSku     String?

  // Phase 18 Slice F — industry pricing. Trim / offcut waste expressed as a
  // percentage (0-100). For dimension-based pricing (PER_SQFT, PER_LINEAR_FT)
  // this grosses up the area / length by (1 + wasteFactorPct/100) before the
  // price is applied. Lets sign/print shops quote the way they actually cut
  // material without hand-doing the math on every line. Zero by default so
  // nothing changes for existing products.
  wasteFactorPct Decimal @default(0) @db.Decimal(6, 2)

  // Phase 15 Slice D — when true AND the owning tenant is a group root,
  // every child tenant in the group sees this product as inherited. Has no
  // effect on non-group-root tenants. Children can't edit inherited rows.
  shared Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  optionGroups      ProductOptionGroup[]
  quantityTiers     ProductQuantityTier[]
  quoteItems        QuoteItem[]
  orderItems        OrderItem[]
  packageComponents ProductPackageComponent[] @relation("ComponentProduct")
  templateItems     QuoteTemplateItem[]       @relation("TemplateProduct")

  @@index([tenantId, active])
  @@index([tenantId, category])
  @@index([tenantId, name])
  @@index([tenantId, kind])
}

// Phase 8 — product classification.
//
// Sign / print shops don't just sell "products" — their catalogue is a mix
// of physical goods, recurring services, and conditional fees. Classifying
// each row lets the UI group and present them sensibly and lets the quote
// builder suggest the right things in the right slots (e.g. "add an
// install service" vs "add a rush fee").
enum ProductKind {
  STANDARD // generic physical good (fallback / legacy)
  PRINT // printed items (banners, business cards, decals…)
  SIGN // fabricated signs, channel letters, monument signs
  INSTALL_SERVICE // on-site installation labor
  DESIGN_SERVICE // artwork / design labor
  LABOR // general shop labor (not tied to install or design)
  SETUP_FEE // one-time setup charge (prepress, plate, tooling)
  RUSH_FEE // expedite surcharge
  DELIVERY_FEE // delivery / shipping line
  CUSTOM // one-off custom-quoted item
}

// Phase 8 — pricing formula mode.
//
// MANUAL — the shop typed the basePrice themselves. We use it as-is.
// COST_PLUS_PCT — basePrice = cost * (1 + markupPct/100). We derive at
// save time. A shop with a 40% margin target can set "40" once and every
// product priced this way stays consistent.
// COST_PLUS_FIXED — basePrice = cost + markupFixed. Used for low-margin
// parts where a flat $ uplift is more predictable than a percentage.
enum PriceFormula {
  MANUAL
  COST_PLUS_PCT
  COST_PLUS_FIXED
}

// Phase 13 — quantity breaks. Each tier says "when ordered quantity >=
// minQuantity, use this pricePerUnit instead of the product's basePrice."
// Only meaningful for quantity-based pricing models (PER_UNIT, PER_SQFT,
// PER_LINEAR_FT). The snapshot is copied onto QuoteItem.quantityTiers at
// add-time so later catalog edits don't retroactively reprice.
model ProductQuantityTier {
  id           String  @id @default(cuid())
  productId    String
  minQuantity  Int // apply this tier when quantity >= minQuantity
  pricePerUnit Decimal @db.Decimal(12, 2)
  sortOrder    Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

enum PricingModel {
  FIXED // single flat price
  PER_UNIT // basePrice × quantity
  PER_SQFT // basePrice × area (square feet)
  PER_LINEAR_FT // basePrice × length (feet)
  LABOR_HOURLY // basePrice × hours
  CUSTOM_QUOTE // sales rep enters price per quote
}

model ProductOptionGroup {
  id        String  @id @default(cuid())
  productId String
  name      String
  required  Boolean @default(false)
  sortOrder Int     @default(0)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductOption[]

  @@index([productId])
}

model ProductOption {
  id              String  @id @default(cuid())
  optionGroupId   String
  label           String
  priceAdjustment Decimal @default(0) @db.Decimal(12, 2)
  sortOrder       Int     @default(0)

  optionGroup ProductOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@index([optionGroupId])
}

// Phase 8 — package templates.
//
// A "package" is a reusable bundle of products — the shop names the bundle
// ("Storefront starter pack") and lists the components with default
// quantities. When a rep adds a package to a quote, we expand it to the
// corresponding quote items in one click. The source `ProductPackage` row
// is NOT deleted from the quote — we only use it to drive the expansion.
// Components keep a FK to the underlying Product so swapping out a
// component's source updates future expansions but not historical quotes.
model ProductPackage {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  description String?
  active      Boolean @default(true)

  // Optional internal-only notes — shown to reps when they hover/select
  // the package, not to customers.
  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  components ProductPackageComponent[]

  @@index([tenantId, active])
  @@index([tenantId, name])
}

model ProductPackageComponent {
  id              String  @id @default(cuid())
  packageId       String
  productId       String
  // Default quantity pre-filled when the package is expanded into a quote.
  // A rep can override the quantity after expansion. For dimension-based
  // products this multiplies the computed area/length at add-time.
  defaultQuantity Decimal @default(1) @db.Decimal(12, 3)
  // Optional note that follows the expanded line onto the quote — useful
  // for "Includes 2 hours of on-site adjustment" context.
  note            String?
  sortOrder       Int     @default(0)

  package ProductPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  product Product        @relation("ComponentProduct", fields: [productId], references: [id], onDelete: Restrict)

  @@index([packageId])
  @@index([productId])
}

// ────────────────────────────────────────────────────────────
// Quotes
// ────────────────────────────────────────────────────────────

model Quote {
  id         String      @id @default(cuid())
  tenantId   String
  customerId String
  // Phase 15 — branch the quote was written at. Defaults to the customer's
  // location if one is set.
  locationId String?
  number     String // e.g. "Q-1001" — unique within tenant
  status     QuoteStatus @default(DRAFT)

  issuedAt       DateTime?
  expiresAt      DateTime?
  sentAt         DateTime?
  viewedAt       DateTime?
  approvedAt     DateTime?
  declinedAt     DateTime?
  // Phase A Slice 3 — structured decline reason for win/loss analytics. The
  // free-text `declinedNote` captures the "why" for sales follow-up; the enum
  // lets us roll up loss buckets in reports without parsing notes.
  declinedReason DeclinedReason?
  declinedNote   String?

  // Stored totals (recomputed whenever items/meta change).
  subtotal       Decimal      @default(0) @db.Decimal(12, 2)
  discountType   DiscountType @default(NONE)
  discountValue  Decimal      @default(0) @db.Decimal(12, 2) // flat $ or 0-100 %
  discountAmount Decimal      @default(0) @db.Decimal(12, 2)
  taxRate        Decimal      @default(0) @db.Decimal(6, 4) // snapshot from tenant at creation
  taxAmount      Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @default(0) @db.Decimal(12, 2)

  // Meta
  notes        String? // internal
  customerNote String? // visible to customer
  terms        String?

  createdBy  String // userId
  salesRepId String? // userId

  // Phase 13: approval override state. When a quote trips a discount or
  // large-job threshold, a manager/owner must stamp `approvedToSendAt` before
  // it can move DRAFT→SENT. Null = untouched (no approval has ever been applied).
  approvedToSendAt   DateTime?
  approvedToSendById String?

  // Phase 9 — deposit required before the job moves into production. Recomputed
  // alongside other totals; mirrors the discount pattern (type + value + amount).
  // PERCENT is 0–100 of the post-tax total; FIXED is a flat $ amount.
  depositType   DepositType @default(NONE)
  depositValue  Decimal     @default(0) @db.Decimal(12, 2)
  depositAmount Decimal     @default(0) @db.Decimal(12, 2)

  // Phase 9 — optional-items rollup. Optional lines are EXCLUDED from the main
  // subtotal/tax/total (they're upsells the customer chooses); this field
  // records the sum of their subtotals so the UI can show "Optional add-ons".
  optionalSubtotal Decimal @default(0) @db.Decimal(12, 2)

  // Phase 9 — public share link. One-time unguessable token gating the
  // customer-facing /q/[token] page. Null means the quote hasn't been shared
  // publicly yet (it can still be viewed through the /portal link).
  shareToken String? @unique

  // Phase 9 — revision chain. A new revision clones the parent and sets
  // `parentQuoteId`; the parent is stamped `supersededAt` so it stops showing
  // in normal lists. `revisionNumber` starts at 1 and increments per revision.
  parentQuoteId  String?
  revisionNumber Int       @default(1)
  supersededAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  location    Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items       QuoteItem[]
  sections    QuoteSection[]
  order       Order?
  files       File[]
  comments    Comment[]
  parentQuote Quote?         @relation("QuoteRevisions", fields: [parentQuoteId], references: [id], onDelete: SetNull)
  revisions   Quote[]        @relation("QuoteRevisions")

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, updatedAt])
  @@index([tenantId, locationId])
  @@index([parentQuoteId])
}

// Phase 9 — groups quote lines under a heading ("Signage", "Installation",
// "Optional upgrades"). Sections are ordered; lines reference a section via
// `sectionId`. A null sectionId means the line sits in the un-grouped area
// at the top of the quote (backwards compatible with pre-Phase-9 quotes).
model QuoteSection {
  id          String  @id @default(cuid())
  quoteId     String
  title       String
  description String?
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  items QuoteItem[]

  @@index([quoteId])
}

enum DepositType {
  NONE
  FIXED
  PERCENT
}

// ────────────────────────────────────────────────────────────
// Phase 9 — Quote templates
// ────────────────────────────────────────────────────────────
//
// Snapshot-style starting points for recurring jobs. Templates store their
// sections + item snapshots locally — new-from-template copies the data
// into a fresh Quote/QuoteSection/QuoteItem tree. Edits to a template
// never touch quotes already created from it, and vice versa.

model QuoteTemplate {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  description String?

  // Meta copied onto new quotes when this template is used. Blank fields
  // mean "don't override whatever the new quote already picked up from
  // tenant defaults."
  customerNote String?
  terms        String?

  // Default discount + deposit settings, preserved so a repeat job can
  // carry its negotiated terms without hand-re-entry.
  discountType  DiscountType @default(NONE)
  discountValue Decimal      @default(0) @db.Decimal(12, 2)
  depositType   DepositType  @default(NONE)
  depositValue  Decimal      @default(0) @db.Decimal(12, 2)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections QuoteTemplateSection[]
  items    QuoteTemplateItem[]

  @@index([tenantId, active])
  @@index([tenantId, name])
}

model QuoteTemplateSection {
  id          String  @id @default(cuid())
  templateId  String
  title       String
  description String?
  sortOrder   Int     @default(0)

  template QuoteTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    QuoteTemplateItem[]

  @@index([templateId])
}

model QuoteTemplateItem {
  id         String  @id @default(cuid())
  templateId String
  sectionId  String?

  // Optional link back to the catalog product the line snapshot came from.
  // Kept nullable so a template can carry an ad-hoc line (like a pre-made
  // "Project management" bullet) without requiring a Product row.
  productId String?

  // Snapshot — mirrors QuoteItem so new-from-template is a straight copy.
  name         String
  description  String?
  pricingModel PricingModel
  basePrice    Decimal      @db.Decimal(12, 2)
  unit         String?
  taxable      Boolean      @default(true)

  quantity Decimal? @db.Decimal(12, 3)
  width    Decimal? @db.Decimal(12, 3)
  height   Decimal? @db.Decimal(12, 3)
  length   Decimal? @db.Decimal(12, 3)
  hours    Decimal? @db.Decimal(12, 3)

  manualPrice     Decimal? @db.Decimal(12, 2)
  selectedOptions Json     @default("[]")
  quantityTiers   Json     @default("[]")
  wasteFactorPct  Decimal  @default(0) @db.Decimal(6, 2)
  costSnapshot    Decimal? @db.Decimal(12, 2)

  isOptional Boolean @default(false)
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())

  template QuoteTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  section  QuoteTemplateSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  product  Product?              @relation("TemplateProduct", fields: [productId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@index([sectionId])
  @@index([productId])
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  DECLINED
  EXPIRED
}

// Phase A Slice 3 — buckets for why a quote was declined. Mirrors the
// common win/loss categories shops actually act on: price too high, lost
// to a competitor, timing (customer isn't ready), no response, or "other"
// with a free-text note.
enum DeclinedReason {
  PRICE
  COMPETITOR
  TIMING
  NO_RESPONSE
  SCOPE_CHANGE
  OTHER
}

enum DiscountType {
  NONE
  FIXED
  PERCENT
}

// A line on a quote. Snapshots the product's pricing data at the time the line
// was added, so later product edits don't mutate historical quotes.
model QuoteItem {
  id        String  @id @default(cuid())
  quoteId   String
  productId String? // nullable: ad-hoc line items OK, or product deleted later

  // Snapshot
  name         String
  description  String?
  pricingModel PricingModel
  basePrice    Decimal      @db.Decimal(12, 2)
  unit         String?
  taxable      Boolean      @default(true)

  // Inputs (depend on pricingModel)
  quantity Decimal? @db.Decimal(12, 3)
  width    Decimal? @db.Decimal(12, 3)
  height   Decimal? @db.Decimal(12, 3)
  length   Decimal? @db.Decimal(12, 3)
  hours    Decimal? @db.Decimal(12, 3)

  // For CUSTOM_QUOTE lines — rep enters final price.
  manualPrice Decimal? @db.Decimal(12, 2)

  // JSON array: [{ groupName, label, adjustment }]
  selectedOptions Json @default("[]")

  // Phase 13 — JSON snapshot of product quantity tiers at add-time:
  // [{ minQuantity, pricePerUnit }]. Empty array = no tier pricing.
  // Snapshot keeps historical quotes stable when the catalog later changes.
  quantityTiers Json @default("[]")

  // Phase 18 Slice F — waste factor snapshot from the product at add-time.
  // Percentage 0-100; grosses up the billable area / length for PER_SQFT
  // and PER_LINEAR_FT. Snapshot so later catalog edits don't reprice
  // historical quotes. Zero for ad-hoc lines and legacy rows.
  wasteFactorPct Decimal @default(0) @db.Decimal(6, 2)

  // Phase 18 Slice F — cost snapshot from the product at add-time so we can
  // show gross margin on the quote without re-reading the catalog (which may
  // have drifted). Nullable for ad-hoc lines where cost isn't known.
  costSnapshot Decimal? @db.Decimal(12, 2)

  subtotal  Decimal @default(0) @db.Decimal(12, 2)
  sortOrder Int     @default(0)

  // Phase 9 — grouping + optional-line markers.
  // `sectionId` null = the line sits in the default un-grouped band at the top.
  // `isOptional` true = customer-selectable upsell; excluded from the main
  // totals, summed separately into Quote.optionalSubtotal.
  sectionId  String?
  isOptional Boolean @default(false)

  createdAt DateTime @default(now())

  quote   Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  section QuoteSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([sectionId])
}

// ────────────────────────────────────────────────────────────
// Orders — produced from approved quotes
// ────────────────────────────────────────────────────────────

model Order {
  id         String      @id @default(cuid())
  tenantId   String
  customerId String
  // Phase 15 — branch fulfilling the order. Inherited from the quote (or
  // customer) at conversion time; can be re-pointed mid-job if another
  // branch takes over production.
  locationId String?
  quoteId    String?     @unique // source quote (one order per quote)
  number     String // e.g. "O-1001" — unique within tenant
  status     OrderStatus @default(NEW)

  // Totals snapshotted from the quote at conversion time.
  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @default(0) @db.Decimal(12, 2)

  // Deposit tracking (Phase 7 Invoices will update paidAmount via payments).
  depositPercent Int     @default(0)
  paidAmount     Decimal @default(0) @db.Decimal(12, 2)

  // Schedule / timestamps
  dueDate      DateTime?
  scheduledFor DateTime?
  startedAt    DateTime?
  readyAt      DateTime?
  completedAt  DateTime?
  canceledAt   DateTime?
  cancelReason String?

  // Assignees (userIds)
  productionManagerId String?
  installerId         String?
  createdBy           String

  // Notes
  customerNote    String?
  productionNotes String?
  installNotes    String?

  // Phase 10 — rush / priority flag. Separate from tenant-level rush fee
  // (which is a pricing concern on the quote). Shows up as a pill on the
  // detail page, a filter on the list, and a sort-ahead hint for reps.
  priority OrderPriority @default(NORMAL)

  // Phase 10 — job specs. These answer "what are we actually making?"
  // at the order level. Kept as concrete columns instead of a generic JSON
  // blob so the UI can render labels, migrations can index if needed, and
  // tenants don't fight with schema-less sludge.
  material            String?
  finish              String?
  colorSpecs          String? // Pantone / CMYK / RGB / custom
  installMethod       String?
  specialInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  location       Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  quote          Quote?            @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  invoices       Invoice[]
  files          File[]
  proofs         Proof[]
  installEvents  InstallEvent[]
  comments       Comment[]
  checklistItems ChecklistItem[]
  // Phase 10 — on-hold reasons tracked as a separate model so history
  // survives the resolve step (reason + who blocked it + when).
  blockers       OrderBlocker[]
  // Phase 10 — order-scoped tasks (Task.orderId is nullable so ad-hoc
  // and customer tasks keep working as before).
  tasks          Task[]
  // Phase 12 — production stages (department-typed work pipeline).
  // Each stage represents a unit of work for a specific department/machine.
  // Different from OrderItem (= line items quoted + sold): stages track the
  // physical production path through the shop. An order with three line
  // items might still run through a single "Cut + Weed + Laminate" sequence
  // of stages if the shop wants; or each line item gets its own stages.
  stages         ProductionStage[]
  // Defect reports and material usage roll up to the order so the
  // job-costing report can compute real margin (material + rework).
  defectReports  DefectReport[]
  materialUsages MaterialUsage[]
  // Phase 14 — job-linked expenses. Margin computation pulls these to
  // subtract costs from invoice revenue on the order detail page.
  expenses       Expense[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, dueDate])
  @@index([tenantId, updatedAt])
  @@index([tenantId, locationId])
  @@index([tenantId, priority])
}

enum OrderStatus {
  NEW
  IN_PRODUCTION
  READY
  OUT_FOR_INSTALL
  COMPLETED
  CANCELED
}

// Phase 10 — escalation level for a shop-floor order. Derived from the
// sales-side rush fee on the quote, but re-stated on the order so it
// survives edits to the source quote and so production can raise / lower
// priority without fiddling with the quote.
enum OrderPriority {
  NORMAL
  HIGH
  RUSH
}

// Phase 10 — a single on-hold reason. An order can accumulate multiple
// blockers over its lifetime; the UI shows active blockers prominently
// and keeps resolved ones for history. The `orderCanEnterProduction`
// gate (Phase 13) is extended to also block when any unresolved blocker
// exists, so the sales team can't accidentally push a paused job.
model OrderBlocker {
  id         String        @id @default(cuid())
  tenantId   String
  orderId    String
  reason     BlockerReason
  notes      String?
  blockedBy  String // userId who flagged it
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?
  resolvedBy String? // userId who resolved it

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId, resolvedAt])
  @@index([orderId, resolvedAt])
}

enum BlockerReason {
  AWAITING_CUSTOMER
  AWAITING_APPROVAL
  AWAITING_MATERIALS
  AWAITING_PROOF
  AWAITING_PAYMENT
  CUSTOM
}

// Each line item is snapshotted from the quote so production proceeds on frozen data.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?

  name         String
  description  String?
  pricingModel PricingModel
  basePrice    Decimal      @db.Decimal(12, 2)
  unit         String?
  taxable      Boolean      @default(true)

  quantity    Decimal? @db.Decimal(12, 3)
  width       Decimal? @db.Decimal(12, 3)
  height      Decimal? @db.Decimal(12, 3)
  length      Decimal? @db.Decimal(12, 3)
  hours       Decimal? @db.Decimal(12, 3)
  manualPrice Decimal? @db.Decimal(12, 2)

  selectedOptions Json    @default("[]")
  subtotal        Decimal @default(0) @db.Decimal(12, 2)
  sortOrder       Int     @default(0)

  // Production tracking
  producedAt DateTime?

  createdAt DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ────────────────────────────────────────────────────────────
// Invoices & payments
// ────────────────────────────────────────────────────────────

model Invoice {
  id         String        @id @default(cuid())
  tenantId   String
  customerId String
  orderId    String? // invoices may stand alone
  // Phase 15 — branch that issued / collects on this invoice. Inherited
  // from the linked order or customer; accounting runs can roll up by
  // location.
  locationId String?
  number     String // e.g. "INV-1001"
  status     InvoiceStatus @default(DRAFT)
  kind       InvoiceKind   @default(STANDARD)

  issuedAt DateTime?
  dueDate  DateTime?
  sentAt   DateTime?
  paidAt   DateTime?
  voidedAt DateTime?

  // Stored totals (recomputed whenever items or tax/discount change).
  subtotal       Decimal      @default(0) @db.Decimal(12, 2)
  discountType   DiscountType @default(NONE)
  discountValue  Decimal      @default(0) @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @db.Decimal(12, 2)
  taxRate        Decimal      @default(0) @db.Decimal(6, 4)
  taxAmount      Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @default(0) @db.Decimal(12, 2)
  amountPaid     Decimal      @default(0) @db.Decimal(12, 2)

  terms         PaymentTerms @default(NET_30)
  customerNote  String?
  internalNotes String?

  // Phase 14 — denormalized refund / credit / write-off totals kept in sync
  // by recomputeInvoiceTotals(). This lets list views render "balance" /
  // "overdue" without a five-way aggregate on every row.
  refundedAmount   Decimal @default(0) @db.Decimal(12, 2)
  creditedAmount   Decimal @default(0) @db.Decimal(12, 2)
  writtenOffAmount Decimal @default(0) @db.Decimal(12, 2)

  createdBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order              Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  location           Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items              InvoiceItem[]
  payments           Payment[]
  // Phase 14 — post-payment financial actions.
  refunds            Refund[]
  creditApplications CreditApplication[]
  writeOffs          WriteOff[]
  // Phase 15 — unauthenticated public share links for this invoice.
  shareTokens        ShareToken[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, dueDate])
  @@index([tenantId, orderId])
  @@index([tenantId, locationId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  VOID
  // Phase 14 — the invoice has been closed as uncollectable. A write-off is
  // an accounting acknowledgment that the remaining balance won't be paid;
  // distinct from VOID (which says the invoice shouldn't have existed).
  WRITTEN_OFF
}

enum InvoiceKind {
  STANDARD
  DEPOSIT
  BALANCE
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  name        String
  description String?
  quantity    Decimal @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  taxable     Boolean @default(true)
  subtotal    Decimal @default(0) @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id        String @id @default(cuid())
  tenantId  String
  invoiceId String

  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  reference  String? // check #, last 4, txn id
  note       String?
  receivedAt DateTime      @default(now())
  recordedBy String
  voidedAt   DateTime?
  voidReason String?

  // Phase 14 — mark payments that fell through (card declined, ACH returned,
  // check bounced). failedAt is distinct from voidedAt: voided means the
  // recorder retracted a correctly-captured payment (wrong amount etc.);
  // failed means the money never actually landed. Both zero out the payment's
  // contribution to invoice.amountPaid, but the history + reason stay.
  failedAt      DateTime?
  failureReason String?

  createdAt DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Refunds against this specific payment (typical flow — refund the card
  // that was charged). Refunds may also stand alone with no source payment.
  refunds Refund[]

  @@index([tenantId, invoiceId])
  @@index([tenantId, receivedAt])
}

enum PaymentMethod {
  CASH
  CHECK
  CARD
  ACH
  // Phase 14 — applying a credit memo to an invoice is recorded as a
  // Payment so the invoice's amountPaid math is uniform. The payment row
  // links back to the CreditApplication via its reference field.
  CREDIT_MEMO
  OTHER
}

// ────────────────────────────────────────────────────────────
// Files & Proofs
// ────────────────────────────────────────────────────────────

// URL-based file records. Real blob storage (S3 / Vercel Blob / R2) comes in
// Phase 14 — for now `storageUrl` is any hosted URL the user pastes in.
// Each file is attached to at most one parent entity.
model File {
  id         String @id @default(cuid())
  tenantId   String
  uploaderId String

  filename     String
  mimeType     String?
  sizeBytes    Int?
  storageUrl   String
  thumbnailUrl String?

  kind  FileKind @default(ATTACHMENT)
  notes String?

  // Phase 11 — soft archive. We never hard-delete old proof files because
  // there's legal/dispute value in "what did we show the customer on v1?"
  // archivedAt flips this out of the main list but keeps it referenceable
  // from the audit trail and the revision history.
  archivedAt DateTime?
  archivedBy String?

  // Phase 11 — designer-facing iteration label. This is separate from
  // Proof.version: a single art piece can go through 4 internal tweaks
  // before it ever reaches a customer-facing proof version. Null = no
  // versioning (reference photos, briefs, etc.).
  assetVersion Int?

  // Phase 11 — dimensions for display purposes (px or in — we don't
  // enforce units because shops mix digital & physical; treat as metadata).
  widthPx  Int?
  heightPx Int?

  // Parent — at most one should be set. Not enforced in DB but validated in actions.
  customerId String?
  quoteId    String?
  orderId    String?
  proofId    String?

  createdAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quote    Quote?    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  proof    Proof?    @relation(fields: [proofId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([customerId])
  @@index([quoteId])
  @@index([orderId])
  @@index([proofId])
  @@index([proofId, archivedAt])
}

enum FileKind {
  ATTACHMENT // generic — briefs, photos, email threads
  REFERENCE // customer-provided inspiration / existing signs
  ARTWORK // production-ready art (deprecated in favor of the split below; kept for back-compat)
  PROOF // customer-facing proof mock-up (what the customer sees on portal)
  // Phase 11 — richer taxonomy so a designer can tell "source file" (Illustrator
  // .ai for editing), "production ready" (flattened PDF for the plotter), and
  // "reference" (inspiration) apart at a glance. The old ARTWORK value is
  // preserved so existing rows still work; new uploads should use the split.
  DESIGN_SOURCE // native design file (.ai, .psd, .indd) — designer-only
  PRODUCTION_READY // final production file sent to the machine (cut-ready PDF, RIP file)
  MOCKUP // rendered visualization on a location/building — internal
  INVOICE // scanned PO / receipt
  // Phase 15 — customer-uploaded file from the portal (site photo, brief,
  // existing branding pack). Distinct from REFERENCE so staff can filter
  // "things the customer just handed us" on the order timeline.
  CUSTOMER_UPLOAD
  OTHER
}

// Proofs are versioned per order. Each version can include multiple files
// (PDF mock-ups, JPG renderings). Customer can approve / request changes.
model Proof {
  id          String      @id @default(cuid())
  tenantId    String
  orderId     String
  version     Int // 1, 2, 3... unique per order
  title       String?
  description String?
  status      ProofStatus @default(DRAFT)

  // Phase 11 — designer-only notes. These never render on the customer
  // portal; they're where the artist leaves context for the next designer
  // ("trapping to 0.5pt for outdoor legibility", "used ink key B from the
  // Pantone book, not the digital sim"). Kept separate from `description`,
  // which IS customer-visible on the portal.
  internalNotes String?

  // Phase 11 — customer response deadline. We use this in two places:
  // (1) the portal shows "respond by X" prominently, and (2) the reminder
  // cron bumps stale proofs once past this date. If null, no deadline is
  // enforced — older shops operate that way.
  dueAt DateTime?

  // Phase 11 — revision-round counter. Every time the proof goes from
  // CHANGES_REQUESTED back to SENT with new files, this increments. So
  // v1 might ship as "v1, round 3" if it took three bounces before the
  // customer signed off. Different from `version`: version = "new art
  // entirely", round = "same art, reworked".
  revisionRound Int @default(1)

  // Phase 11 — watermark intent flag. Actual on-the-fly image stamping
  // needs blob storage (coming later), so for now this records the
  // designer's intent; the portal page will display a "PROOF ONLY"
  // overlay CSS-side when enabled. Cheap and still a useful deterrent.
  watermarkEnabled Boolean @default(true)

  // Phase 11 — lock fields. Once APPROVED, the proof is immutable:
  // no file add/remove, no title/description edits, no status revert.
  // Nulls = not locked. We write both at the same time.
  lockedAt DateTime?
  lockedBy String?

  // Phase 11 — revision chain. When CHANGES_REQUESTED bounces to a new
  // proof version, the newer proof points back here. Combined with the
  // per-order `version` field, this lets us render "v1 → v2 → v3" while
  // also supporting the occasional branch (v2a vs v2b).
  supersededByProofId String?
  supersededAt        DateTime?

  sentAt           DateTime?
  respondedAt      DateTime?
  customerResponse String? // free-text feedback, if any

  createdBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  files       File[]
  comments    Comment[]
  // Phase 11 — structured decision ledger. Replaces the loose audit-log
  // approach for anything proof-related; makes "show me every decision"
  // a single table read.
  decisions   ProofDecision[]
  // Phase 15 — unauthenticated public share links for this proof.
  shareTokens ShareToken[]

  @@unique([orderId, version])
  @@index([tenantId, status])
  @@index([orderId])
}

enum ProofStatus {
  DRAFT // being prepared
  SENT // awaiting customer
  APPROVED // customer signed off
  CHANGES_REQUESTED // needs another version
  REJECTED // customer rejected; requires escalation
}

// Phase 11 — every proof decision (sent, approved, changes requested,
// locked, reopened) gets one row here. Why a dedicated table instead of
// just reading the audit log? Three reasons:
//  1. The audit log is a flat event stream across the whole tenant; a
//     dedicated table lets us load "history of this proof" with one
//     indexed query.
//  2. We want stable, queryable fields (round number, actor kind,
//     customer IP for share-link decisions) that the audit log stores
//     as opaque JSON metadata.
//  3. We render this as a timeline on the proof detail page — it's a
//     first-class UI concept, not just a dev debugging aid.
model ProofDecision {
  id       String @id @default(cuid())
  tenantId String
  proofId  String

  // Which round this decision happened in. Copied off the proof at the
  // moment the decision was made so it stays correct even if we bump
  // the round later. (Otherwise a v1/round-1 decision would "move" into
  // round 3 once the customer sent it back twice.)
  round Int

  decision ProofDecisionKind

  // Exactly one of these should be set. Staff decisions use userId; customer
  // portal/share-link decisions use customerId (or leave both null for
  // anonymous share-link clicks and store the context in metadata.ipHash).
  decidedByUserId     String?
  decidedByCustomerId String?

  notes    String?
  // Free-form metadata for channel-specific context: { via: "portal" | "share" | "staff",
  // tokenId?: string, ipHash?: string, userAgent?: string, previousStatus?: string }.
  metadata Json?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proof  Proof  @relation(fields: [proofId], references: [id], onDelete: Cascade)

  @@index([proofId, createdAt])
  @@index([tenantId, createdAt])
}

enum ProofDecisionKind {
  CREATED // new draft proof spun up
  REVISED // file(s) added or swapped on a proof in progress
  SENT // staff sent to customer
  APPROVED // customer approved
  CHANGES_REQUESTED // customer asked for changes
  REJECTED // customer rejected outright
  LOCKED // staff locked (happens automatically on APPROVED)
  REOPENED // a rejected / changes_requested proof was put back in DRAFT
  SUPERSEDED // a newer proof version took over
}

// ────────────────────────────────────────────────────────────
// Install events — scheduled visits tied to an order
// ────────────────────────────────────────────────────────────

// An install event is a calendar-visible visit: site survey, the install
// itself, or a follow-up service call. Each event has a start + end time,
// a primary assignee (installer), and optional additional crew (userIds).
//
// An order may have many events across its lifecycle (survey → install →
// service). This is intentionally decoupled from Order.status so production
// and scheduling can evolve independently.
model InstallEvent {
  id         String  @id @default(cuid())
  tenantId   String
  orderId    String
  customerId String
  // Phase 15 — branch whose crew runs this visit. Inherits from the order
  // by default; dispatchers can reassign between branches.
  locationId String?

  kind   InstallEventKind   @default(INSTALL)
  title  String? // free-form override; falls back to "Install for {order.number}"
  status InstallEventStatus @default(SCHEDULED)

  scheduledStart DateTime
  scheduledEnd   DateTime
  arrivedAt      DateTime?
  completedAt    DateTime?
  canceledAt     DateTime?
  cancelReason   String?

  // Address snapshot — starts from the customer's install address but users
  // can override per event (some jobs install at a different site).
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  country      String?

  // Primary assignee + extra crew (plain userIds, resolved by memberLookup).
  installerId String?
  crewIds     String[] @default([])

  notes     String?
  createdBy String

  // Phase 13 — logistics + readiness hints captured by dispatch up front.
  // These support the field UI (driving directions, "what to bring") without
  // adding a whole extra table. None are required.
  toolsList          String? // free-form: tools/equipment to bring (bucket truck, ladder, drills…)
  materialsList      String? // free-form: materials to load (hardware pack, channel letters, etc.)
  accessNotes        String? // gate codes, who to ask for, parking, loading dock instructions
  hazardsNotes       String? // overhead lines, sloped roof, traffic, electrical hazards
  // Optional GPS destination — if populated, field mode renders a one-tap map link.
  gpsLat             Float?
  gpsLng             Float?
  // Odometer / mileage captured on the truck. Filled at start + end of day.
  odometerStart      Int?
  odometerEnd        Int?
  // Phase 13 — completion evidence pointers. We also track whether dispatch
  // has explicitly waived evidence (some visits legitimately have neither a
  // signature nor photos — e.g. simple pickups).
  evidenceWaived     Boolean @default(false)
  evidenceWaivedBy   String?
  evidenceWaivedNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order          Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  location       Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  checklistItems ChecklistItem[]
  comments       Comment[]
  // Phase 13 — evidence + field-side records.
  photos         InstallPhoto[]
  signatures     InstallSignature[]
  issues         InstallIssue[]
  siteSurvey     SiteSurvey?

  @@index([tenantId, scheduledStart])
  @@index([tenantId, status, scheduledStart])
  @@index([tenantId, installerId, scheduledStart])
  @@index([tenantId, locationId, scheduledStart])
  @@index([orderId])
}

enum InstallEventKind {
  SURVEY // pre-install site visit / measurement
  INSTALL // main install
  SERVICE // post-install service / warranty visit
  // Phase 13 — final-mile fulfillment. DELIVERY is "drop the sign off";
  // PICKUP is "collect the product from supplier or shop". Both use the
  // same calendar/UX as installs but usually skip the heavy evidence.
  DELIVERY
  PICKUP
}

enum InstallEventStatus {
  SCHEDULED // on the calendar, not confirmed with customer
  CONFIRMED // customer has confirmed
  IN_PROGRESS // crew on site
  COMPLETED // done
  CANCELED // called off
  NO_SHOW // scheduled, nobody there
}

// ────────────────────────────────────────────────────────────
// Phase 13 — field evidence: photos, signatures, issues, site surveys
// ────────────────────────────────────────────────────────────
//
// Why these live next to InstallEvent rather than on Order: a single order
// can produce several events (survey → install → service) and each one
// needs its own paper trail. Pushing photos/signatures up to the order
// would lose that phase-level accountability.
//
// Storage note. We store `url` as an opaque string — it can point at a
// Next.js /api/files/... route, an S3-signed URL, or a data: URL for tiny
// captures (used today for signatures). The app never trusts the URL
// beyond tenant-scoped auth on render; replacing the backing store is an
// implementation detail.

enum InstallPhotoPhase {
  BEFORE // pre-work / site condition
  DURING // progress / during-install
  AFTER // completed / final result
  ISSUE // documentation attached to a reported issue
  SURVEY // measurement / site-survey reference
}

model InstallPhoto {
  id             String  @id @default(cuid())
  tenantId       String
  installEventId String
  // Optional link to an issue — when populated, the photo is evidence for
  // a specific reported problem instead of a general install photo.
  issueId        String?

  url      String
  caption  String?
  phase    InstallPhotoPhase @default(DURING)
  // Dimensions are cached on upload so the gallery can reserve aspect-ratio
  // slots without a round-trip. null = unknown (data-URL signatures etc).
  widthPx  Int?
  heightPx Int?

  capturedBy String // userId of the installer/admin who uploaded
  capturedAt DateTime @default(now())

  createdAt DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  installEvent InstallEvent  @relation(fields: [installEventId], references: [id], onDelete: Cascade)
  issue        InstallIssue? @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([tenantId, installEventId, phase])
  @@index([installEventId, createdAt])
  @@index([issueId])
}

enum InstallSignerRole {
  CUSTOMER // the customer or their on-site representative
  INSTALLER // lead installer / crew chief
  WITNESS // third-party witness (inspector, landlord, etc.)
}

model InstallSignature {
  id             String @id @default(cuid())
  tenantId       String
  installEventId String

  // dataUrl — stored inline. Signatures are small PNGs (<30KB) and the
  // roundtrip-to-S3 dance isn't worth it. Column keeps the whole capture.
  dataUrl     String
  signerName  String
  signerRole  InstallSignerRole @default(CUSTOMER)
  signerTitle String? // "Facilities manager", etc.
  // Disclaimer text the signer agreed to, captured verbatim at sign time
  // so future wording changes don't retroactively alter what was signed.
  disclaimer  String?
  notes       String?

  // Captured metadata — not an audit trail by itself, but useful when a
  // dispute reaches legal.
  capturedBy String // userId that triggered the capture
  capturedAt DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  installEvent InstallEvent @relation(fields: [installEventId], references: [id], onDelete: Cascade)

  @@index([tenantId, installEventId])
  @@index([installEventId, capturedAt])
}

enum InstallIssueSeverity {
  LOW // cosmetic / nice-to-fix later
  MEDIUM // functional problem, not blocking completion
  HIGH // serious, needs same-day response
  BLOCKER // can't finish the job until this is resolved
}

enum InstallIssueStatus {
  OPEN
  ACKNOWLEDGED // office has seen it
  RESOLVED
}

model InstallIssue {
  id             String @id @default(cuid())
  tenantId       String
  installEventId String

  title       String
  description String?
  severity    InstallIssueSeverity @default(MEDIUM)
  status      InstallIssueStatus   @default(OPEN)

  // Reporter is always a crew member (field side). Resolver is typically an
  // admin / production manager closing the loop.
  reportedBy String
  reportedAt DateTime  @default(now())
  ackBy      String?
  ackAt      DateTime?
  resolvedBy String?
  resolvedAt DateTime?
  resolution String?

  // Does the issue block completion? If true, the Complete transition will
  // refuse until the issue resolves (or dispatcher overrides). This is a
  // snapshot of severity=BLOCKER, kept on the row so severity changes don't
  // silently un-block a completed event.
  blocksCompletion Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  installEvent InstallEvent   @relation(fields: [installEventId], references: [id], onDelete: Cascade)
  photos       InstallPhoto[]

  @@index([tenantId, status, severity])
  @@index([installEventId, status])
}

enum PermitStatus {
  NONE // not required
  NEEDED // required but not yet applied
  APPLIED // application submitted
  APPROVED // permit in hand
  REJECTED // application denied
  EXPIRED // permit lapsed
}

model SiteSurvey {
  // One-to-one with a SURVEY-kind InstallEvent. Surveys can also be
  // attached to INSTALL events when the installer takes fresh measurements
  // on arrival ("it didn't match the quote") — the relation is on the
  // InstallEvent so either works, enforced as @unique below.
  id             String @id @default(cuid())
  tenantId       String
  installEventId String @unique

  // Dimensions (mm). Tenant-configured unit display converts on read.
  widthMm  Int?
  heightMm Int?
  depthMm  Int?

  mountingSurface  String? // brick / metal / drywall / existing channel letters / ...
  mountingMethod   String? // lag bolts / welded frame / magnet / ...
  powerAvailable   Boolean @default(false)
  powerNotes       String?
  electricalNotes  String?
  // Access / logistics that didn't fit the InstallEvent fields.
  accessNotes      String?
  // Ceiling/clearance height, sightline observations, parking notes.
  clearanceNotes   String?
  siteContactName  String?
  siteContactPhone String?

  // Permit / code compliance.
  permitStatus     PermitStatus @default(NONE)
  permitNumber     String?
  permitNotes      String?
  permitAppliedAt  DateTime?
  permitApprovedAt DateTime?
  permitExpiresAt  DateTime?

  // Freeform summary the salesperson or installer leaves for the shop.
  summary       String?
  // If the surveyor rejected the job ("site can't support this"), capture why.
  blocked       Boolean @default(false)
  blockedReason String?

  surveyedBy String?
  surveyedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  installEvent InstallEvent @relation(fields: [installEventId], references: [id], onDelete: Cascade)

  @@index([tenantId, permitStatus])
}

// ────────────────────────────────────────────────────────────
// Customer portal — tokenized public access
// ────────────────────────────────────────────────────────────

// A portal token grants a customer contact read (+ limited write) access to
// their own quotes, orders, invoices, proofs, and install schedule via a
// public URL like /portal/<token>. No login required.
//
// Tokens can be revoked or expired; the raw `token` field is the secret shown
// in URLs. We store it plainly because it's a long random cuid(2) — treat like
// an unguessable capability. A future phase can layer email magic links over
// this (email the token-URL instead of showing it in the app).
model PortalToken {
  id         String @id @default(cuid())
  tenantId   String
  customerId String

  token      String    @unique @default(cuid())
  label      String? // user-facing note, e.g. "Jane @ ACME"
  createdBy  String // staff userId who issued it
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
}

// ────────────────────────────────────────────────────────────
// Phase 15 — Public share tokens (proof / invoice)
// ────────────────────────────────────────────────────────────
//
// A ShareToken grants *unauthenticated* read access (and, for proofs,
// the ability to respond) to a single proof or invoice via a public URL
// like /share/<token>. It sits next to the existing quote `shareToken`
// column — proofs and invoices didn't have an equivalent and Phase 15
// calls for "shared links for quotes/proofs/invoices; expiring secure
// links where appropriate".
//
// Design choices:
//   • One model with two nullable FKs (proofId / invoiceId) rather than
//     a polymorphic `(kind, targetId)` pair, because we want Prisma's
//     onDelete: Cascade to free dangling tokens when the underlying
//     entity is deleted. The `kind` enum is kept as a sanity check and
//     to make listing "all share links" trivial.
//   • Not linked to Customer or PortalToken: the point of a share link
//     is that it can be forwarded to an approver who isn't in our
//     system. Audit logs record "share" as the actor.
//   • `viewCount` is an append-only counter; the staff UI surfaces it
//     so shop owners can see when a shared invoice was actually opened
//     (useful signal for collections follow-up).
//   • Tokens are long random cuids; no hashing — capability-based like
//     PortalToken.
model ShareToken {
  id       String @id @default(cuid())
  tenantId String

  token String         @unique @default(cuid())
  kind  ShareTokenKind

  // Exactly one of these is set, matching `kind`.
  proofId   String?
  invoiceId String?

  label      String? // staff-facing note, e.g. "Sent to Jane 2026-04-18"
  createdBy  String // staff userId who issued it
  expiresAt  DateTime?
  revokedAt  DateTime?
  revokedBy  String?
  lastUsedAt DateTime?
  viewCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proof   Proof?   @relation(fields: [proofId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind])
  @@index([tenantId, proofId])
  @@index([tenantId, invoiceId])
}

enum ShareTokenKind {
  PROOF
  INVOICE
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  // Page 8 — when an action runs while an impersonation cookie is
  // active, the action layer stamps this with the active session id
  // so the Impersonation Sessions detail drawer can pull a
  // chronological timeline without sifting through every audit row.
  impersonationSessionId String?
  impersonationSession ImpersonationSession? @relation("AuditLogImpersonation", fields: [impersonationSessionId], references: [id], onDelete: SetNull)

  // ── Page 14 (Audit Log) — extended forensics columns ──────────
  /** "INFO" / "WARNING" / "CRITICAL". Critical = destructive or
   *  permission changes; warning = failed write attempts; info =
   *  everything else. */
  severity     AuditSeverity @default(INFO)
  /** Whether the underlying action succeeded. Failed writes still
   *  emit an audit row so brute-force attempts are visible. */
  success      Boolean       @default(true)
  /** "WEB" / "API" / "CLI" / "SYSTEM". */
  source       AuditSource   @default(WEB)
  /** Correlates a chain of related events (multi-step flow,
   *  background-job fanout, retry storm). Free-form opaque cuid the
   *  caller chooses. */
  correlationId String?
  /** Per-request id for tracing through the request log. */
  requestId    String?
  /** NextAuth session id (or platform-staff session-version stamp). */
  sessionId    String?
  /** Whether MFA was active when the action ran. */
  mfaUsed      Boolean?

  // ── Tamper-evidence chain ─────────────────────────────────────
  /** SHA-256 over (id, action, entityType, entityId, userId, tenantId,
   *  createdAt, prevHash, metadata) — populated at insert by
   *  logPlatformAudit. Not enforced at the DB level (would require a
   *  trigger); the verify endpoint replays the chain. */
  hash      String?
  /** Hash of the immediately-preceding row (or null for the first).
   *  Lets the verifier detect insertion + edit + delete tampering. */
  prevHash  String?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([impersonationSessionId, createdAt])
  @@index([severity, createdAt])
  @@index([correlationId])
  @@index([action, createdAt])
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AuditSource {
  WEB
  API
  CLI
  SYSTEM
}

// Page 14 §Webhook subscription. Platform-side subscribers that
// receive an HMAC-signed POST for each matching audit row. The
// per-row delivery happens on a 5-minute cron — we don't fire
// inline because audit logging must stay fast + non-blocking.
model AuditWebhookSubscription {
  id            String   @id @default(cuid())
  name          String
  url           String
  /** Signing secret — HMAC-SHA256 over the raw payload. Never
   *  surfaced again after creation; admins must revoke + recreate
   *  to rotate. */
  secret        String
  /** Comma-separated action keys (e.g. "tenant.archived,user.banned")
   *  or "*" to receive everything. */
  actionFilter  String   @default("*")
  /** Minimum severity to include — INFO ships everything. */
  minSeverity   AuditSeverity @default(INFO)
  active        Boolean  @default(true)

  /** Aggregates updated by the delivery cron. */
  totalDelivered    Int       @default(0)
  totalFailed       Int       @default(0)
  lastDeliveredAt   DateTime?
  lastFailureAt     DateTime?
  lastFailureReason String?

  createdAt DateTime @default(now())
  createdBy String

  deliveries AuditWebhookDelivery[]

  @@index([active])
}

model AuditWebhookDelivery {
  id             String   @id @default(cuid())
  subscriptionId String
  auditId        String
  /** HTTP status returned by the destination. */
  responseStatus Int?
  /** First 512 chars of the response body — useful for debugging. */
  responseBody   String?
  /** When the request was attempted. */
  attemptedAt    DateTime @default(now())
  succeeded      Boolean  @default(false)
  /** Number of retries already burned. */
  attempt        Int      @default(1)

  subscription AuditWebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, attemptedAt])
  @@index([auditId])
}

// Page 14 §Retention configuration. Singleton + per-event overrides.
// Stored as JSON because adding a new audit-action key shouldn't
// require a schema migration.
model AuditRetentionPolicy {
  id           String   @id @default("default")
  /** Default retention in days. 7 years = 2555 days. */
  defaultDays  Int      @default(2555)
  /** JSON map: { [actionKey]: number } — per-event overrides. */
  overrides    Json?
  /** When true, the retention cron is paused entirely — used during
   *  legal holds. */
  legalHold    Boolean  @default(false)

  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Phase 17 Slice C — feature flags.
//
// Two-layer model:
//   - PLAN_ENTITLEMENTS (in code, see lib/entitlements.ts) controls what
//     each billing plan gets. Static — shipped with the app, predictable,
//     no DB round trip.
//   - FeatureFlag rows (this table) let platform staff override the
//     entitlement for a single tenant (e.g. "give this customer the beta
//     proof annotations even though they're on STARTER") or flip a beta
//     default for every tenant (tenantId = null).
//
// Lookup order in `isEntitled`:
//   1. per-tenant override (tenantId = :id, key = :key) — wins if present
//   2. global override       (tenantId = null, key = :key)                 — fallback
//   3. PLAN_ENTITLEMENTS[plan][key]                                         — default
model FeatureFlag {
  id        String  @id @default(cuid())
  key       String
  tenantId  String? // null = global default / beta-wide override
  enabled   Boolean @default(false)
  note      String? // free-form context for platform staff
  updatedBy String? // platform user id who last touched this row

  // Partial-rollout percentage (0–100). When set, isEntitled() should
  // hash the tenant id + key and bucket — but for now this is metadata
  // only; the existing entitlements resolver still treats `enabled` as
  // the final answer. Populated as we plumb it through.
  rolloutPct Int?

  // Optional auto-expire — when set, the override is treated as
  // not-set after this timestamp. Useful for time-boxed beta access
  // that should clean itself up without a cron.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, tenantId])
  @@index([tenantId])
  @@index([key])
  @@index([expiresAt])
}

// Phase 17 Slice B — auditable platform-staff impersonation.
//
// A row is created when platform staff click "Sign in as" from a tenant's
// detail page, and stamped with `endedAt` when they stop (either by
// clicking the banner "Stop" or by manually landing on the stop action).
// Every row is append-only after `endedAt` is set — this table is the
// forensic record of who had the keys to which shop and when.
//
// A cookie (`ts_imp`) holds the row id for the browser. The banner in
// /t/[slug]/layout.tsx reads it on every render to show the "you are
// impersonating" bar. If the cookie references a row that's missing or
// already ended, the banner stays hidden and no special privileges apply
// (platform staff still have synthetic ADMIN via requireTenant — the
// session is additive bookkeeping, not a privilege grant).
model ImpersonationSession {
  id             String    @id @default(cuid())
  platformUserId String
  tenantId       String
  reason         String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  // ── Page 8 (Impersonation Sessions) — extended context ──────
  // Categorical reason — required when ImpersonationSettings.reasonRequired
  // is true (which is the default). The free-text `reason` stays for the
  // "what specifically" detail.
  categoryCode        ImpersonationCategory @default(OTHER)
  // Admin's stated expected duration in minutes. Used by the cron to
  // close sessions that drift well past the estimate, and surfaced in
  // the History tab so we can spot habitual under-estimators.
  expectedDurationMin Int?
  // How the session ended. Null until endedAt is stamped.
  endedReason         ImpersonationEndReason?
  // Force-ended by — different admin that pulled the plug for compliance.
  // Null when the impersonator ended their own session.
  endedById           String?
  // Optional approver — set when ImpersonationSettings.approvalRequired.
  approvedById        String?
  approvedAt          DateTime?
  // Captured at session-start for the "Started · IP · UA" history row.
  ip                  String?
  userAgent           String?
  // Cached count of audit-log rows tagged with this session id. Saves
  // the History tab from a count(*) per row.
  actionsCount        Int @default(0)
  // Free-form running notes the admin can append while impersonating.
  notes               String?
  // Updated by the audit middleware whenever the impersonator does
  // anything; cron uses it for the idle-timeout sweep.
  lastActivityAt      DateTime?

  // Audit-log rows produced under this session. Set via the
  // impersonationSessionId field on AuditLog when the impersonation
  // cookie is present.
  actionLogs AuditLog[] @relation("AuditLogImpersonation")

  @@index([platformUserId, endedAt])
  @@index([tenantId, endedAt])
  @@index([endedAt])
}

enum ImpersonationCategory {
  SUPPORT_INVESTIGATION
  CUSTOMER_REQUESTED_FIX
  BUG_REPRO
  ONBOARDING_ASSIST
  COMPLIANCE_AUDIT
  OTHER
}

enum ImpersonationEndReason {
  /** Admin clicked "End impersonation" themselves. */
  COMPLETED
  /** Another admin force-ended via the Active tab. */
  FORCE_ENDED
  /** Cron auto-closed because it passed maxDurationMin. */
  EXPIRED
  /** Cron auto-closed because lastActivityAt drifted past idleTimeoutMin. */
  IDLE_TIMEOUT
}

// Page 8 §Compliance settings — singleton row keyed by id="default".
// Lazy-seeded by loadImpersonationSettings() so the page reads a
// guaranteed-populated record.
model ImpersonationSettings {
  id String @id @default("default")

  /** Hard cap for any impersonation session. Cron force-ends past this. */
  maxDurationMin     Int @default(60)
  /** Idle timeout before auto-end. */
  idleTimeoutMin     Int @default(15)
  /** When true, the start-impersonation modal requires the free-text
   *  reason in addition to the category. Default true (per spec). */
  reasonRequired     Boolean @default(true)
  /** When true, the start-impersonation modal blocks until an admin
   *  in `approverIds` has clicked Approve. */
  approvalRequired   Boolean @default(false)
  /** User ids of designated approvers. */
  approverIds        String[] @default([])
  /** Banner copy override — null = use the spec default. */
  bannerCopy         String?
  /** Days to keep audit-log + session rows for compliance. The cron
   *  prunes anything older than ended_at + this. */
  recordingRetentionDays Int @default(90)
  /** When true, the impersonator's role drops to read-only — every
   *  mutating action is short-circuited at the action layer. */
  auditOnlyMode      Boolean @default(false)
  /** Action keys the impersonator cannot perform even when
   *  auditOnlyMode is false. Free-form audit-action strings — checked
   *  before each mutating server action runs. */
  disabledActions    String[] @default([])

  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Phase 17 Slice D — in-app support ticket thread.
//
// Every ticket is owned by a tenant; both sides (tenant staff + platform
// staff) post messages on it. Keep the model deliberately narrow — no
// attachments, no tags, no SLAs — because a "good enough" channel inside
// the product is much better than nothing, and we can grow it when real
// volume shows up.
//
// `assignedTo` references a User.id with a non-null platformRole, but we
// don't enforce that at the schema level; the action layer validates.
model SupportTicket {
  id       String                @id @default(cuid())
  tenantId String
  subject  String
  category SupportTicketCategory @default(QUESTION)
  // Page 3 §Bug Volume by Module — fine-grained module tag set at
  // ticket creation. Defaults to OTHER for legacy rows / when the
  // form picker didn't fire. Surfaced in the support form's module
  // dropdown and grouped by the Bug Volume by Module report.
  module   SupportTicketModule   @default(OTHER)
  priority SupportTicketPriority @default(NORMAL)
  status   SupportTicketStatus   @default(OPEN)

  // Tenant user who opened it. Left nullable so a ticket survives a
  // member being removed — the body is still useful to platform staff.
  openedByUserId String?
  // Platform user currently on the hook for responding. Null = triage queue.
  assignedTo     String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  closedAt   DateTime?

  // Phase 20 Slice C — SLA tracking. `dueBy` is the deadline for the next
  // platform response (computed from priority at open time and refreshed
  // whenever the customer replies). `firstStaffReplyAt` is stamped on the
  // first non-internal staff message — this is the "time to first response"
  // metric platform leadership cares about.
  dueBy             DateTime?
  firstStaffReplyAt DateTime?

  // Phase 20 Slice E — post-resolution satisfaction rating. Optional 1–5
  // star rating supplied by any tenant member after the ticket is
  // resolved/closed. `ratedByUserId` is stored so we don't double-count if
  // the same user re-submits, and so platform staff can see who rated.
  satisfactionRating  Int? // 1..5
  satisfactionComment String?
  satisfactionAt      DateTime?
  ratedByUserId       String?

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages SupportTicketMessage[]

  @@index([tenantId, status])
  @@index([assignedTo, status])
  @@index([status, updatedAt])
  @@index([status, dueBy])
}

// One post on a support ticket. `isStaff` tells the UI which side of the
// conversation drew it (platform vs. tenant) — cheaper than joining to
// User.platformRole on every render.
model SupportTicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String? // nullable = system-generated / deleted user
  isStaff   Boolean // true = written by platform staff
  // Phase 20 — internal staff notes. `internal=true` rows are visible only
  // to platform staff; tenant pages filter them out. Always isStaff=true
  // when internal=true — we don't expose a "tenant-only hidden" concept.
  internal  Boolean  @default(false)
  body      String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

enum SupportTicketCategory {
  BILLING
  BUG
  FEATURE_REQUEST
  QUESTION
  OTHER
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

// Phase 20 Slice D — platform-wide library of canned replies for the
// support team. Not tenant-scoped: these are owned by Flowtora staff and
// offered as a dropdown on the reply form. Body is a plain string —
// variable interpolation is handled client-side so tenants never see the
// raw template.
model SupportCannedReply {
  id         String                 @id @default(cuid())
  title      String // shown in the picker — "Request more details", etc.
  body       String // plain text; supports {{tenantName}} + {{ticketSubject}}
  category   SupportTicketCategory? // optional filter so BILLING-only canned replies don't clutter BUG tickets
  createdBy  String // User.id of platform admin who authored it
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  archivedAt DateTime? // soft delete — templates may have been used historically

  @@index([archivedAt, title])
  @@index([category, archivedAt])
}

// Phase 17 Slice E — data portability and right-to-be-forgotten.
//
// GDPR / CCPA surface area: a tenant owner can request a full export of
// their data (delivered as a JSON bundle), and can request account
// deletion with a cooling-off period. Both flows are tenant-initiated but
// platform-staff visible, with audit trails on every transition.

model DataExportRequest {
  id           String           @id @default(cuid())
  tenantId     String
  requestedBy  String // User.id of the owner who clicked "Export my data"
  status       DataExportStatus @default(PENDING)
  // Populated when a platform user runs the export. Kept as JSON text so
  // we don't need a file-storage backend just to support this flow — the
  // tenant downloads it directly from a signed route.
  payload      String? // Stringified JSON bundle of every tenant-scoped row
  errorMessage String?
  expiresAt    DateTime? // Download link invalidated after this date
  createdAt    DateTime         @default(now())
  completedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([status, createdAt])
}

enum DataExportStatus {
  PENDING // Requested; awaiting platform-staff generation
  PROCESSING // A staff member has picked it up
  COMPLETED // Payload ready; tenant can download
  FAILED // Generation errored — errorMessage explains
  EXPIRED // Past expiresAt; payload blanked to reclaim space
}

// Tenant-initiated account deletion. Always flows through a cooling-off
// window (default 30 days) so an accidental click doesn't nuke a real
// shop. Only one active request per tenant — unique constraint on
// tenantId when status is SCHEDULED is enforced in app code (Prisma
// doesn't do partial unique indexes as a native declaration).
model AccountDeletionRequest {
  id           String                @id @default(cuid())
  tenantId     String
  requestedBy  String // User.id who initiated
  reason       String? // Optional — "moving to a competitor", "shutting down"
  scheduledFor DateTime // createdAt + 30d by default
  status       AccountDeletionStatus @default(SCHEDULED)
  canceledBy   String? // User.id who canceled (either tenant or platform)
  canceledAt   DateTime?
  completedBy  String? // Platform user who executed the deletion
  completedAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([status, scheduledFor])
}

enum AccountDeletionStatus {
  SCHEDULED // Grace period active; tenant can cancel
  CANCELED // Request withdrawn
  COMPLETED // Deletion executed
}

// In-app notifications — per-user inbox items generated as side effects of
// mutations (portal responses, task assignment, payments, installs, etc).
//
// Created via `notify()`, which is wrapped in try/catch just like `logAudit`
// so a notification failure can never kill a user-facing request.
//
// `type` is a flat string (e.g. "portal.quote_approved") — easy to add new
// kinds without migrations. `link` is a denormalized relative URL to the
// target entity, so the inbox page can render links without rejoining.
model Notification {
  id       String @id @default(cuid())
  tenantId String
  userId   String // staff recipient (never a customer)

  type  String
  title String
  body  String?

  entityType String?
  entityId   String?
  link       String? // relative path, e.g. "/t/slug/quotes/abc"

  readAt DateTime?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt])
  @@index([tenantId, userId, createdAt])
}

// ────────────────────────────────────────────────────────────
// Phase 22 — Approval requests
// ────────────────────────────────────────────────────────────
//
// A durable record for "someone needs a manager to OK this before it moves
// forward". Today only used for quote send gates (discount/large-job
// thresholds tripped → pending approval); the shape is generic so future
// rules (big refunds, manual write-offs, high-deposit waivers) can reuse it
// without another migration.
//
// We keep `entityType` / `entityId` as scalars (no discriminated relation)
// so adding a new approvable kind is pure app-level work. `reason` is a
// human-readable sentence the requester's gate produced — renders verbatim
// in the approver's inbox.
model ApprovalRequest {
  id         String                @id @default(cuid())
  tenantId   String
  entityType String // "Quote" today; future: "Refund", "WriteOff", etc.
  entityId   String
  reason     String // rendered directly in the approver inbox
  status     ApprovalRequestStatus @default(PENDING)

  requestedById String // userId who tripped the gate
  decidedById   String? // userId who approved/rejected
  decidedAt     DateTime?
  decisionNote  String? // optional approver note (shown in audit + notification body)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, entityType, entityId])
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

// ────────────────────────────────────────────────────────────
// Phase 12 — Production management: departments, work stations, stages,
// defects, material usage.
// ────────────────────────────────────────────────────────────
//
// The mental model: an Order is the customer-facing deliverable; a
// ProductionStage is a unit of work done in a department on a specific
// machine by a specific person. Orders move through the shop as a chain
// of stages (print → cut → laminate → finish → package → ready-for-install).
//
// Why this shape, and not per-OrderItem production?
//   1. Stages cross line-item boundaries: a single "Laminate" stage often
//      finishes five different banners from the same order in one pass.
//   2. A stage's department is the axis the shop floor filters/groups on —
//      "what's in the CNC queue?" is the daily question.
//   3. Keeping stages at the order level keeps the rollup trivial:
//      order.isReady = all stages DONE (or explicitly SKIPPED).
//
// Tenants seed their own department list the first time they hit the
// production settings page. No global default seed — a screen printer's
// "Vinyl" is a print shop's "Digital Vinyl" is a sign shop's "Vinyl Cut",
// and the naming matters for the team reading their shop-floor screen.

model Department {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  // slug is derived from name at create-time; we use it in URLs and for
  // dedup in-tenant. Human name can change freely; slug is stable.
  slug      String
  // A hex color the board uses for the swimlane headers + stage chips.
  color     String  @default("#6b7280")
  // Optional emoji/icon — keeps the board readable at a glance, especially
  // on a ceiling-mounted shop-floor screen.
  icon      String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workStations WorkStation[]
  stages       ProductionStage[]

  @@unique([tenantId, slug])
  @@index([tenantId, active, sortOrder])
}

// Work stations are the physical machines / benches within a department.
// Optional — tenants can leave every stage unassigned to a specific
// machine. Useful when a department has multiple concurrent pieces of
// equipment (two Rolands, a laser, a CNC) and scheduling matters.
model WorkStation {
  id           String  @id @default(cuid())
  tenantId     String
  departmentId String
  name         String
  slug         String
  notes        String?
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  stages     ProductionStage[]

  @@unique([tenantId, slug])
  @@index([departmentId, active])
}

enum ProductionStageStatus {
  PENDING // queued, waiting for a technician / upstream work
  ACTIVE // someone is physically working on it right now
  BLOCKED // can't run (missing material, proof not locked, machine down)
  DONE // finished
  SKIPPED // not applicable for this order (e.g. no laminate needed)
}

model ProductionStage {
  id       String @id @default(cuid())
  tenantId String
  orderId  String

  // The department handling this stage. Nullable so you can drop an
  // ad-hoc "rework" stage onto an order without forcing a department.
  // The board UI groups a stage under "Unassigned" in that case.
  departmentId  String?
  // Optional machine/bench. Null = any machine in the dept is fine.
  workStationId String?

  // Short designer/shop title. Different from the department name —
  // "Laser-cut acrylic letters" is the stage title; "CNC" is the department.
  title       String
  description String?

  status ProductionStageStatus @default(PENDING)

  // Assignee (userId). Null = anyone in the dept can pick it up.
  assigneeId String?

  // Position within the order's stage sequence. The next-stage button uses
  // this to advance. Ties are allowed (parallel work).
  sortOrder        Int       @default(0)
  estimatedMinutes Int?
  // Stage-level due date. Falls back to the order's dueDate when null.
  dueAt            DateTime?

  // Lifecycle stamps.
  startedAt     DateTime?
  completedAt   DateTime?
  blockedAt     DateTime?
  blockedReason String?

  // Running-clock support: we stamp startedBy/completedBy so the audit
  // log can attribute work even after the assignee reassigns.
  startedBy   String?
  completedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  workStation WorkStation? @relation(fields: [workStationId], references: [id], onDelete: SetNull)

  defectReports  DefectReport[]
  materialUsages MaterialUsage[]

  @@index([tenantId, status])
  @@index([orderId, sortOrder])
  @@index([departmentId, status])
  @@index([tenantId, dueAt])
  @@index([tenantId, assigneeId, status])
}

enum DefectSeverity {
  MINOR // cosmetic, no rework needed
  MAJOR // rework required
  CRITICAL // scrap + restart
}

// Defect reports log quality issues discovered during or after production.
// A MINOR defect is "we noticed a hairline scratch — called it out".
// A MAJOR defect triggers rework (the ORDER shouldn't leave the shop).
// A CRITICAL defect scraps the piece and may need the order to revisit
// an earlier stage entirely.
model DefectReport {
  id       String  @id @default(cuid())
  tenantId String
  orderId  String
  stageId  String?

  severity DefectSeverity @default(MINOR)
  cause    String? // "wrong ink", "misaligned cut", "peel-off after laminate"
  notes    String

  reportedBy String
  resolvedAt DateTime?
  resolvedBy String?
  resolution String? // what we did about it

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage  ProductionStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@index([tenantId, resolvedAt])
  @@index([orderId])
  @@index([stageId])
}

// Light inventory / material usage. We're not building a full inventory
// system here — tenants can plug their accounting tool in for that. What
// we DO give them is the ability to record "this order used 12ft of 3M
// Scotchcal vinyl with 8% waste" so job-costing + material reorder
// reports have real data to work with.
model MaterialUsage {
  id       String  @id @default(cuid())
  tenantId String
  orderId  String
  stageId  String?

  material String // freeform for now — a lookup table lands in the inventory phase
  quantity Decimal @db.Decimal(12, 3)
  unit     String // "ft", "sqft", "sheet", "roll", "each"
  // Waste percentage is an optional self-reported number. Shops with good
  // material discipline log it; shops that don't can leave it null.
  wastePct Int?
  notes    String?

  loggedBy  String
  createdAt DateTime @default(now())

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage  ProductionStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([orderId])
  @@index([stageId])
}

// ────────────────────────────────────────────────────────────
// Phase 13 — Checklist templates (production & install)
// ────────────────────────────────────────────────────────────
//
// Reusable checklists a shop configures once and applies to orders/installs.
// The template's items are *copied* onto the target (ChecklistItem) at
// apply-time so later edits to the template don't retroactively mutate jobs
// already in progress. Same snapshot discipline used for quote/order items.

enum ChecklistKind {
  ORDER // production checklist applied to an Order
  INSTALL // install checklist applied to an InstallEvent
}

model ChecklistTemplate {
  id       String        @id @default(cuid())
  tenantId String
  name     String
  kind     ChecklistKind
  active   Boolean       @default(true)

  // Phase 15 Slice D — group-shared template. See Product.shared for semantics.
  shared Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  ChecklistTemplateItem[]

  @@index([tenantId, kind, active])
}

model ChecklistTemplateItem {
  id          String  @id @default(cuid())
  templateId  String
  title       String
  description String?
  sortOrder   Int     @default(0)

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

// A single actionable checklist entry attached to either an Order (production)
// or an InstallEvent (install). Exactly one parent is set — enforced in code.
// Items can come from a template (templateId set) or be added ad-hoc.
model ChecklistItem {
  id             String  @id @default(cuid())
  tenantId       String
  orderId        String?
  installEventId String?
  templateId     String? // nullable — tracks the template it came from, if any

  title       String
  description String?
  sortOrder   Int     @default(0)

  completedAt DateTime?
  completedBy String?

  createdAt DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  installEvent InstallEvent? @relation(fields: [installEventId], references: [id], onDelete: Cascade)

  @@index([orderId, sortOrder])
  @@index([installEventId, sortOrder])
  @@index([tenantId])
}

// ────────────────────────────────────────────────────────────
// Phase 14 — Communication Center
// ────────────────────────────────────────────────────────────
//
// Threaded internal comments attached to any of the business-object "parents"
// staff work against every day. At most ONE parent should be set per comment —
// we enforce that in the server action, not the DB (mirrors how `File` does it
// so we don't end up with six mutually-exclusive CHECK constraints).
//
// `mentionedUserIds` is populated by the action that parses @mentions out of
// `body` — keeping it denormalized means we can render "mentions of me" feeds
// without re-parsing every comment in the system. Comment bodies are markdown-
// lite (plain text + @user tokens); no rich formatting yet.

model Comment {
  id       String @id @default(cuid())
  tenantId String
  authorId String // userId who wrote it (always a staff member)

  body             String
  mentionedUserIds String[] @default([]) // denormalized from body parser

  // Parent — at most one should be set. Validated in the action layer.
  customerId     String?
  quoteId        String?
  orderId        String?
  proofId        String?
  installEventId String?
  taskId         String?

  // Soft-delete so threads keep their shape after a staff removal;
  // author can hard-edit their own comment (we just mutate `body`).
  editedAt  DateTime?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quote        Quote?        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  proof        Proof?        @relation(fields: [proofId], references: [id], onDelete: Cascade)
  installEvent InstallEvent? @relation(fields: [installEventId], references: [id], onDelete: Cascade)
  task         Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([customerId, createdAt])
  @@index([quoteId, createdAt])
  @@index([orderId, createdAt])
  @@index([proofId, createdAt])
  @@index([installEventId, createdAt])
  @@index([taskId, createdAt])
}

// ────────────────────────────────────────────────────────────
// Phase 14 — EmailEvent log
// ────────────────────────────────────────────────────────────
//
// Every customer-facing email the system sends (or would have sent) is
// logged here. Phase 16 will wire a real email provider — until then the
// app *records intent* so the communication timeline stays accurate:
// clicking "Send quote" stamps a SENT_AT on the quote AND drops an event
// here.
//
// Deliverability fields (`openedAt`, `clickedAt`, `failedAt`, `provider`,
// `providerId`) are present now so upgrading to a real provider is a
// one-line config change, not a migration.

model EmailEvent {
  id       String @id @default(cuid())
  tenantId String

  // Optional foreign keys — a single event can belong to a customer and
  // optionally also reference a specific business object (quote, order,
  // invoice, proof, portal token). Nullable so generic tenant-wide comms
  // have somewhere to live too.
  customerId   String?
  senderUserId String?

  relatedEntityType String?
  relatedEntityId   String?

  kind      EmailEventKind
  direction EmailDirection @default(OUTBOUND)

  toAddress   String
  fromAddress String?
  subject     String?
  bodyPreview String? // first ~500 chars for the timeline render

  // Provider wiring — unused until Phase 16 integrations.
  provider   String?
  providerId String?

  sentAt     DateTime  @default(now())
  openedAt   DateTime?
  clickedAt  DateTime?
  failedAt   DateTime?
  failReason String?

  createdAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId, sentAt])
  @@index([customerId, sentAt])
  @@index([relatedEntityType, relatedEntityId])
}

enum EmailEventKind {
  QUOTE_SENT
  PROOF_SENT
  INVOICE_SENT
  PAYMENT_RECEIPT
  PORTAL_INVITE
  UPDATE_MESSAGE // customer update blast / template send (Slice D)
  REMINDER // dunning / follow-up
  GENERIC
}

enum EmailDirection {
  OUTBOUND // we sent it (or would have)
  INBOUND // recorded reply — Phase 14 advanced-later
}

// ────────────────────────────────────────────────────────────
// Phase 14 Slice D — MessageTemplate.
//
// Reusable email bodies for customer updates. Subject + body both accept
// `{{path.to.field}}` placeholders resolved at send-time against a bag of
// entities (customer, quote, order, etc.). We keep templates lightweight on
// purpose — each shop can craft a handful of canned messages, not a full
// marketing automation suite.
// ────────────────────────────────────────────────────────────

model MessageTemplate {
  id       String @id @default(cuid())
  tenantId String

  name        String // internal label, e.g. "Ready for pickup"
  description String? // help text for the sender
  kind        MessageTemplateKind // which flows this template appears in
  subject     String
  body        String // plain text with {{placeholders}}
  active      Boolean             @default(true)

  // Phase 15 Slice D — group-shared template. See Product.shared for semantics.
  shared Boolean @default(false)

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, kind])
  @@index([tenantId, active])
}

enum MessageTemplateKind {
  CUSTOMER_UPDATE // generic customer-level message
  QUOTE_UPDATE // sendable from a quote detail page
  ORDER_UPDATE // sendable from an order detail page
  INSTALL_UPDATE // sendable from an install event
}

// ────────────────────────────────────────────────────────────
// Phase 18 Slice H — beta product feedback
// ────────────────────────────────────────────────────────────
//
// Captured directly from the app shell so we get the tenant, the user, and
// what page they were on when they sent it. Intentionally tenant-scoped
// (not cross-tenant) so nothing leaks between shops; platform staff can
// still aggregate at the DB level if needed.

model Feedback {
  id       String       @id @default(cuid())
  tenantId String
  userId   String // submitter — the tenant member, not the customer
  kind     FeedbackKind @default(IDEA)
  rating   Int? // 1-5, optional — a quick "how's it going" score
  summary  String // one-line headline
  body     String? // optional longer write-up
  context  String? // path the user was on when they opened the form

  // Triage / roadmap state — every submission starts NEW. Platform PM
  // moves it through UNDER_REVIEW → PLANNED → IN_PROGRESS → SHIPPED, or
  // closes it out via REJECTED with a public note explaining why.
  status FeedbackStatus @default(NEW)

  // Public-facing note shown when status is SHIPPED or REJECTED — gives
  // the submitter closure ("here's what we shipped" or "not doing it
  // because…"). Internal notes are separate.
  resolutionNote String?

  // Admin-only annotation. Never shown to tenants. Use for triage
  // hand-offs or PM context.
  internalNotes String?

  // Cached vote count — denormalized so the board can sort by demand
  // without an aggregation per row. Kept in sync by toggleFeedbackVote.
  voteCount Int @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Stamped when status flips to SHIPPED. Drives the "Recently shipped"
  // roadmap strip and conversion-rate KPI.
  shippedAt   DateTime?

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  votes    FeedbackVote[]
  comments FeedbackComment[]

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@index([voteCount])
}

enum FeedbackKind {
  IDEA
  BUG
  PRAISE
  OTHER
}

// ────────────────────────────────────────────────────────────
// Platform announcements — release notes, maintenance windows,
// incidents, pricing changes, broadcasts of any kind. One row per
// communication; no per-tenant dismissal tracking in v1 (the tenant-
// side banner stores dismissals in localStorage).
// ────────────────────────────────────────────────────────────

enum AnnouncementType {
  RELEASE          // shipped a feature
  NEW_FEATURE      // newly available capability
  MAINTENANCE      // scheduled maintenance window
  INCIDENT         // active or recent outage
  PRICING          // pricing / policy / billing change
  GENERAL          // catch-all for one-offs
}

enum AnnouncementPriority {
  INFO
  IMPORTANT
  CRITICAL
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum AnnouncementAudience {
  ALL
  PLAN
  COHORT
  TENANT
}

// Singleton row that holds platform-wide operational state. Only one
// row exists, with a fixed id so reads + upserts stay simple.
model PlatformSetting {
  id String @id @default("singleton")

  // ── Maintenance mode ──
  // When ON, every tenant route redirects to /maintenance. Platform
  // staff bypass via their platformRole. The message is shown on the
  // /maintenance page.
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String?

  // ── Feature freeze ──
  // Advisory flag — does NOT block writes. Surfaces a banner everywhere
  // admins land so the team knows not to ship more changes during a
  // release window.
  featureFreezeMode    Boolean @default(false)
  featureFreezeReason  String?

  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model PlatformAnnouncement {
  id    String @id @default(cuid())
  title String
  // Plain or markdown — rendered with whitespace-pre-wrap on the
  // tenant-side banner; full markdown rendering can come later.
  body String @default("")

  type     AnnouncementType     @default(GENERAL)
  priority AnnouncementPriority @default(INFO)
  status   AnnouncementStatus   @default(DRAFT)

  // ── Targeting ──
  // Audience selector + parallel arrays. ALL ignores everything else.
  // PLAN  matches if tenant.plan ∈ audiencePlans.
  // COHORT matches if tenant.betaCohort ∈ audienceCohorts.
  // TENANT matches if tenant.id ∈ audienceTenantIds.
  audience          AnnouncementAudience @default(ALL)
  audiencePlans     String[]             @default([])
  audienceCohorts   String[]             @default([])
  audienceTenantIds String[]             @default([])

  // ── Scheduling ──
  // SCHEDULED rows go live when publishAt <= now(). expireAt makes a
  // row stop appearing without flipping it to ARCHIVED — useful for
  // maintenance windows that auto-clear.
  publishAt   DateTime?
  expireAt    DateTime?
  publishedAt DateTime? // moment it actually went live; sort key

  // Optional tags shown as small chips, free-form.
  tags String[] @default([])

  // Author audit — platform staff user id; nullable for system-created
  // rows we may add later (e.g. auto-generated incident posts).
  authorId String?

  // ── Email fan-out tracking ──
  // Stamped when the admin clicks "Email matching tenants". Re-clicks
  // re-send (admin's call); we keep the most-recent stamp + the count
  // from the most recent send for the analytics panel.
  emailedAt              DateTime?
  emailedRecipientCount  Int       @default(0)

  views PlatformAnnouncementView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([type, status])
  @@index([publishAt])
}

// Per-user view + dismissal tracking for PlatformAnnouncement. One row
// per (announcementId, userId). seenAt is set when the banner first
// renders for that user; dismissedAt is set when the user clicks the
// X. Distinct from a notification table — these are passive impression
// records, not actionable items.
model PlatformAnnouncementView {
  id             String    @id @default(cuid())
  announcementId String
  userId         String
  tenantId       String
  seenAt         DateTime  @default(now())
  dismissedAt    DateTime?

  announcement PlatformAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([tenantId])
  @@index([userId])
}

enum FeedbackStatus {
  NEW
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  SHIPPED
  REJECTED
}

// Per-user upvote for a Feedback row. One row per (feedbackId, userId)
// — Postgres enforces uniqueness via the @@unique constraint, so the
// vote toggle can't double-count even under concurrent submission.
model FeedbackVote {
  id         String   @id @default(cuid())
  feedbackId String
  userId     String
  tenantId   String // duplicated for fast cross-tenant aggregations
  createdAt  DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, userId])
  @@index([feedbackId])
  @@index([tenantId])
}

// Comments thread on a Feedback row. Mixes tenant-member comments and
// platform-staff replies; `internal=true` flags admin-only notes that
// the tenant must never see (filtered out at query time, mirroring
// SupportTicketMessage.internal).
model FeedbackComment {
  id         String   @id @default(cuid())
  feedbackId String
  authorId   String? // null = system / deleted user
  isStaff    Boolean  @default(false)
  internal   Boolean  @default(false)
  body       String

  createdAt DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId, createdAt])
}

// ────────────────────────────────────────────────────────────
// Phase 2 — Authentication / Security
// ────────────────────────────────────────────────────────────
//
// These four tables cover the credentials-provider security surface:
//
//   PasswordResetToken     — one-time token emailed for password recovery
//   EmailVerificationToken — one-time token for initial verify + change-email
//   UserTwoFactor          — TOTP secret + verified flag + recovery codes
//   SecurityEvent          — audit-log parallel, user-scoped (not tenant-scoped)
//
// Design notes:
//   • Both token tables store a one-way hash of the token in the row, not
//     the raw value. The raw value only exists in the URL sent by email —
//     a DB leak doesn't give an attacker a working reset link.
//   • UserTwoFactor stores the secret in plaintext for now (behind DB
//     encryption at rest); a future phase can move it to an envelope-
//     encrypted column if/when we formalize a KMS.
//   • SecurityEvent is deliberately separate from AuditLog. Audit logs
//     are tenant-scoped; security events are user-scoped and survive a
//     user being removed from a tenant. They're also the signal source
//     for rate-limiting and lockout in `lib/security.ts`.

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256(token) — raw token only lives in the email link
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  requestedIp String?
  userAgent   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// Covers both flows:
//   • initial email verification after signup (email = the user's email)
//   • change-email (email = the *new* address the user is switching to)
// The `purpose` column keeps them distinct so we don't accidentally let
// a signup-verify token confirm an email change.
model EmailVerificationToken {
  id        String                   @id @default(cuid())
  userId    String
  email     String // the address being verified (may differ from User.email when changing)
  purpose   EmailVerificationPurpose @default(INITIAL)
  tokenHash String                   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                 @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

enum EmailVerificationPurpose {
  INITIAL // verify the signup address
  CHANGE_EMAIL // verify a new address before swapping User.email
}

model UserTwoFactor {
  id                 String    @id @default(cuid())
  userId             String    @unique
  // Base32-encoded TOTP secret (RFC 6238). Length 32 random bytes → 52 chars.
  secret             String
  // Until the user successfully enters a code once, the setup is
  // provisional — it won't block login yet. We read User.twoFactorEnabled
  // for "is enforced at login". `verifiedAt` captures when the user
  // proved they can generate a valid code.
  verifiedAt         DateTime?
  // Hashed single-use recovery codes. Stored as an array of sha256 hex
  // strings; each consumed code gets filtered out of the array after use.
  recoveryCodeHashes String[]  @default([])
  lastUsedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecurityEvent {
  id        String            @id @default(cuid())
  userId    String
  kind      SecurityEventKind
  // Free-form structured payload — e.g. { from: "old@x.com", to: "new@x.com" }
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

// Phase 2 — short-lived handoff between "password OK" and "TOTP entered".
//
// When a user with 2FA enabled submits correct password, we mint one of
// these rows, write the raw token to an httpOnly cookie, and redirect
// them to /two-factor. The challenge action validates the TOTP code
// against the user pointed at by this row, then passes the raw token
// back into authorize() which marks it used and returns the session.
//
// This means the password is never re-submitted from the challenge
// page — a leaked challenge-page URL doesn't leak password material.
model TwoFactorPendingLogin {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

enum SecurityEventKind {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_LOCKED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_CHANGE_REQUESTED
  EMAIL_CHANGE_COMPLETED
  EMAIL_VERIFIED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  TWO_FACTOR_CHALLENGE_OK
  TWO_FACTOR_CHALLENGE_FAILED
  RECOVERY_CODE_USED
  SESSIONS_REVOKED
}

// ────────────────────────────────────────────────────────────
// Phase 3 — PalettePin.
//
// A per-user, per-tenant pin on a record (customer / quote / order /
// invoice / task / product / location). Renders as a dedicated group at
// the top of the ⌘K palette so frequent records are one keystroke away.
//
// We intentionally store `label` + `sub` + `href` alongside the
// foreign-key-ish `entityKind` + `entityId`. That lets us render the pin
// without re-querying the source row on every palette open, and keeps
// the pin alive (with stale copy) even if the underlying record gets
// renamed/archived — the pin still navigates to the right destination
// and the user can update it by re-pinning. A background sweep can
// prune pins whose target has been deleted.
// ────────────────────────────────────────────────────────────

model PalettePin {
  id       String @id @default(cuid())
  userId   String
  tenantId String

  entityKind String // "customer" | "quote" | "order" | "invoice" | "task" | "product" | "location"
  entityId   String

  // Snapshot shown in the palette row. Updated on re-pin.
  label String
  sub   String?
  href  String

  // Lower sort = higher in the list. Default is createdAt-descending.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // One pin per (user, tenant, entity). Re-pinning the same record just
  // updates the snapshot.
  @@unique([userId, tenantId, entityKind, entityId])
  @@index([userId, tenantId, sortOrder])
}

// ────────────────────────────────────────────────────────────
// Phase 16 Slice E — Saved views.
//
// A saved view is a named snapshot of the filter/sort state on a list
// page. We persist only the query-string payload in `filters` (e.g.
// `status=ACTIVE&tag=VIP&owner=clxyz`) so the picker can round-trip
// into the same page with one click and the page itself remains the
// source of truth for which filters exist.
//
// `isShared=false` views are owned by a single user. `isShared=true`
// views show up for every member of the tenant — useful for team-wide
// conventions like "My open quotes this week" or "Past due invoices".
// ────────────────────────────────────────────────────────────

model SavedView {
  id       String @id @default(cuid())
  userId   String
  tenantId String

  entityKind String // "customers" | "quotes" | "orders" | "invoices" | "leads" | "tasks" | ...
  name       String
  filters    String // raw querystring: "status=ACTIVE&tag=VIP"

  isShared  Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityKind, isShared])
  @@index([userId, tenantId, entityKind, sortOrder])
}

// ────────────────────────────────────────────────────────────
// Phase 5 — Marketing lead capture.
//
// Every public form (contact, book-a-demo, newsletter, trial signup
// abandoner) funnels through a single table. Keeps the pipeline
// visible in one place for sales, avoids per-form DB migrations when
// we add a new capture surface, and gives us a clean hand-off for
// eventual CRM sync (HubSpot / Pipedrive) without re-modeling.
//
// Why not push straight to email/Slack/CRM and forget it in our DB?
// Two reasons:
//   1. Forms submitted while SendGrid/HubSpot is down would silently
//      vanish. Persisting first + forwarding async is the durable
//      pattern.
//   2. Dedup. Someone submits the contact form, then a demo request
//      two minutes later — we want to see both, glued to the same
//      email, not two cold threads.
//
// No tenant FK — these are pre-conversion, no tenant yet. After
// conversion we stamp `convertedTenantId` for attribution reporting.
// ────────────────────────────────────────────────────────────

model MarketingLead {
  id   String            @id @default(cuid())
  kind MarketingLeadKind

  // Core identity — email is the deduplication anchor. Always lowercased.
  email   String
  name    String?
  company String?
  role    String?

  // Context
  teamSize      String? // "1-5" | "6-25" | "26-100" | "100+"
  message       String? // free-form ask / what they want to solve
  preferredTime String? // for demo requests — "morning", "afternoon", "evening"
  timezone      String? // IANA, e.g. "America/Los_Angeles"
  businessType  BusinessType?

  // Attribution
  source      String? // URL path of the capture point ("/", "/contact", "/book-demo")
  referrer    String? // document.referrer or direct
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  // Abuse / audit — we only keep a hash of the IP so we can dedup + rate
  // limit without storing raw PII.
  ipHash    String?
  userAgent String?

  // Pipeline — sales uses these to work the lead
  status             MarketingLeadStatus @default(NEW)
  assignedToUserId   String?
  firstContactedAt   DateTime?
  lastContactedAt    DateTime?
  convertedAt        DateTime?
  convertedTenantId  String?
  disqualifiedReason String?

  // Internal notes — a running ledger for the sales rep working it.
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, status, createdAt])
  @@index([email])
  @@index([assignedToUserId, status])
  @@index([createdAt])
}

enum MarketingLeadKind {
  INQUIRY // /contact form
  DEMO // /book-demo form
  NEWSLETTER // footer subscribe
  TRIAL_ABANDON // stub — reserved for future exit-intent capture on /signup
}

enum MarketingLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  DISQUALIFIED
  SPAM
}

// ────────────────────────────────────────────────────────────
// Phase 14 — Invoicing, payments, expenses, profit visibility, and
// financial operations.
//
// Design principles for this slice:
//   * Every model is tenant-scoped with Cascade delete. Finance data
//     is strictly private — nothing dangles across tenants.
//   * Money is Decimal(12,2) everywhere. No floats, ever.
//   * Denormalize aggregate totals (invoice.refundedAmount,
//     creditMemo.balance) to keep list queries O(1). The canonical
//     recomputer is recomputeInvoiceTotals() in src/app/actions/invoices.ts.
//   * Refunds, credits, and write-offs are distinct concepts:
//       - A refund is money leaving the shop back to the customer.
//       - A credit memo is a tenant-issued IOU — applied against a
//         future invoice, or carried on the customer's account.
//       - A write-off is an accounting concession that an invoice
//         won't be collected. The money never moves; the AR line
//         just closes out.
// ────────────────────────────────────────────────────────────

// Vendors are anyone the shop pays money to — material suppliers,
// subcontractors, utilities, software. Kept intentionally simple; a
// full accounts-payable module isn't in scope for Phase 14.
model Vendor {
  id       String @id @default(cuid())
  tenantId String

  name    String
  contact String? // primary contact name
  email   String?
  phone   String?
  website String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  country      String?

  // Free-form category the tenant uses for their own grouping
  // ("vinyl supplier", "install subcontractor"). Kept as a string
  // rather than an enum because every shop's taxonomy differs.
  category String?

  // Default account number / identifier the vendor knows us by (useful
  // for paying invoices or referencing in POs).
  accountNumber String?

  notes  String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([tenantId, name])
  @@index([tenantId, active])
  @@index([tenantId, category])
}

// Expenses are what the business spent. An expense may or may not be
// linked to a specific order (job-linked expenses feed margin
// computation). Receipt images are stored inline as data URLs until a
// proper blob store is wired — same pattern as Phase 13 install photos.
model Expense {
  id       String @id @default(cuid())
  tenantId String

  vendorId String? // nullable — walk-in receipts don't always have a vendor record
  orderId  String? // job-linked expenses feed margin computation

  // Category is freeform (tenant-defined). We surface a suggested list
  // in the UI but don't hard-enumerate them — every shop categorizes
  // differently and forcing an enum creates migration churn.
  category String?

  date      DateTime // when the expense was incurred (not when we recorded it)
  amount    Decimal  @db.Decimal(12, 2)
  // Separately tracked sales tax on the expense. We don't attempt to
  // compute it from the line — the tenant types it in, and it feeds a
  // "tax paid" number on the financial report.
  taxAmount Decimal  @default(0) @db.Decimal(12, 2)

  method    ExpensePaymentMethod @default(CARD)
  reference String? // check #, last 4, txn id — mirrors Payment.reference
  memo      String?

  // Whether this expense can be rebilled to the customer. Billable
  // expenses flow into the margin calc as "recovered cost" when we
  // later build that reporting.
  billable Boolean @default(false)

  // Receipt: either a data URL (client-downscaled JPEG, same pattern
  // as install photos), a hosted URL, or a server-relative path.
  // Server actions whitelist these three shapes before writing.
  receiptUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  order  Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
  @@index([tenantId, vendorId])
  @@index([tenantId, orderId])
  @@index([tenantId, category])
}

enum ExpensePaymentMethod {
  CASH
  CHECK
  CARD
  ACH
  OWNER_REIMBURSE // out-of-pocket to be paid back to the owner
  OTHER
}

// Refund — money going back to the customer. Usually traces to a
// specific payment (paymentId set) but can also be issued without a
// source payment (e.g. shop store credit refunded in cash). Refunds
// reduce invoice.refundedAmount, which reduces the invoice's effective
// paidAmount-for-status-purposes.
model Refund {
  id        String  @id @default(cuid())
  tenantId  String
  invoiceId String
  paymentId String? // optional — refunds may stand alone

  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod // how the refund was issued back
  reason     String
  reference  String? // external refund id / check # / etc.
  refundedAt DateTime      @default(now())
  recordedBy String

  createdAt DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([tenantId, invoiceId])
  @@index([tenantId, refundedAt])
}

// CreditMemo — a tenant-issued IOU to a customer. Typical origins:
// overpayment, rejected goods, goodwill adjustment. A credit memo has
// an `amount` (face value) and a `balance` (remaining after
// applications). Applications are tracked separately so the history
// survives and we can show "applied $50 to INV-1003 on 2026-02-14".
model CreditMemo {
  id         String @id @default(cuid())
  tenantId   String
  customerId String

  // Optional source invoice — the invoice that caused the credit
  // (overpayment, adjustment). May be null for goodwill/manual credits.
  sourceInvoiceId String?

  // Tenant-facing memo number — "CM-1001" etc. Reuses the invoice
  // prefix-and-counter pattern via tenant.creditMemoLastNumber.
  number String

  amount  Decimal @db.Decimal(12, 2)
  balance Decimal @db.Decimal(12, 2) // amount - sum(applications)

  reason String

  issuedAt   DateTime  @default(now())
  voidedAt   DateTime?
  voidReason String?
  recordedBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  applications CreditApplication[]

  @@unique([tenantId, number])
  @@index([tenantId, customerId])
  @@index([tenantId, issuedAt])
}

// A credit memo can be applied against an invoice, partially or
// fully. Each application is an immutable record — reversing an
// application creates a new "reversal" entry rather than mutating the
// original.
model CreditApplication {
  id           String @id @default(cuid())
  tenantId     String
  creditMemoId String
  invoiceId    String

  amount     Decimal  @db.Decimal(12, 2)
  appliedAt  DateTime @default(now())
  recordedBy String

  createdAt DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creditMemo CreditMemo @relation(fields: [creditMemoId], references: [id], onDelete: Cascade)
  invoice    Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, creditMemoId])
  @@index([tenantId, invoiceId])
}

// ────────────────────────────────────────────────────────────
// Phase 16 — two-way portal messaging
// ────────────────────────────────────────────────────────────
//
// Customers can send a message from their portal; staff can reply from the
// customer communication view. Each message has a direction (INBOUND = customer
// sent it, OUTBOUND = staff sent it) and an optional relatedEntity so the
// thread can be scoped to a quote / order / invoice / proof.
//
// Staff replies are sent via the existing sendCustomerEmail helper so the
// EmailEvent timeline also picks them up — the PortalMessage row is the
// source-of-truth for the in-app thread; the EmailEvent row is the delivery
// record for the external email.

model PortalMessage {
  id         String @id @default(cuid())
  tenantId   String
  customerId String

  direction PortalMessageDirection @default(INBOUND)
  subject   String?
  body      String

  // Optional context — link this message to a specific job entity.
  relatedEntityType String? // "Quote" | "Order" | "Invoice" | "Proof"
  relatedEntityId   String?

  // Staff member who replied (null for inbound customer messages).
  senderUserId String?

  // Soft-delete — staff can archive noisy threads.
  archivedAt DateTime?

  // Staff has seen / acknowledged this inbound message.
  readAt DateTime?

  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sender   User?    @relation("PortalMessageSender", fields: [senderUserId], references: [id])

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, direction, readAt])
}

enum PortalMessageDirection {
  INBOUND // customer → shop
  OUTBOUND // shop → customer (reply)
}

// WriteOff — an accounting acknowledgment that the invoice won't be
// collected. The invoice status flips to WRITTEN_OFF and the
// writtenOffAmount is denormalized onto the invoice for quick totals.
// Reversing a write-off re-opens the invoice (no destructive delete).
model WriteOff {
  id        String @id @default(cuid())
  tenantId  String
  invoiceId String

  amount Decimal @db.Decimal(12, 2)
  reason String

  writtenOffAt DateTime  @default(now())
  reversedAt   DateTime?
  reversedBy   String?
  recordedBy   String

  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@index([tenantId, writtenOffAt])
}

// ────────────────────────────────────────────────────────────
// M1 — Pricing plan management tables.
//
// The `Plan` enum above is a static 4-slot set embedded in code. These
// tables let a platform admin edit prices, feature labels, CTA buttons,
// marketing copy, and Stripe price IDs from /platform/pricing without
// a code deploy — and let the public pricing page read from the same
// source that drives entitlements + checkout.
//
// Naming: the top-level row is `PricingPlan` (not `Plan`) to avoid
// colliding with the existing `Plan` enum during the transition. The
// child rows keep the shorter `Plan*` prefix since they don't clash.
// ────────────────────────────────────────────────────────────

// Page 19 — lifecycle behavior enums for plan changes + trial settings + tax.

enum PlanMigrationOnUpgrade {
  PRORATE_IMMEDIATE  // charge prorated diff today
  END_OF_PERIOD      // wait until next renewal
}

enum PlanMigrationOnDowngrade {
  END_OF_PERIOD       // keep current plan until renewal, then drop
  PRORATE_REFUND      // refund prorated diff today, switch immediately
}

enum PlanBillingCycle {
  MONTHLY
  ANNUAL
}

enum PlanTaxBehavior {
  EXCLUSIVE   // tax added on top of price
  INCLUSIVE   // tax already baked into price
}

model PricingPlan {
  id String @id @default(cuid())

  // Stable external identifier — used by Stripe metadata, legacy code
  // that still maps `Plan` enum values, and marketing URL slugs like
  // /signup?plan=starter. Slugs are unique but mutable: the admin can
  // rename "growth" → "scale" if marketing rebrands a tier.
  slug String @unique

  // Public-facing fields.
  name        String // "Pro", "Starter"
  subtitle    String? // one-line positioning under the name on cards
  description String? // longer description for /pricing detail
  badge       String? // "Most popular", "Save 20%" — shown as a chip

  // Lifecycle: DRAFT = editing; PUBLISHED = live; HIDDEN = legacy
  // (existing subs keep it, new prospects don't see it); ARCHIVED =
  // retired, nobody on it.
  status PlanStatus @default(DRAFT)

  // Visual emphasis on marketing. Exactly one plan usually carries
  // `highlight = true` — rendered with the accent border on /pricing.
  highlight Boolean @default(false)

  // Sort order on marketing + admin listings. Lower = shown first.
  sortOrder Int @default(0)

  // Pricing. Null on either side if the plan doesn't offer that cycle
  // (e.g. custom/Enterprise tiers where price is "Contact us"). Decimal
  // so we can represent $79.50 cleanly without float drift.
  priceMonthly   Decimal? @db.Decimal(10, 2)
  priceAnnual    Decimal? @db.Decimal(10, 2)
  currency       String   @default("USD")
  // If true, the card shows "Contact sales" instead of a price — both
  // price fields are ignored for display. Used for Enterprise.
  isContactSales Boolean  @default(false)

  // Optional free-trial override in days. Null = use platform default.
  trialDays Int?
  // Page 19 — trial settings.
  /** When true, signup requires a card on file before the trial starts. */
  trialRequiresCard Boolean @default(false)
  /** Trial-end CTA copy override (e.g. "Convert to paid", "Add card to keep access"). */
  trialCtaLabel     String?

  // Page 19 — migration rules. What happens on plan change?
  migrationOnUpgrade   PlanMigrationOnUpgrade   @default(PRORATE_IMMEDIATE)
  migrationOnDowngrade PlanMigrationOnDowngrade @default(END_OF_PERIOD)
  /** Default billing cycle picked at signup if both monthly + annual exist. */
  defaultCycle         PlanBillingCycle         @default(MONTHLY)

  // Page 19 — tax behavior.
  taxBehavior PlanTaxBehavior @default(EXCLUSIVE)
  /** Stripe Tax tax code (e.g. "txcd_10000000" for SaaS). */
  taxCode     String?

  // CTA button. If `ctaHref` is null the marketing component falls
  // back to `/signup?plan=<slug>`. Contact-sales plans point at /contact.
  ctaLabel String? // "Start free trial", "Talk to sales"
  ctaHref  String?

  // Copy variants. `landingCopy` is the compact blurb on home `/`;
  // `marketingCopy` is the fuller description on `/pricing`. Plain
  // text (no HTML passthrough) — markdown is fine if we render it.
  landingCopy   String?
  marketingCopy String?

  // Visibility per surface. An admin can hide a plan from /pricing
  // (legacy Growth tier is visible only to existing subs) while still
  // keeping it purchasable through a direct checkout link.
  showOnLanding Boolean @default(true)
  showOnPricing Boolean @default(true)
  showOnSignup  Boolean @default(true)

  // Stripe linkage. Each plan can point at a single Stripe Product
  // and the two Price objects (monthly + annual). Null = not synced;
  // the checkout path falls back to the legacy `PRICE_IDS` env map.
  stripeProductId    String?
  stripePriceMonthly String?
  stripePriceAnnual  String?
  stripeSyncedAt     DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime? // first time status went PUBLISHED

  featureValues PlanFeatureValue[]
  addOns        PlanAddOn[]
  versions      PlanVersion[]
  overrides     PlanPriceOverride[]
  tenants       Tenant[]

  @@index([status, sortOrder])
}

// Master list of all features that can appear on pricing pages or gate
// product behavior. Each row is defined once; per-plan values live in
// PlanFeatureValue. Having a feature table (rather than inlining bullets
// on each plan) means the admin can rearrange feature rows in one place
// and every plan's card stays in sync.
model PlanFeature {
  id String @id @default(cuid())

  // Stable programmatic key used by the app when gating
  // (`hasFeature(ctx.tenant, "installScheduling")`). Must match the
  // entitlement keys we already care about — the M2 slice swaps
  // PLAN_ENTITLEMENTS over to read from this table.
  key String @unique

  // Human label shown on marketing pages and admin UI.
  label String

  // Optional group/section for the feature matrix: "Core", "Workflow",
  // "Collaboration", "Integrations", etc. Null = ungrouped.
  groupLabel String?

  // Hover-tooltip text shown next to the label on /pricing.
  description String?

  // Shape of the per-plan value: boolean / numeric cap / text label.
  valueType FeatureValueType @default(BOOLEAN)

  // GATE = real runtime entitlement; MARKETING_ONLY = text-only bullet
  // with no code effect. Prevents pricing-page bullets from silently
  // drifting from what the app actually enforces.
  enforcement FeatureEnforcement @default(GATE)

  // Sort order inside the group. Lower = shown first.
  sortOrder Int @default(0)

  // Per-group sort (controls order of the group section itself).
  groupSortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values PlanFeatureValue[]

  @@index([groupSortOrder, sortOrder])
}

// Per-(plan × feature) value cell in the feature matrix. Exactly one
// of valueBool / valueNumber / valueText is canonical, picked by the
// parent PlanFeature.valueType. `highlight` flags a value cell to be
// rendered in the accent color on the marketing page.
model PlanFeatureValue {
  id        String @id @default(cuid())
  planId    String
  featureId String

  valueBool   Boolean?
  valueNumber Int? // numeric caps: 3 seats, 100 customers; -1 = unlimited
  valueText   String? // "Basic", "Priority + chat"

  // Short note shown under the value — e.g. "+$12/seat after 15", or
  // "up to 3" for a capped-but-text-labeled cell.
  footnote String?

  highlight Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan    PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature PlanFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([featureId])
}

// Optional add-ons shown under the base plan price ("+$12/extra seat",
// "+$29 for API access"). Priced independently of the plan and can be
// attached to multiple plans — but each row here is scoped to one
// plan so the admin can differ copy/pricing per tier.
model PlanAddOn {
  id     String @id @default(cuid())
  planId String

  slug        String // "extra-seat", "api-access"
  name        String // "Extra user seat", "API + webhooks"
  description String?

  priceMonthly Decimal? @db.Decimal(10, 2)
  priceAnnual  Decimal? @db.Decimal(10, 2)
  // For per-unit add-ons like seats, label the unit for display.
  unitLabel    String? // "per seat / mo"

  // Stripe price ID for this add-on, synced when the admin saves.
  stripePriceId String?

  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, slug])
  @@index([planId, active])
}

// Version history. Every time a PricingPlan is published we snapshot
// the serialized state (plan row + its features + add-ons) into a
// PlanVersion. Lets admins see "what did Pro look like on Feb 1?" and
// roll back a bad edit. Snapshots are JSON so the shape can evolve
// without migration churn.
model PlanVersion {
  id     String @id @default(cuid())
  planId String

  // Monotonic counter starting at 1 per plan. Easier to reference than
  // a timestamp when saying "roll back to v4".
  version Int

  // Full serialized state at publish time. Shape is intentionally
  // loose (Json) because the admin surface iterates faster than
  // migrations would tolerate.
  snapshot Json

  // Who clicked "Publish" and what did they say about it.
  publishedByUserId String?
  note              String?

  createdAt DateTime @default(now())

  plan PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, version])
  @@index([planId, createdAt])
}

// Per-tenant price override. The headline use case is grandfathered
// pricing ("the first 50 customers pay 2024 prices forever") and
// custom-negotiated Enterprise deals. When present, billing uses
// these values instead of the PricingPlan's current prices.
model PlanPriceOverride {
  id       String @id @default(cuid())
  tenantId String
  planId   String

  priceMonthly Decimal? @db.Decimal(10, 2)
  priceAnnual  Decimal? @db.Decimal(10, 2)
  currency     String   @default("USD")

  // Free-form note surfaced to platform staff only — "2024 launch
  // deal", "negotiated by sales, 20% off through 2027-01".
  note String?

  // Optional end-date for the override; after this it falls back to
  // the PricingPlan's current prices. Null = permanent.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([tenantId, planId])
  @@index([tenantId])
  @@index([planId])
}

// ─────────────────────────────────────────────────────────────────
// Notifications (M6) — DB-driven transactional-notification catalog
// ─────────────────────────────────────────────────────────────────
//
// The platform has historically hardcoded every email template inside
// `src/lib/email.ts`. This is the catalog that lets a platform admin
// edit subject lines, headlines, body copy, and CTA labels from
// /platform/notifications without a code change.
//
// Design rules (see the M6 proposal):
//   • One row per (kind, channel, locale). Identity is by `kind` slug.
//   • Content is structured fields, NOT raw HTML. Admin-editable body
//     uses markdown-lite; the surrounding branded layout is code-owned
//     (`brandedEmailLayout()` in src/lib/email.ts) for cross-client
//     safety.
//   • Every kind has a compile-time default in
//     `src/lib/notifications/defaults.ts`. If the DB row is missing or
//     disabled, we fall back to the default so the system can never go
//     email-silent due to a misconfigured row.
//   • `isCritical` kinds (auth, security, payment_failed) cannot be
//     disabled from the admin UI — their `enabled` toggle is locked.
//   • Publishing snapshots a NotificationTemplateVersion row. Same
//     pattern as PlanVersion — supports diff, rollback, and audit.
//   • `channel` + `locale` are columns from day 1 even though only
//     EMAIL / "en" ship in M1; slots future in-app/SMS/push + i18n
//     without a schema migration.

enum NotificationChannel {
  EMAIL
  IN_APP
  SMS
  PUSH
}

enum NotificationStatus {
  DRAFT // never published — renderer falls back to code default
  PUBLISHED // live content served to senders
  DISABLED // non-critical kill-switch; renderer returns early
}

// A platform-level template that shapes a single outbound notification
// kind. The `kind` string is the programmatic identity used by code
// (`sendNotification({ kind: "auth.email_verification", ... })`) — it
// must match a registration in `src/lib/notifications/registry.ts`.
model NotificationTemplate {
  id String @id @default(cuid())

  // Programmatic identity — e.g. "auth.email_verification",
  // "billing.payment_failed". Dotted namespace keeps the catalog
  // alphabetizable and makes category inference trivial.
  kind    String
  channel NotificationChannel @default(EMAIL)
  locale  String              @default("en") // future i18n

  status    NotificationStatus @default(DRAFT)
  // Human category for the admin UI sidebar — "auth" | "billing" |
  // "team" | "support" | "activity". Duplicates the `kind` namespace
  // but explicit so we can reorder without parsing slugs.
  category  String
  sortOrder Int                @default(0)

  // Editable content. Admins change these from /platform/notifications.
  // `body` is markdown-lite (paragraphs + **bold** + [links](url) +
  // `code` + *italic*) — rendered safely into the branded layout.
  // `ctaUrlToken` is usually a token reference like "{{verify_url}}";
  // the dispatcher resolves tokens at send time.
  subject     String
  preheader   String?
  headline    String
  subheading  String?
  body        String // markdown-lite
  ctaLabel    String?
  ctaUrlToken String?
  footerNote  String?

  // Draft-in-progress content. When non-null, the admin has unsaved
  // changes relative to the main columns. "Publish" copies draftJson
  // into the main columns + clears this + snapshots a version.
  draftJson Json?

  // Controls.
  enabled    Boolean @default(true) // hard kill-switch; ignored for isCritical
  // Critical kinds (auth, security, payment-failed) can still be
  // copy-edited, but the enabled toggle is locked in the UI — you
  // cannot accidentally disable "your password was changed".
  isCritical Boolean @default(false)

  // Frozen at registration time — the allowlist of tokens this kind
  // may reference. Publishing validates every `{{token}}` in the
  // subject/body against this schema. Shape is
  //   { [token: string]: { type: "string" | "url" | "number", sample: string } }
  tokenSchema Json

  publishedAt   DateTime?
  updatedById   String?
  publishedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions NotificationTemplateVersion[]

  // Identity is (kind, channel, locale) — one English email template
  // per kind, one English in-app per kind, room for ("…", EMAIL, "fr").
  @@unique([kind, channel, locale])
  @@index([category, sortOrder])
  @@index([status])
}

// Immutable snapshot of a template at publish time. Same relationship
// as PlanVersion has to PricingPlan. Rollback = copy a version row's
// content fields back onto the main template + snapshot as v{N+1}.
model NotificationTemplateVersion {
  id         String @id @default(cuid())
  templateId String
  version    Int

  subject     String
  preheader   String?
  headline    String
  subheading  String?
  body        String
  ctaLabel    String?
  ctaUrlToken String?
  footerNote  String?

  publishedAt   DateTime @default(now())
  publishedById String?
  // Stored separately from the live table so older versions keep
  // their original note even after the token schema evolves.
  tokenSchema   Json
  // Freeform change summary shown in the history timeline.
  changeNote    String?

  template NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId, publishedAt])
}

// Global branding applied to every transactional notification.
// Singleton — enforced by `singleton Boolean @unique` at value `true`.
// Fields feed `brandedEmailLayout()` (accent color, button radius,
// product name, footer links, support email) so changes here propagate
// to every email without per-template edits.
model NotificationBrand {
  id        String  @id @default(cuid())
  // Sentinel column to enforce a single row — all code reads the
  // row where `singleton = true`, and @unique blocks accidental
  // inserts of a second row.
  singleton Boolean @unique @default(true)

  productName String  @default("Flowtora")
  tagline     String  @default("A calm ops platform for sign & print shops.")
  logoUrl     String?

  // Rendered into button backgrounds + note border-accent. Hex color.
  accentColor    String @default("#4f8cff")
  // 0–16 px. Controls the CTA button corner radius.
  buttonRadiusPx Int    @default(10)

  // Support-footer links. `supportEmail` doubles as the reply-to for
  // transactional email when NotificationBrand.replyTo is null.
  supportEmail String?
  footerHtml   String?

  // Envelope overrides. Envelope domain stays on RESEND_FROM_EMAIL
  // for DKIM/SPF reasons; these only rewrite the display name +
  // reply-to header.
  fromName String?
  replyTo  String?

  updatedAt   DateTime @updatedAt
  updatedById String?
}

// ────────────────────────────────────────────────────────────
// First-party analytics — visitor page-view log for the marketing
// surface only. Tenant app pages, platform admin pages, auth pages,
// portal/share surfaces are not tracked here.
//
// Privacy notes:
//   - No raw IP is stored. We hash with a daily-rotating salt so the
//     same visitor on different days produces different hashes —
//     gives us within-day session de-dup without persistent PII.
//   - User-agent is truncated to 200 chars.
//   - Only tracks visitors who clicked "Accept" on the cookie
//     banner; declined visitors never hit the beacon.
//
// Geo fields are populated from Vercel's free `x-vercel-ip-*`
// request headers (country / region / city / latitude / longitude).
// They're nullable so a missing or unknown geo doesn't break inserts.
// ────────────────────────────────────────────────────────────
model PageView {
  id String @id @default(cuid())

  // Path the visitor was on (origin-less, e.g. "/pricing"). Query
  // strings stripped before insert so we don't fragment metrics.
  path String

  // Where they came from. Null = direct / typed-in / no referrer header.
  // Origin-only when present (e.g. "https://google.com") so we don't
  // leak the originating page's full URL into our DB.
  referrerHost String?

  // Vercel geolocation snapshot. ISO country code (2 letters), and
  // city / region as supplied by edge — both can be null on cellular
  // / VPN traffic where Vercel can't resolve.
  country  String?
  region   String?
  city     String?
  // Decimal lat/lon — used to drop the dot on the live map.
  latitude  Float?
  longitude Float?

  // Truncated UA (max 200 chars) for desktop/mobile breakdown.
  userAgent String?

  // Browser-generated session UUID — stored in localStorage on the
  // visitor's device. Lets us compute "live visitors" (distinct
  // sessionIds in the last 5 min) without persistent identifiers.
  sessionId String

  // SHA-256(ip + dailySalt) — opaque identifier for same-day de-dup
  // without storing the raw IP. Rotates daily so cross-day tracking
  // is impossible.
  ipHash String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@index([path])
}

// ────────────────────────────────────────────────────────────
// GDPR proof-of-consent log.
//
// Every cookie-banner decision is recorded — accept all, reject all,
// custom selection, or later withdrawal. Lets the business prove,
// for any given anonymous browser or signed-in user, exactly what
// consent was on file at any timestamp. Audit-friendly.
//
// Architecture:
//   - `anonymousId` is a browser-generated UUID stored in localStorage
//     (and mirrored as a non-httpOnly cookie). Stable across visits
//     from the same browser, regardless of auth state.
//   - `userId` is filled when the visitor was signed in at the
//     moment of the decision; null otherwise.
//   - `categories` snapshots the granular toggles in their final
//     state at the moment of consent.
//   - `version` bumps when cookie-policy text materially changes —
//     stale versions trigger a re-consent prompt.
//   - IP is hashed (daily salt, same scheme as PageView) so we can
//     prove "this consent came from a real visitor" without retaining
//     PII. Optional and easy to drop entirely.
// ────────────────────────────────────────────────────────────
model ConsentLog {
  id String @id @default(cuid())

  /// Browser-generated UUID. Stable across decisions from the same
  /// browser. Use this to find a visitor's full consent history.
  anonymousId String

  /// User id at the moment of consent, if signed in. Null otherwise.
  userId String?

  /// Cookie-policy version this decision was recorded against.
  version String

  /// "accepted-all" | "rejected-all" | "custom" | "withdrawn"
  decision String

  /// Snapshot of category toggles at decision time.
  /// Shape: { necessary: true, analytics: bool, marketing: bool, preferences: bool }
  categories Json

  /// Hashed source IP (daily-rotating salt). Optional.
  ipHash String?

  /// Truncated user-agent string for the audit trail.
  userAgent String?

  createdAt DateTime @default(now())

  @@index([anonymousId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────
// Phase 3 — Platform billing (Flowtora → tenants).
//
// Three concerns live here:
//   1. Coupons / promo codes (mint, redeem, expire).
//   2. Dunning state — see `DunningStage` enum + Tenant.dunningStage above.
//   3. Manual invoicing — admin-issued invoices for one-off line items
//      (custom enterprise terms, bespoke setup fees, etc.) that don't
//      flow through the normal Stripe subscription cycle.
//
// Stripe-mirroring (push these coupons / invoices to Stripe so they
// hit the customer's actual checkout) is a deliberate follow-up.
// We persist locally first so the admin surface works without a live
// Stripe connection — important for offline demo, dev environments,
// and any tenant on a contract not yet wired to Stripe.
// ─────────────────────────────────────────────────────────────────────

enum DunningStage {
  NONE
  PAYMENT_FAILED  // first failed charge — initial alert, no email yet
  REMINDER_1      // day 1: gentle email
  REMINDER_2      // day 3: firmer reminder
  FINAL_NOTICE    // day 7: "we'll suspend in 7 days" warning
  SUSPEND         // day 14: account suspended, manual rescue path
  RESOLVED        // payment came in — terminal until next failure
}

enum CouponDiscountType {
  PERCENT  // e.g. 20 = 20% off
  FIXED    // e.g. 1000 = 10.00 off (in minor units of `currency`)
}

enum CouponStatus {
  DRAFT     // mint, but don't allow redemption yet
  ACTIVE
  EXPIRED   // past validUntil — set automatically on read
  ARCHIVED  // hidden from active lists, kept for audit history
}

// Page 20 — how long the discount sticks once redeemed.
enum CouponDuration {
  ONCE       // one-time discount on next invoice
  REPEATING  // applies for N months (durationMonths)
  FOREVER    // applies indefinitely while subscription is active
}

model Coupon {
  id             String             @id @default(cuid())
  // Customer-visible code, normalized to upper-case at creation. Unique
  // across the platform — we don't scope to currency or plan because
  // the admin surface is small and a clash would be confusing.
  code           String             @unique
  // Phase 3 follow-up — Stripe coupon mirror. Set to the Stripe coupon
  // ID once we've pushed it; null when the local row hasn't (yet) been
  // synced or when STRIPE_SECRET_KEY isn't configured. We use our
  // `code` as the Stripe ID so the two systems stay grep-able from
  // the same string.
  stripeCouponId String?            @unique
  stripeSyncedAt DateTime?
  description    String?            // internal note — never shown to tenant
  // Page 20 — separate human-friendly internal name distinct from the
  // public code. e.g. code "LAUNCH26", name "Q2 launch promo".
  name           String?
  discountType   CouponDiscountType
  // Percent (1-100) when type=PERCENT, minor units (cents) when type=FIXED.
  amount         Int
  // Three-letter ISO code. Required only for FIXED-amount coupons; null
  // for PERCENT (it applies to whatever currency the tenant is billed in).
  currency       String?
  // Plan slugs this coupon applies to. Empty = applies to any plan.
  // Stored as lowercase slugs to match PricingPlan.slug.
  appliesToPlans String[]           @default([])
  // Page 20 — applicable tenant scope. Empty = applies to any tenant.
  appliesToTenantIds String[]       @default([])
  // null = unlimited.
  maxRedemptions Int?
  // Page 20 — per-customer cap (in addition to global maxRedemptions).
  maxRedemptionsPerCustomer Int?
  redeemedCount  Int                @default(0)
  // Page 20 — duration of the discount once redeemed.
  duration         CouponDuration   @default(ONCE)
  /** Months the discount repeats; only used when duration=REPEATING. */
  durationMonths   Int?
  // Page 20 — eligibility gates. minSubscriptionAmount in minor units of
  // the invoice currency. firstTimeOnly = first redemption per tenant.
  // newTenantsOnlyDays = only tenants signed up within this many days.
  minSubscriptionAmount Int?
  firstTimeOnly         Boolean @default(false)
  newTenantsOnlyDays    Int?
  // Page 20 — stackable with other coupons on the same invoice.
  stackable             Boolean @default(false)
  // Page 20 — surface on /pricing as a public discount banner. Only
  // honored if status=ACTIVE and code is marketing-eligible.
  showOnPricingPage     Boolean @default(false)
  validFrom      DateTime           @default(now())
  validUntil     DateTime?
  status         CouponStatus       @default(ACTIVE)
  createdById    String
  createdBy      User               @relation("CouponCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  redemptions      CouponRedemption[]
  // Reverse side of Tenant.activeCoupon — lets us list "tenants
  // currently sitting on this coupon" without a separate query.
  activeForTenants Tenant[]            @relation("TenantActiveCoupon")
  // Page 20 — back-relation for promotions referencing this coupon.
  promotions       Promotion[]

  @@index([status, validUntil])
  @@index([createdById])
}

// ─────────────────────────────────────────────────────────────────
// Page 20 — Promotions.
//
// A Promotion bundles a Coupon (the redemption mechanic) with the
// marketing surfaces around it: landing-page URL, email-template kind,
// audience description, run window, and a goal/metric line for the
// admin to track success against. Promotions are reporting metadata —
// they don't change how a Coupon is redeemed.
// ─────────────────────────────────────────────────────────────────

enum PromotionStatus {
  DRAFT      // not yet started
  SCHEDULED  // start date in future
  ACTIVE     // running now
  ENDED      // past end date or manually ended
  ARCHIVED   // hidden from the active list
}

model Promotion {
  id          String          @id @default(cuid())
  /** Internal name e.g. "Q2 launch", "Black Friday 2026". */
  name        String
  /** Marketing description / objective shown in the admin list. */
  description String?
  /** The coupon this promotion drives. Multiple promotions can share a
   *  coupon (e.g. test variants of the same code) but most map 1:1. */
  couponId    String
  coupon      Coupon          @relation(fields: [couponId], references: [id], onDelete: Cascade)
  /** Marketing landing URL the email/ads point at. Free-form so it can
   *  be any /pricing/q2 or external site. */
  landingUrl  String?
  /** Notification template kind to send (matches NotificationTemplate.kind). */
  emailTemplateKind String?
  /** Free-form audience description: "Trial tenants ≥ 14 days old",
   *  "All US sign shops", etc. Reporting only. */
  audience    String?
  /** Goal line: "500 redemptions, 10% conversion lift". */
  goal        String?
  /** Window. Either side may be null for open-ended runs. */
  startsAt    DateTime?
  endsAt      DateTime?
  status      PromotionStatus @default(DRAFT)
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, startsAt])
  @@index([couponId])
}

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  tenantId      String
  // The platform invoice this redemption was applied to, when the
  // discount lands on a manual invoice. Null when applied to the
  // recurring Stripe subscription (we don't track those line items).
  invoiceId     String?
  appliedAmount Int      // minor units of the invoice currency, post-discount line
  createdAt     DateTime @default(now())

  coupon  Coupon                  @relation(fields: [couponId],  references: [id], onDelete: Cascade)
  tenant  Tenant                  @relation(fields: [tenantId],  references: [id], onDelete: Cascade)
  invoice PlatformBillingInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([couponId, createdAt])
  @@index([invoiceId])
}

enum PlatformInvoiceStatus {
  DRAFT
  SENT
  PAID
  VOIDED
  REFUNDED
  // Page 16 (Invoices) additions:
  // OPEN is the post-issuance, pre-payment state — currently SENT
  // already covers it but we keep both for spec parity. Existing
  // SENT rows are treated as OPEN by the list filter. UNCOLLECTIBLE
  // is the "we gave up trying to collect" terminal state — separate
  // from VOIDED so accounting reports can distinguish them.
  OPEN
  UNCOLLECTIBLE
}

// Page 16 — origin of an invoice. SUBSCRIPTION rows are auto-issued
// by the dunning / renewal pipeline; MANUAL rows are admin-issued
// (a one-off charge or migration fee).
enum PlatformInvoiceSource {
  SUBSCRIPTION
  MANUAL
}

model PlatformBillingInvoice {
  id          String                @id @default(cuid())
  tenantId    String
  number      String                @unique // human-readable, e.g. "PI-1042"
  status      PlatformInvoiceStatus @default(DRAFT)
  // Three-letter ISO code. Persisted on the invoice (not derived from
  // tenant) because tenants can change currency mid-life and old
  // invoices must lock to the rate they were issued under.
  currency    String                @default("USD")
  // Cached aggregates — stored so list views stay snappy without
  // joining the items table. Recalculated on every invoice mutation.
  subtotal    Int                   @default(0) // minor units, pre-discount, pre-tax
  discount    Int                   @default(0)
  tax         Int                   @default(0)
  total       Int                   @default(0)
  amountPaid  Int                   @default(0)
  notes       String?
  // Page 16 — customer-visible vs internal note split. `notes` is the
  // legacy single-field; `internalNotes` is the platform-only side
  // shown on the admin detail page but never on the customer PDF.
  internalNotes String?
  // Free-form due note rendered on the customer view ("Net 30",
  // "Wire instructions in PDF", etc.). Not parsed.
  termsText   String?
  /** Page 16 — origin. SUBSCRIPTION (auto-issued) or MANUAL (admin
   *  issued via the new-invoice composer). Defaults to MANUAL since
   *  the legacy createPlatformInvoice flow is admin-issued. */
  source      PlatformInvoiceSource @default(MANUAL)
  /** Tax breakdown by jurisdiction. Shape: array of
   *  { jurisdiction: string; rate: number; amount: number }. */
  taxBreakdown Json?
  /** Reason captured when voided / marked uncollectible. */
  voidReason  String?
  // Coupon applied as part of issuance — captured here for redenor
  // history even if the coupon is later archived.
  couponId    String?
  issuedAt    DateTime?
  dueAt       DateTime?
  paidAt      DateTime?
  voidedAt    DateTime?
  // Audit pointers.
  createdById String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  tenant      Tenant                       @relation(fields: [tenantId],    references: [id], onDelete: Cascade)
  createdBy   User                         @relation("PlatformInvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items       PlatformBillingInvoiceItem[]
  redemptions CouponRedemption[]
  payments    PlatformInvoicePayment[]
  creditNotes PlatformCreditNote[]
  /** Page 18 — refunds + disputes initiated against this invoice. */
  paymentRefunds PlatformPaymentRefund[]
  disputes       PlatformDispute[]
  // Page 23 — dunning event queued against a failed payment on this invoice.
  dunningEvents  DunningEvent[]

  @@index([tenantId, status])
  @@index([status, issuedAt])
}

// Page 16 — payment attempts against a platform invoice. One row per
// attempt (success or failure) so the detail page can render a full
// timeline including the gateway's response code, fee, and net.
//
// We don't write these rows yet (no Stripe integration in the test
// stack), but the model is ready so the detail UI can read against
// real data once the webhook handlers are wired.
model PlatformInvoicePayment {
  id        String   @id @default(cuid())
  invoiceId String
  /** "stripe" / "manual" / "wire" / "ach" / etc. */
  gateway   String
  /** Gateway-side id when applicable. */
  gatewayPaymentId String?
  /** "succeeded" / "failed" / "pending" / "refunded" / "partial_refund" */
  status    String
  /** Payment method snippet — "Visa •• 4242", "ACH BoA", etc. */
  method    String?
  /** Minor units of the invoice currency. */
  amount    Int
  /** Gateway fee (always positive, in minor units). */
  fee       Int      @default(0)
  /** Net = amount - fee. Stored to avoid recomputation in reports. */
  net       Int      @default(0)
  /** Decline / failure reason — short code like "card_declined". */
  failureCode   String?
  /** Free-text gateway message. */
  failureReason String?
  /** Risk metadata (AVS, CVV, 3DS, etc.) as JSON. */
  riskMetadata  Json?
  /** Raw gateway response body — capped at 4 KB at write time. */
  rawResponse   String?

  attemptedAt DateTime @default(now())
  refundedAt  DateTime?

  invoice PlatformBillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  refunds PlatformPaymentRefund[]
  dispute PlatformDispute?
  // Page 23 — Dunning event queued against this failed payment (1:1).
  dunningEvent DunningEvent?

  @@index([invoiceId, attemptedAt])
  @@index([status, attemptedAt])
}

// ────────────────────────────────────────────────────────────
// Page 18 — Refunds & Disputes.
//
// PlatformPaymentRefund captures every refund a platform admin
// initiates against a PlatformInvoicePayment. Distinct from the
// tenant-side `Refund` model (which lives at the workspace level —
// tenants refunding *their* customers).
//
// PlatformDispute tracks chargebacks — gateway-initiated disputes
// against our platform charges. Evidence flows through the dispute
// detail page; the gateway-side resolution is captured via the
// status enum + resolvedAt.
//
// ChargebackEvidenceTemplate stores reusable evidence drafts — body
// uses {tenant}, {amount}, {date} placeholders that the submit-
// evidence form interpolates against the live dispute.
// ────────────────────────────────────────────────────────────

enum PlatformRefundReason {
  CUSTOMER_REQUEST
  FRAUD
  DUPLICATE
  SUBSCRIPTION_MISTAKE
  SERVICE_ISSUE
  OTHER
}

enum PlatformRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model PlatformPaymentRefund {
  id        String @id @default(cuid())
  paymentId String
  invoiceId String
  tenantId  String

  /** Minor units of the payment currency. */
  amount        Int
  reason        PlatformRefundReason
  /** Free-form note expanding on the reason — internal only when
   *  customerNote is null. */
  reasonNote    String?
  internalNote  String?
  customerNote  String?

  /** When true, refund is issued as an internal credit (CN-N row)
   *  instead of pushed back to the gateway. */
  asCredit     Boolean @default(false)
  /** When asCredit=true, points at the minted PlatformCreditNote.
   *  Captured here so reporting can reconcile both sides. */
  creditNoteId String?

  status        PlatformRefundStatus @default(PENDING)
  failureReason String?
  /** Stripe / gateway refund id once settled. */
  gatewayRefundId String?

  initiatedAt DateTime  @default(now())
  completedAt DateTime?
  initiatedBy String

  payment PlatformInvoicePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice PlatformBillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, initiatedAt])
  @@index([status, initiatedAt])
  @@index([paymentId])
}

enum PlatformDisputeStatus {
  NEEDS_RESPONSE
  UNDER_REVIEW
  WON
  LOST
}

model PlatformDispute {
  id String @id @default(cuid())
  /** One dispute per platform payment (the gateway model is 1:1). */
  paymentId String  @unique
  invoiceId String
  tenantId  String

  /** Gateway-side dispute id. */
  gatewayDisputeId String? @unique
  /** Disputed amount (minor units). */
  amount     Int
  /** Gateway-supplied code — varies. */
  reasonCode String?
  /** Display reason — friendlier than the code. */
  reason     String

  status PlatformDisputeStatus @default(NEEDS_RESPONSE)

  /** Gateway's submission deadline. */
  evidenceDueAt    DateTime?
  /** Free-form evidence text the admin assembled. */
  evidenceText     String?
  /** When evidence was actually submitted to the gateway. */
  submittedEvidenceAt DateTime?
  /** When the admin clicked "Accept dispute" — concedes the loss. */
  acceptedAt DateTime?
  acceptedBy String?
  /** When the gateway resolved (won or lost). */
  resolvedAt DateTime?

  /** Snapshot of customer history captured at submission. JSON
   *  shape: { tenantStatus, lastLoginAt, mrr, lifetimeValue, ... }. */
  contextSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment PlatformInvoicePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice PlatformBillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, evidenceDueAt])
  @@index([tenantId, createdAt])
}

/** Page 18 §Chargeback Evidence Library — reusable evidence
 *  drafts. Body supports {tenant}, {amount}, {date} placeholders;
 *  the submit-evidence form interpolates them at use time. */
model ChargebackEvidenceTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?
  body        String

  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt

  @@index([name])
}

// Page 16 — credit note. Issued against an invoice (full or partial)
// to correct an overcharge. We don't actually push the credit to the
// gateway today; the row is captured here so accounting + the detail
// timeline have it.
model PlatformCreditNote {
  id        String   @id @default(cuid())
  invoiceId String
  /** Human-readable number e.g. "CN-1042". */
  number    String   @unique
  /** Minor units of the invoice currency. */
  amount    Int
  reason    String
  notes     String?
  issuedAt  DateTime @default(now())
  issuedBy  String

  invoice PlatformBillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model PlatformBillingInvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitAmount  Int     // minor units of the invoice currency
  // Cached line total = quantity * unitAmount. Stored to keep totals
  // math centralized in one mutation path.
  lineTotal   Int
  position    Int     @default(0)

  invoice PlatformBillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, position])
}

// ─────────────────────────────────────────────────────────────────
// Page 21 — Tax & Compliance.
//
// PlatformTaxConfig is a singleton row (id="default") capturing the
// active provider + global flags. TaxRate is the per-jurisdiction
// manual rate table (used when provider=NONE, or as an override).
// TaxExemption ties a Tenant to a verified exemption certificate
// (B2B, government, education, etc). TaxFiling tracks per-period
// filings the operator owes a jurisdiction.
//
// Honest deferrals: provider integrations (Stripe Tax / Avalara /
// TaxJar) ship as schema-only — no real API call until the SDK is
// wired. Certificate uploads point at a URL — the storage layer is
// already plumbed via `lib/storage` and used by other surfaces.
// ─────────────────────────────────────────────────────────────────

enum TaxProvider {
  NONE      // manual rate table only
  STRIPE
  AVALARA
  TAXJAR
}

enum TaxBehavior {
  EXCLUSIVE  // tax added on top of price
  INCLUSIVE  // tax baked into price
}

enum TaxRoundingRule {
  ROUND_HALF_UP    // standard rounding
  ROUND_DOWN       // truncate fractional cents
  ROUND_BANKERS    // banker's rounding (half-to-even)
}

enum TaxExemptionType {
  RESALE          // resale certificate (B2B reseller)
  GOVERNMENT      // gov / municipal entity
  NONPROFIT       // 501(c)(3) or international equivalent
  EDUCATION       // educational institution
  REVERSE_CHARGE  // EU B2B reverse-charge
  OTHER
}

enum TaxFilingStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  AMENDED
  REJECTED
}

model PlatformTaxConfig {
  id                  String          @id @default("default")
  provider            TaxProvider     @default(NONE)
  /** Provider connection state — e.g. "connected", "needs_oauth",
   *  "error: invalid_key". Free-form; provider integrations write here. */
  providerStatus      String?
  providerLastSyncAt  DateTime?
  /** Default behavior for new plans/invoices that don't set their own. */
  defaultBehavior     TaxBehavior     @default(EXCLUSIVE)
  defaultRounding     TaxRoundingRule @default(ROUND_HALF_UP)
  /** EU One-Stop-Shop registration ID. Null = not registered. */
  euOssRegistration   String?
  /** UK Making Tax Digital registration ID. */
  ukMtdRegistration   String?
  /** Australia GST registration. */
  auGstRegistration   String?
  /** When true, B2B EU customers with a valid VAT number get
   *  reverse-charge treatment automatically. */
  reverseChargeEU     Boolean         @default(true)
  /** Default tax codes by product type, JSON shape:
   *  { "subscription": "txcd_10000000", "metered": "txcd_10103001", ... } */
  defaultTaxCodes     Json?
  updatedAt           DateTime        @updatedAt
  updatedBy           String?
}

model TaxRate {
  id            String   @id @default(cuid())
  /** ISO-3166 alpha-2 country code, e.g. "US", "GB", "AU". */
  country       String
  /** ISO-3166-2 region code (state/province), e.g. "US-CA". Null = country-wide. */
  region        String?
  /** Display label, e.g. "California state sales tax". */
  label         String
  /** Decimal rate, e.g. 0.0875 = 8.75%. */
  rate          Decimal  @db.Decimal(6, 4)
  /** Nexus threshold in minor units (USD by default). 0 = always taxable. */
  nexusThreshold Int     @default(0)
  /** Filing tax ID for this jurisdiction, if registered. */
  taxId         String?
  effectiveAt   DateTime @default(now())
  /** When this rate was superseded (if ever). Lookup uses validity window. */
  expiresAt     DateTime?
  /** Optional Stripe Tax / Avalara mapping for syncing. */
  externalId    String?
  notes         String?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([country, region, effectiveAt])
  @@index([country, region])
}

model TaxExemption {
  id              String           @id @default(cuid())
  tenantId        String
  exemptionType   TaxExemptionType
  /** Tenant-supplied tax ID / certificate number. */
  taxId           String?
  /** Jurisdictions this exemption applies to. Empty = all. */
  jurisdictions   String[]         @default([])
  /** Certificate URL (S3/cloud storage). Null = no doc on file. */
  certificateUrl  String?
  certificateName String?
  /** When platform staff verified the cert. Null = unverified. */
  verifiedAt      DateTime?
  verifiedBy      String?
  /** Cert expiry. Null = no expiry. */
  expiresAt       DateTime?
  notes           String?
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, verifiedAt])
}

model TaxFiling {
  id          String          @id @default(cuid())
  /** Jurisdiction key, e.g. "US-CA", "GB", "EU-OSS". */
  jurisdiction String
  /** Filing period — month/quarter/year. Free-form for now ("2026-Q1", "2026-03"). */
  period      String
  /** Total taxable sales reported (minor units, USD). */
  taxableSales Int            @default(0)
  /** Total tax collected for the period. */
  taxCollected Int            @default(0)
  /** When the filing was submitted to the jurisdiction. */
  dueAt       DateTime
  submittedAt DateTime?
  /** Filing reference number from the jurisdiction once accepted. */
  externalRef String?
  /** Uploaded filing PDF, if any. */
  pdfUrl      String?
  status      TaxFilingStatus @default(DRAFT)
  notes       String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([jurisdiction, period])
  @@index([status, dueAt])
}

// ─────────────────────────────────────────────────────────────────────
// Page 23 — Dunning & Failed Payments.
//
// DunningSequence is the recovery cadence the operator authors
// (e.g. "Default", "Enterprise", "Annual"). Each sequence has ordered
// DunningSequenceStage rows defining what to do at each step (send
// email, retry payment, etc.). DunningConfig is a singleton holding
// global behavior (default sequence, max retries, auto-cancel, Stripe
// Smart Retries toggle). DunningEvent ties a failed
// PlatformInvoicePayment to a sequence + scheduled stage so the queue
// has something to pick up.
//
// Honest deferrals: Stripe Smart Retries SDK isn't wired yet; "retry
// now" stamps a pending payment row but doesn't re-charge until the
// integration lands. Email open tracking + A/B testing both depend on
// the analytics-event pipeline that's also pending.
// ─────────────────────────────────────────────────────────────────────

enum DunningStageAction {
  SEND_EMAIL          // send the configured notification template
  SEND_SMS            // SMS via the future SMS pipeline
  IN_APP_BANNER       // surface a banner in the workspace
  RETRY_PAYMENT       // attempt the failed charge again
  NOTIFY_CSM          // ping the customer-success owner
  SURRENDER           // mark the invoice uncollectible + exit
}

enum DunningEventStatus {
  IN_PROGRESS  // queued, working through the sequence
  PAUSED       // admin paused — no auto-advance
  RECOVERED    // payment succeeded, sequence completed
  SURRENDERED  // sequence ended without recovery
}

/** Author-time sequence: the cadence template. */
model DunningSequence {
  id          String   @id @default(cuid())
  /** Internal name, e.g. "Default monthly", "Annual high-touch". */
  name        String
  description String?
  /** Optional plan filter — null = sequence is the default for any plan. */
  planSlug    String?
  /** Stripe Smart Retries — when true, we delegate retry timing to Stripe
   *  on top of (or in place of) our own schedule. Honest deferral: no
   *  SDK call yet; this is a UI flag we'll honor when the integration lands. */
  smartRetries Boolean @default(false)
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stages      DunningSequenceStage[]
  events      DunningEvent[]

  @@index([planSlug, active])
}

model DunningSequenceStage {
  id          String             @id @default(cuid())
  sequenceId  String
  /** Ordering within the sequence (1-indexed). */
  position    Int
  /** Days after the previous stage (or initial fail) to fire this stage. */
  triggerDays Int
  action      DunningStageAction
  /** When action=SEND_EMAIL/SMS, the NotificationTemplate.kind to send. */
  templateKind String?
  /** Free-form label for the visual editor. */
  label       String?
  /** Branching rules as JSON — { onSoftDecline: "retry", onHardDecline: "skip" }. */
  branching   Json?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  sequence    DunningSequence    @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, position])
  @@index([sequenceId, position])
}

/** Singleton — global dunning settings. */
model DunningConfig {
  id                  String  @id @default("default")
  /** Default sequence id used when a per-plan match doesn't exist. */
  defaultSequenceId   String?
  maxRetries          Int     @default(4)
  /** After this many days of no recovery, auto-cancel the subscription. */
  autoCancelAfterDays Int     @default(30)
  /** When true, every retry email CCs billing@<tenant_domain>. */
  ccBillingEmail      Boolean @default(true)
  /** Cap retries per day to avoid bank-fee penalties (0 = no cap). */
  maxRetriesPerDay    Int     @default(2)
  /** Stripe Smart Retries platform-wide kill switch. */
  smartRetriesEnabled Boolean @default(false)
  updatedAt           DateTime @updatedAt
  updatedBy           String?
}

/** One row per (failed payment, sequence) — the queue entry. */
model DunningEvent {
  id          String             @id @default(cuid())
  /** Failed payment that kicked off this run. */
  paymentId   String             @unique
  /** Tenant for fast filtering. */
  tenantId    String
  /** Invoice for navigation. */
  invoiceId   String
  sequenceId  String
  /** Position into the sequence's stages array — 0 = entry, advances on each fire. */
  currentStage Int               @default(0)
  /** When the next stage is scheduled to fire. Null when paused/done. */
  nextActionAt DateTime?
  /** Last time something ran on this entry. */
  lastActionAt DateTime?
  /** Free-form note shown on the queue row (e.g. "soft decline; auto-retry"). */
  lastOutcome  String?
  /** Number of retry attempts so far (capped by config.maxRetries). */
  retriesAttempted Int           @default(0)
  status      DunningEventStatus @default(IN_PROGRESS)
  recoveredAt DateTime?
  surrenderedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  payment     PlatformInvoicePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sequence    DunningSequence        @relation(fields: [sequenceId], references: [id], onDelete: Restrict)
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice     PlatformBillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([status, nextActionAt])
  @@index([tenantId, status])
  @@index([invoiceId])
}

// ─────────────────────────────────────────────────────────────────────
// Phase 4 — Platform Trust & Safety.
//
// `BanRecord` is polymorphic — one table covers user, IP, and
// email-domain bans because the surrounding workflow (issue, audit,
// list, lift) is identical and the ban targets are inherently exclusive
// (a row is exactly one of: user, IP, or domain).
//
// `UserMergeRecord` captures cross-tenant identity reconciliation.
// We don't rewrite historical authorship (audit logs, comments, etc.
// keep the original userId for forensic value); we *do* consolidate
// memberships, transfer auth Accounts, and soft-delete the source User
// via the `mergedIntoId` pointer above.
// ─────────────────────────────────────────────────────────────────────

enum BanKind {
  USER          // a specific User row
  IP            // a single IPv4 or IPv6 address
  EMAIL_DOMAIN  // anything @example.com
}

model BanRecord {
  id          String  @id @default(cuid())
  kind        BanKind
  // Exactly one of these is non-null based on `kind`. Application code
  // enforces; we don't use a CHECK constraint because Prisma's schema
  // language doesn't model XOR cleanly.
  userId      String?
  ipAddress   String? // canonical lower-case form for v6
  emailDomain String? // lower-case, no leading "@"
  reason      String  // free-text — surfaced on the ban list + audit
  issuedById  String
  issuedAt    DateTime  @default(now())
  // Optional auto-expiry. When set + reached, the row is considered
  // inactive without being deleted (so the audit trail stays).
  expiresAt   DateTime?
  // Manual lift. Mutually exclusive with `expiresAt` triggering — once
  // either is past, the ban is no longer active.
  liftedAt    DateTime?
  liftedById  String?
  liftReason  String?

  user     User? @relation("BannedUser", fields: [userId],     references: [id], onDelete: Cascade)
  issuedBy User  @relation("BanIssuer",  fields: [issuedById], references: [id], onDelete: Restrict)
  liftedBy User? @relation("BanLifter",  fields: [liftedById], references: [id], onDelete: SetNull)

  // Active-ban lookups — auth path queries by (kind, target) with
  // expiresAt/liftedAt filters; tight composite indexes keep that fast.
  @@index([kind, userId, liftedAt])
  @@index([kind, ipAddress, liftedAt])
  @@index([kind, emailDomain, liftedAt])
  @@index([issuedById])
}

model UserMergeRecord {
  id           String   @id @default(cuid())
  // The user that survives — receives memberships + auth links.
  targetUserId String
  // The user that was soft-deleted (User.mergedIntoId points at target).
  sourceUserId String
  // Cached snapshot — emails for both at merge time, in case the
  // target's email later changes. Surfaces on the audit page.
  targetEmail  String
  sourceEmail  String
  // What we actually moved.
  membershipsMoved Int @default(0)
  accountsMoved    Int @default(0)
  conflicts        Int @default(0) // memberships dropped because target already had one for that tenant
  reason           String
  executedById     String
  executedAt       DateTime @default(now())

  executedBy User @relation("MergeExecutor", fields: [executedById], references: [id], onDelete: Restrict)

  @@index([targetUserId])
  @@index([sourceUserId])
  @@index([executedAt])
}

// ─────────────────────────────────────────────────────────────────────
// Phase 1 follow-up — admin-defined custom platform roles.
//
// The 12 baseline PlatformRole values cover the common cases. A custom
// role lets an admin mint a permission bundle for the rare cases the
// baseline doesn't fit ("Tier 2 Support — like Support Lead but with
// billing.read", "Auditor — read-only across audit + compliance only").
//
// Resolution: when User.customPlatformRoleId is set, the custom role's
// permissions[] array overrides the baseline platformRole's permissions
// at the rbac layer. The baseline value still lives on the User row so
// the admin can fall back without re-picking the role.
//
// Permission strings are validated against the PlatformPermission
// union at the action layer (see app/actions/platform.ts) — schema is
// just a String[] because Prisma enums don't support array shapes.
// ─────────────────────────────────────────────────────────────────────

enum CustomPlatformRoleStatus {
  DRAFT     // not yet enforceable; admin can stage permission changes
  ACTIVE    // attached to users, takes effect on next request
  ARCHIVED  // detached from all users on archive; kept for audit history
}

model CustomPlatformRole {
  id          String                   @id @default(cuid())
  // Display name — surfaced in nav + role chips. Unique so the staff
  // list dropdown stays unambiguous.
  name        String                   @unique
  // Slug-style identifier used in audit metadata + URL params. Stored
  // separately so renaming the display name doesn't break audit search.
  key         String                   @unique
  description String?
  // Flat permission list. Validated against the PlatformPermission
  // union in the action layer. Includes nothing on DRAFT creation; the
  // admin populates via the permission grid.
  permissions String[]                 @default([])
  status      CustomPlatformRoleStatus @default(DRAFT)
  createdById String
  createdBy   User                     @relation("CustomRoleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  // Reverse side of User.customPlatformRole — lets us count members
  // and detach them on archive without a second query.
  members User[]
  // Page 12 — invites that pre-assign this custom role on accept.
  pendingInvites PlatformInvite[]

  @@index([status])
}

// ────────────────────────────────────────────────────────────
// Subscription event log — exact MRR-movement source of truth.
//
// Every meaningful subscription change writes one row here:
//   • CREATED        — tenant signs up on a plan  (mrrDelta = +newPrice)
//   • UPGRADED       — moves to a higher-priced plan (mrrDelta > 0)
//   • DOWNGRADED     — moves to a lower-priced plan  (mrrDelta < 0)
//   • CANCELED       — tenant churns                  (mrrDelta = -oldPrice)
//   • REACTIVATED    — comes back from CANCELED       (mrrDelta = +newPrice)
//   • PRICE_CHANGED  — pricing-plan price catalog edit (mrrDelta = priceDiff)
//
// `mrrDelta` is the signed monthly impact in dollars; sum it across a
// time window and you have exact MRR movement. NRR, churn dollar
// amounts, plan-migration sankey, etc. all read from here instead of
// reconstructing from the current Tenant.plan.
// ────────────────────────────────────────────────────────────

model SubscriptionEvent {
  id       String                @id @default(cuid())
  tenantId String
  type     SubscriptionEventType

  // Plan snapshot. Both nullable because CREATED has no `from` plan
  // and CANCELED has no `to` plan. Storing the enum AND the price at
  // the moment of the event means historical NRR doesn't shift if we
  // re-price the catalog later.
  fromPlan         Plan?
  toPlan           Plan?
  fromPriceMonthly Decimal? @db.Decimal(10, 2)
  toPriceMonthly   Decimal? @db.Decimal(10, 2)

  // Signed monthly recurring impact in dollars. Always equals
  // (toPriceMonthly ?? 0) - (fromPriceMonthly ?? 0). Stored explicitly
  // so MRR-movement reports can `SUM(mrrDelta)` without re-deriving
  // it from the snapshot fields.
  mrrDelta Decimal @db.Decimal(12, 2)

  // Where the change came from. STRIPE = webhook-driven from the
  // billing provider; MANUAL = platform staff edited the plan;
  // SYSTEM = automated (dunning auto-suspend, archive, etc.);
  // BACKFILL = retro-inserted by the one-time backfill script.
  source   SubscriptionEventSource @default(SYSTEM)

  // Optional context.
  actorUserId String?
  reason      String?
  metadata    Json?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Range queries by tenant + a "what's the MRR change in this
  // window?" report both hit (tenantId, occurredAt). The single-
  // column index covers global "MRR movement" reports.
  @@index([tenantId, occurredAt])
  @@index([occurredAt])
  @@index([type])
}

enum SubscriptionEventType {
  CREATED
  UPGRADED
  DOWNGRADED
  CANCELED
  REACTIVATED
  PRICE_CHANGED
}

enum SubscriptionEventSource {
  STRIPE
  MANUAL
  SYSTEM
  BACKFILL
}

// ────────────────────────────────────────────────────────────
// Page 2 — Activity Feed primitives.
//
// Two small models support the activity-feed page at /platform/activity:
//
//   • PlatformSavedView — a stored filter querystring per staff
//     member. Owns its own table (separate from the existing
//     tenant-scoped `SavedView`) so the staff side can share-with-team
//     without colliding with tenant-side views.
//
//   • ActivitySubscription — a saved filter that fires email digests
//     of matching events on a schedule. Slack delivery is planned but
//     not wired (no Slack OAuth integration yet); kept on the enum so
//     the UI can reflect future support.
// ────────────────────────────────────────────────────────────

model PlatformSavedView {
  id     String @id @default(cuid())
  userId String

  // Right now the only kind of saved view we use platform-side is
  // "activity" (the activity feed). Kept as an open string so future
  // pages (audit, payments, tenants list) can reuse the same table
  // without a migration.
  kind   String  @default("activity")
  name   String
  // Raw querystring, exactly the form pasted onto the page URL.
  // Round-trip preserves multi-select + date-range state without
  // demanding a structured schema for every filter we add.
  filters    String
  // When true, all platform staff see this view in their dropdown.
  isShared   Boolean @default(false)
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, sortOrder])
  @@index([kind, isShared])
}

model ActivitySubscription {
  id     String @id @default(cuid())
  userId String

  // Display name shown in the Active subscriptions panel + email
  // subject. e.g. "Big payments daily" or "Suspicious logins".
  name      String
  // Filter querystring snapshot at create time. The cron job uses
  // this to find matching events at delivery time.
  filters   String
  // Currently EMAIL only — Slack is reserved for a later slice once
  // we wire OAuth. Listed in the enum so the create modal can show
  // a disabled "Slack (coming soon)" option.
  channel   ActivitySubscriptionChannel @default(EMAIL)
  // For EMAIL: where to send. Defaults to the creator's email but
  // can be overridden so a finance subscription can go to a shared
  // alias (billing@flowtora.com).
  email     String
  frequency ActivitySubscriptionFrequency @default(HOURLY)

  // Cron-coordination state. `lastDeliveredAt` so the digest only
  // includes events created since the previous delivery. `pausedAt`
  // so a user can pause without deleting.
  lastDeliveredAt DateTime?
  pausedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pausedAt, lastDeliveredAt])
}

enum ActivitySubscriptionChannel {
  EMAIL
  // Reserved for a future slice — needs Slack OAuth + a per-user
  // workspace token. Kept here so the UI can render it disabled.
  SLACK
}

enum ActivitySubscriptionFrequency {
  // Live = "as-it-happens", debounced by the cron's poll interval
  // (currently 5 minutes — anything more frequent overlaps the next
  // run and risks duplicate delivery).
  LIVE
  HOURLY
  DAILY
}

// ────────────────────────────────────────────────────────────
// Page 3 — Reports & Insights primitives.
//
// Two-tier model. Pre-built reports live in code as a registry
// (src/server/platform/reports/registry.ts) — stable, code-shipped,
// no DB row required. The DB tables here only store:
//
//   • Report           — user-saved customizations of a prebuilt
//                        report (changed filters, renamed). The
//                        `key` references the registry entry.
//   • ReportUserState  — per-user favourites + pinned + last-viewed.
//                        One row per (userId, reportKey).
//   • ReportSchedule   — periodic deliveries (email digest of the
//                        rendered report) on hourly/daily/weekly/
//                        monthly cadence with optional CRON override.
// ────────────────────────────────────────────────────────────

model Report {
  id     String @id @default(cuid())
  // Registry key for prebuilt reports the user customised. NULL for
  // fully-custom reports authored in the (future) builder.
  key    String?
  name   String
  description String?
  category    String?
  // Saved filter querystring. Same round-trip format as the activity
  // feed — paste into the URL and the report renders identically.
  filters     String  @default("")
  // JSON blob for any chart-config overrides the user makes in the
  // detail-view header (e.g. chart type, dimension grouping). The
  // shape is per-report so we don't constrain it here.
  chartConfig Json?

  ownerUserId String
  isShared    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  userStates ReportUserState[]
  schedules  ReportSchedule[]
  versions   ReportVersion[]

  @@index([ownerUserId, updatedAt])
  @@index([key])
  @@index([isShared])
}

model ReportUserState {
  id          String @id @default(cuid())
  userId      String
  // Either references a Report row (custom / saved report) OR a
  // prebuilt report by registry key. We store BOTH so the same
  // table covers favouriting a built-in MRR Waterfall AND a custom
  // saved report. Exactly one is set; enforced at write time.
  reportId    String?
  reportKey   String?

  isFavorite   Boolean @default(false)
  isPinned     Boolean @default(false)
  lastViewedAt DateTime?
  // Page 3 follow-up — per-user view counter. Bumped on every detail-
  // page view; used by the library "Most viewed" sort option.
  viewCount    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([userId, reportId])
  @@unique([userId, reportKey])
  @@index([userId, isPinned])
  @@index([userId, isFavorite])
}

model ReportSchedule {
  id String @id @default(cuid())

  // Either references a Report (custom) OR a prebuilt by key.
  reportId  String?
  reportKey String?

  ownerUserId String
  // Display name shown in the "Active schedules" panel + email subject.
  name        String

  // Comma-separated list of recipient emails. The schedule modal
  // turns chips into a CSV before submit; the cron splits it back.
  recipients  String

  // PDF reserved for a future slice (needs headless-chromium or a
  // PDF renderer dep). Today CSV / HTML inline are wired.
  format      ReportScheduleFormat @default(HTML_EMAIL)

  frequency       ReportScheduleFrequency @default(DAILY)
  // For WEEKLY: 0=Sun..6=Sat. For MONTHLY: day of month (1..28).
  dayOfWeek       Int?
  dayOfMonth      Int?
  // HH:MM in the timezone below. Defaults to 13:00 UTC (matches the
  // existing reminders cron) so all scheduled-report emails land at
  // a predictable time.
  timeOfDay       String  @default("13:00")
  timezone        String  @default("UTC")
  // Override: a raw CRON expression that wins over the simple
  // frequency fields. Validated by the create action.
  cronExpression  String?

  // Filter snapshot at create-time so the schedule keeps firing the
  // same view even if the user later changes the report's defaults.
  filters String @default("")

  pausedAt        DateTime?
  lastDeliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner  User    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  report Report? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@index([pausedAt, lastDeliveredAt])
}

enum ReportScheduleFormat {
  HTML_EMAIL
  CSV
  // Reserved — PDF needs headless-chromium or a PDF lib; not wired today.
  PDF
}

enum ReportScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
  CRON
}

// ────────────────────────────────────────────────────────────
// Page 3 follow-up — versioning + view-count counters.
// ────────────────────────────────────────────────────────────

model ReportVersion {
  id       String @id @default(cuid())
  reportId String

  // Snapshot of every editable field. Authoring saves a new row;
  // revert copies an old version's snapshot back into the live Report.
  name        String
  description String?
  category    String?
  filters     String  @default("")
  chartConfig Json?

  // Who/why/when. `note` is optional free-form so someone can label a
  // version "after Q3 pricing change" before reverting later.
  authorUserId String
  note         String?

  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
}

// ────────────────────────────────────────────────────────────
// Page 3 follow-up — Net Promoter Score surveys.
//
// Two-table model: Survey owns one campaign per audience (per plan,
// per locale, etc.); SurveyResponse stores the per-tenant 0–10 score.
// Distribution today is in-app only — the bell button surfaces the
// active survey to admin members on dashboard load. A later slice can
// add an email invite path through the existing Resend dispatcher.
// ────────────────────────────────────────────────────────────

model Survey {
  id          String       @id @default(cuid())
  kind        SurveyKind   @default(NPS)
  title       String
  // Audience filter — for NPS we typically scope to ACTIVE / PAST_DUE
  // tenants only (excluding TRIALs which haven't formed an opinion yet).
  // Stored as JSON so future surveys can express richer audiences
  // without a schema change.
  audience    Json?
  // ISO2 / locale code; null = no preference.
  locale      String?
  // Active = served to the audience; CLOSED = no longer collecting.
  status      SurveyStatus @default(ACTIVE)
  // Optional bounding window. CLOSED-by-cron when `closeAt` passes.
  openAt      DateTime     @default(now())
  closeAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses SurveyResponse[]

  @@index([kind, status])
  @@index([status, openAt])
}

model SurveyResponse {
  id       String @id @default(cuid())
  surveyId String

  // Which tenant + which member submitted. Both nullable so we can
  // accept anonymous responses (off by default; flagged at survey
  // create time for sensitive surveys).
  tenantId String?
  userId   String?

  // 0–10 for NPS; reused as 1–5 for CSAT-style surveys (we range-check
  // at write time based on the parent survey's `kind`).
  score    Int
  // Free-form follow-up. Capped to keep the table small.
  comment  String?

  // De-dupe per (survey, user). Empty userId allows multiple rows
  // (anonymous mode).
  createdAt DateTime @default(now())

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId, createdAt])
  @@index([tenantId, createdAt])
  @@unique([surveyId, userId], map: "SurveyResponse_unique_per_user_when_set")
}

enum SurveyKind {
  NPS    // 0–10 with promoter / detractor split
  CSAT   // 1–5 satisfaction
  CES    // 1–7 customer effort score
}

enum SurveyStatus {
  ACTIVE
  CLOSED
}

// ────────────────────────────────────────────────────────────
// Page 3 follow-up — Affiliate / referral program.
//
// Bare-minimum model so the Affiliate Earnings report has real data
// to render. An affiliate gets a unique code; tenants signing up via
// `?ref=<code>` are attributed to that affiliate; commissions accrue
// based on payments the referred tenant makes.
//
// Commission math is deliberately simple (flat percentage of net
// payments in the first 12 months). Per-tier / per-cohort rules are
// reserved for a future slice.
// ────────────────────────────────────────────────────────────

model Affiliate {
  id    String @id @default(cuid())
  // Stable referral code — appears in `?ref=<code>` URLs.
  code  String @unique
  name  String
  email String

  // Flat percentage commission (0–100) applied to attributed payments
  // for `commissionDurationMonths` from the tenant's signup date.
  commissionPct            Decimal @default(20) @db.Decimal(5, 2)
  commissionDurationMonths Int     @default(12)

  status    AffiliateStatus @default(ACTIVE)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrals       Referral[]
  // Page 24 — Payouts.
  payoutMethods   PartnerPayoutMethod[]
  payouts         PartnerPayout[]
  commissionLines PartnerCommissionLine[]

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────
// Page 24 — Payouts.
//
// Generalised payouts to partners (today: affiliates; the model is
// designed so resellers / marketplace sellers slot in later without a
// schema rewrite — partner identity == Affiliate FK for now).
//
// PartnerPayoutMethod stores how a partner gets paid (Stripe Connect /
// ACH / PayPal / Wise / Wire) plus the detail blob the integration
// needs. PartnerPayout is one money movement (period, total, status).
// PartnerCommissionLine is the per-payment commission earned, with
// holds/deductions tracked so the statement reconciles cleanly.
//
// Honest deferrals: actual payment-rail SDK calls (Stripe Connect
// transfer, PayPal payout, Wise transfer) ship as schema-only — saving
// a payout marks it PENDING; flipping to PAID still has to be a manual
// click until the SDK is wired. Same for Stripe Connect onboarding.
// ─────────────────────────────────────────────────────────────────

enum PartnerPayoutMethodType {
  STRIPE_CONNECT
  ACH
  PAYPAL
  WISE
  WIRE
}

enum PartnerPayoutStatus {
  PENDING       // queued — waiting on next payout run
  IN_TRANSIT    // dispatched to the rail
  PAID          // settled
  FAILED        // rail bounced — needs admin attention
  CANCELED      // admin canceled before dispatch
}

enum PartnerCommissionLineKind {
  COMMISSION    // earned commission on an attributed payment
  HOLD          // funds held back (e.g. fraud risk window)
  DEDUCTION     // refund clawback / chargeback / adjustment
  BONUS         // one-off bonus / spiff
}

model PartnerPayoutMethod {
  id          String                   @id @default(cuid())
  affiliateId String
  type        PartnerPayoutMethodType
  /** Display label, e.g. "Chase business checking", "PayPal — alex@flowtora.com". */
  label       String
  /** Account snippet for the UI — last 4 / email / external IBAN.
   *  Never the full account number — that lives at the rail. */
  accountSnippet String?
  /** Rail-specific external id (Stripe Connect account, PayPal payer id, etc.). */
  externalAccountId String?
  /** Provider-side status (configured / verified / needs_action). */
  status      String?
  /** When true, this is the partner's primary method. */
  isPrimary   Boolean                  @default(false)
  notes       String?
  createdById String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  payouts     PartnerPayout[]

  @@index([affiliateId, isPrimary])
}

model PartnerPayout {
  id          String              @id @default(cuid())
  affiliateId String
  /** Method this payout was dispatched through. Null = method removed
   *  after dispatch (rare; we keep the row anyway for history). */
  methodId    String?
  /** Period covered, e.g. "2026-04" or "2026-Q2" — free-form. */
  period      String
  /** Total amount in minor units (USD). */
  amount      Int
  currency    String              @default("USD")
  status      PartnerPayoutStatus @default(PENDING)
  /** When the payout was scheduled to run / actually run / settled. */
  scheduledAt DateTime
  dispatchedAt DateTime?
  settledAt    DateTime?
  /** External id once the rail accepts it. */
  externalRef  String?
  /** Free-form failure message when status=FAILED. */
  failureReason String?
  /** PDF statement URL for this payout. */
  statementUrl String?
  notes        String?
  createdById  String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  affiliate Affiliate            @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  method    PartnerPayoutMethod? @relation(fields: [methodId],    references: [id], onDelete: SetNull)
  lines     PartnerCommissionLine[]

  @@unique([affiliateId, period])
  @@index([status, scheduledAt])
  @@index([affiliateId, status])
}

model PartnerCommissionLine {
  id          String                   @id @default(cuid())
  affiliateId String
  /** Pinned to a payout when it ships; null while still accruing. */
  payoutId    String?
  /** What kind of line — commission / hold / deduction / bonus. */
  kind        PartnerCommissionLineKind
  /** Free-form description shown on the statement. */
  description String
  /** Source payment that generated this commission (when kind=COMMISSION). */
  sourcePaymentId String?
  /** Tenant the commission was attributed against. */
  tenantId    String?
  /** Earned-amount in minor units (positive). For DEDUCTION rows we
   *  still store positive amounts; the kind enum signals the sign. */
  amount      Int
  /** Period the line is associated with — used to bucket into payouts. */
  period      String
  /** When the line was generated. */
  earnedAt    DateTime                  @default(now())
  notes       String?

  affiliate Affiliate     @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  payout    PartnerPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([affiliateId, period])
  @@index([payoutId])
}

model Referral {
  id          String @id @default(cuid())
  affiliateId String
  tenantId    String @unique

  // Captured at signup from the `?ref=` querystring or affiliate
  // landing page. Snapshot the affiliate's commission rate AT
  // attribution time so changing the rate later doesn't retroactively
  // alter past earnings.
  commissionPctAtAttribution Decimal @db.Decimal(5, 2)

  attributedAt DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId],   references: [id], onDelete: Cascade)

  @@index([affiliateId, attributedAt])
}

enum AffiliateStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

// ────────────────────────────────────────────────────────────
// Support module enum (Page 3 §Bug Volume by Module).
//
// Tags every SupportTicket with the module the ticket relates to so
// the Bug Volume report can break tickets down by area.
// ────────────────────────────────────────────────────────────

enum SupportTicketModule {
  BILLING
  AUTH
  PROOFS
  ORDERS
  INVOICES
  QUOTES
  PRODUCTS
  REPORTS
  INTEGRATIONS
  PORTAL
  EMAIL
  ADMIN
  OTHER
}
