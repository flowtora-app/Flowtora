# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/tracksign?schema=public"

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-string"
AUTH_URL="http://localhost:3000"

# Stripe (optional in dev)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_PRO=""

# Email — Resend (resend.com)
# Get your API key at https://resend.com/api-keys
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="Tracksign <noreply@yourdomain.com>"
# RESEND_WEBHOOK_SECRET="whsec_..."   # from Resend dashboard → Webhooks

# App
APP_URL="http://localhost:3000"
